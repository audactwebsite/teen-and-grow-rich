---
/**
 * Editions (docs/decisions.md D13).
 *
 * This page exists because printed books outlive redesigns. A page number printed in the
 * first run must still resolve after a second run moves it, so the routing is
 * edition-aware and the editions have to be written down somewhere a reader can see.
 *
 * The routed-page count is read from the live page index rather than typed here, so it
 * cannot drift away from what /p/[n] actually resolves.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";
import { pageIndex } from "../lib/content";
import { SITE_HOST } from "../lib/site";

const index = await pageIndex();
const routed = [...index.keys()].filter((n) => n >= 1 && n <= 64).length;

/**
 * The errata list. One entry so far, and it is the re-issue that fixed the printed address.
 *
 * This is the site's own method turned on the printed object rather than only on the
 * website: /updates says a correction gets a dated entry naming what was wrong instead of
 * a quiet edit, and a book that was re-set is exactly that case. Writing it down also
 * answers the practical question a reader with an older copy has — whether their page
 * numbers still work — which nothing else on this site currently answers.
 *
 * The wrong address is described, never spelled. Without its hyphen it is a live domain
 * belonging to an unrelated company, and printing it here would send readers there from
 * the one page that exists to stop that happening.
 */
const ERRATUM = [
  {
    key: "What was wrong",
    value:
      "The website address printed in the book was set without its hyphen. That is not a typo you can shrug at: without the hyphen it is a different company's domain — a real business, live, nothing to do with this book — so every printed route into this site pointed at a stranger.",
  },
  {
    key: "Where",
    value:
      "Every printed mention of the address, which is five: the Publishing Note on printed page 2, the author page on printed page 63, the back cover, and both QR codes — the one on printed page 64 and the one on the back.",
  },
  {
    key: "What changed",
    value: `All five carry ${SITE_HOST}, hyphen included. The two codes were checked by rendering every page of the print files and decoding what is actually in them, rather than by looking at them. Same edition, same 64 pages, same trim, same page numbers.`,
  },
  {
    key: "What did not change",
    value:
      "Every other word in the book. That is checked rather than assumed: the script that pulls all 231 items out of the print file was re-run against the re-set files, and its output was identical, line for line, to what was already on this site. The whole difference between the two printings is the address.",
  },
  {
    key: "If your copy has the old one",
    value:
      "Nothing here breaks. Not one page moved, so every page number in your copy resolves exactly as this page says it does. Type the address with the hyphen in it and you are in the right place.",
  },
];

const EDITION_ONE = [
  { key: "Name", value: "The Condensed Gen Z Edition" },
  { key: "Print run", value: "First, 2026" },
  { key: "Publisher", value: "Bright Kids" },
  { key: "Author", value: "Ryan Rijvers" },
  { key: "Language", value: "English. Written for readers aged 13 and up." },
  { key: "Printed pages", value: "64" },
  { key: "Trim size", value: "140 × 216 mm" },
  { key: "Page routing", value: "/p/1 to /p/64 resolve against this edition." },
];
---

<Page
  title="Editions"
  description="Which print run this site's page numbers refer to, how a printed page number keeps working after a second edition moves it, and the errata for the printed book."
>
  <ChapterFurniture
    eyebrow="The record"
    title="Editions"
    subtitle="Which printed book this site's page numbers belong to — and what happens to them when a second run moves them."
  />

  <div class="wrap">
    <div class="prose">
      <p class="lede">
        Every tool page on this site states the printed page it came from, and you can type
        a page number straight into the homepage to get there. That only works if it is
        clear which book the number is in. This page is that record — and it is where the
        <a href="#errata">errata</a> go: what was wrong in a printed copy, and what was
        changed about it.
      </p>
    </div>
  </div>

  <section class="wrap section" aria-labelledby="edition-1">
    <h2 id="edition-1">Edition 1 — the one this site follows</h2>
    <div class="rows">
      {
        EDITION_ONE.map((r) => (
          <div class="row">
            <p class="row__key">{r.key}</p>
            <p class="row__value">{r.value}</p>
          </div>
        ))
      }
      <div class="row">
        <p class="row__key">ISBN</p>
        <div class="row__value">
          <div data-placeholder class="placeholder">
            <p class="placeholder__label">Not yet known</p>
            <p class="placeholder__note">
              The paperback and ebook ISBNs are not confirmed. They will be listed here,
              in full, so a librarian or a bookseller can match this site to the physical
              object without asking anyone.
            </p>
          </div>
        </div>
      </div>
    </div>

    <p class="prose note">
      <b>{routed}</b> of the 64 printed pages resolve to a tool on this site. The rest are
      story and essay pages — those are on the site too, on their chapter page, because the
      whole book is free to read here. They simply have no tool of their own to route to.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="p65">
    <h2 id="p65">Page 65</h2>
    <div class="prose">
      <p>
        The book ends on printed page 64 with “End of the condensed edition.” There is no
        page 65 in the book — but typing 65 here opens{" "}
        <a href="/c/16">Chapter 16</a>, written by Ryan about what he learned after the book
        went to print. It is the one thing a printed book can never contain.
      </p>
      <p>
        It is not a locked room. Typing 65 is the pleasant way to find it; the plain link
        above works just as well, it is in the site's navigation, and search engines can
        read it. A secret that can only be reached by an easter egg excludes anyone using a
        screen reader and anyone who never thinks to try.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="second-run">
    <h2 id="second-run">When there is a second print run</h2>
    <div class="prose">
      <p>
        Page numbers move when a book is reset. That is normal, and it is exactly how a
        printed QR code turns into a dead link two years later. So three rules hold here:
      </p>
      <ul class="plain">
        <li>
          <b>The routing is per edition.</b> A second edition gets its own table on this
          page, and its own mapping. The first edition's mapping is never edited to match
          it.
        </li>
        <li>
          <b>A printed address is permanent.</b> Anything printed in a book is treated as
          immutable forever. <b>/p/1</b> to <b>/p/64</b> must never return a 404, no matter
          how many times this site is rebuilt.
        </li>
        <li>
          <b>Every page states its own number.</b> If a tool page says “book page 30” and
          your copy says something else, your copy is a different edition — come back here
          and check which.
        </li>
      </ul>
      <p class="note">
        Until a second edition exists, everything on this site refers to the first.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="errata">
    <h2 id="errata">Errata</h2>
    <div class="prose">
      <p>
        Things that were wrong in a printed book, written down instead of quietly reprinted.
        This site spends a whole chapter telling you to check other people's claims; it
        would be a strange site to run if it kept its own mistakes off the page.
      </p>
      <p>There has been one, and it is the reason this edition was re-set.</p>
    </div>

    <div class="rows rows--errata">
      {
        ERRATUM.map((r) => (
          <div class="row">
            <p class="row__key">{r.key}</p>
            <p class="row__value">{r.value}</p>
          </div>
        ))
      }
    </div>

    <p class="prose note">
      That is the only erratum so far — not the only one we will admit to, the only one
      anybody has found. If you find another, the mailbox at the bottom of this page is read
      by an adult, and it gets a dated entry here beside this one.
    </p>

    <div class="prose">
      <p>
        One more thing printed in the book is answered differently on this site, and it is
        not an error in the book: printed page 63 lists six things this website was going to
        be. Two of them are deliberately not being built, because both would mean a server
        holding a thirteen-year-old's work. The whole list, item by item, with the reasoning:
        <a href="/get#promise">what page 63 promised</a>.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="corrections">
    <h2 id="corrections">Corrections</h2>
    <div class="prose">
      <p>
        If a page number here does not match the book in your hands, that is worth telling
        us: the mailbox at the bottom of this page is read by an adult. Corrections get a
        dated entry on <a href="/updates">the changelog</a> saying what was wrong, rather
        than a silent edit.
      </p>
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p,
  .prose ul {
    margin-block-start: 0.9em;
  }

  .lede {
    margin-block-start: 1.75rem;
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    color: var(--text-strong);
  }

  .section {
    margin-block-start: 3rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  .section > .prose {
    margin-block-start: 0.75rem;
  }

  .rows {
    margin-block-start: 1.5rem;
    /* The key column plus the gap plus the measure, so the hairlines end where the words
       do rather than running on to the 72rem wrap. Matches grid-template-columns below. */
    max-inline-size: calc(10rem + 2rem + var(--container-measure));
    border-block-start: 1px solid var(--rule-hairline);
  }

  .row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .row__key {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .row__value {
    max-inline-size: var(--container-measure);
    /* Page numbers, trim sizes and ISBNs are data. */
    font-variant-numeric: tabular-nums slashed-zero;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  /* The errata table is the one table on this page whose values are sentences rather than
     data: its keys are phrases ("If your copy has the old one") that need a wider column,
     and tabular figures inside running prose space "2", "63" and "231" like a spreadsheet.
     Both are reverted here rather than loosened for the edition table above, where the
     numbers really are data and should still line up. */
  .rows--errata {
    max-inline-size: calc(13rem + 2rem + var(--container-measure));
  }

  .rows--errata .row__value {
    font-variant-numeric: normal;
  }

  @media (min-width: 40rem) {
    .rows--errata .row {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
  }

  [data-placeholder] {
    padding: 0.85rem 1rem;
    background: var(--surface-card);
    border: 1px dashed var(--rule-hairline);
  }

  .placeholder__label {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .placeholder__note {
    margin-block-start: 0.35rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .plain {
    list-style: none;
    padding: 0;
  }

  .plain li {
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .note {
    margin-block-start: 1.25rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .note b {
    font-variant-numeric: tabular-nums slashed-zero;
    color: var(--text-strong);
  }

  a {
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }
</style>
