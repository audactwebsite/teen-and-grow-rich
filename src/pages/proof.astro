---
/**
 * Who wrote this — the author page (docs/decisions.md D5, D34).
 *
 * Rewritten. The first version was an editorial audit: a claims table with a "what document
 * would prove this line" column beside every row. That is a useful working document and a
 * terrible page. A thirteen-year-old arriving here from the book was being handed the
 * production notes.
 *
 * What it is now: a timeline a reader that age will actually read. Same facts, no invented
 * ones, and still no counts of wins or podiums anywhere — an unsourced number is cut rather
 * than sourced with a shrug (non-negotiable 10). "Wins, and a lot of podiums" makes no
 * numeric claim, and the page tells the reader where to go and look instead, which is the
 * behaviour the book spends fifteen chapters arguing for.
 *
 * Sourced. This was the one page on the site that broke non-negotiable 10 — it stated a
 * racing record, linked to nothing, and carried a paragraph admitting the gap. The gap is
 * closed: every dated result now carries a link to the Dutch motorsport report of it,
 * published years before this book existed by people with no stake in it, and the
 * admission paragraph is deleted because it is no longer true. The sources and how they
 * were checked are in docs/reviews/05-the-sources-exist.md.
 *
 * Those sources also forced a correction. The Belgian title (Genk, October 2023) was Rotax
 * Max Mini Rookie; the German round-2 win at Genk was Minimax. They sat in one card here,
 * which read as one class. They are two cards now, and CLAUDE.md carries the instruction
 * never to merge them again.
 *
 * The Formula 4 line is now stated, because the exact facts came from the family: at eleven
 * he drove an F4 car built to his measurements, and he trains in it rather than racing it.
 * That is smaller than the rumour and more interesting than it, so it gets its own section
 * instead of a disclaimer. It is also the only claim on the page with nothing published
 * behind it, and now that every line around it carries a link that contrast is visible —
 * so the timeline marks it "No source" where the claim sits, rather than leaving a reader
 * to notice the blank and guess why.
 *
 * D34: he is a minor. Achievements, results and what he likes building are public. School,
 * address, training schedule, race calendar and any way to contact him directly are not,
 * and the page says so plainly rather than leaving a parent to wonder.
 */
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";

/* The two portraits are the only faces on the whole site, and both are already printed in
   the book — nothing here adds new exposure. The harbour frame is shot from behind. */
import harbour from "../assets/photos/monaco-harbour-03.jpg";
import portraitBw from "../assets/photos/ryan-portrait-bw.jpg";
import portraitIllustrated from "../assets/photos/ryan-portrait-illustrated.jpg";
import { author, book, jsonLd } from "../lib/schema";

/**
 * When the source links were last opened and confirmed to resolve (D29). A dated claim
 * carries a verification date and goes stale visibly rather than quietly, because a date
 * that has drifted testifies that nobody is home.
 *
 * The same mechanic as /hill, written out again rather than pulled into a helper: two
 * pages is not a pattern. The day a third page needs it, it becomes one.
 */
const VERIFIED_ON = "2026-08-02";
const verifiedOn = new Date(VERIFIED_ON);
const daysSince = Math.floor((Date.now() - verifiedOn.getTime()) / 86_400_000);
const stale = daysSince > 180;
const verifiedLabel = verifiedOn.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

/**
 * The timeline. Ages are the spine of it, because the single most useful fact for a reader
 * of this book is how old he was — "he was your age when he did this" is the whole point,
 * and it is the one thing a wall of results never says out loud.
 *
 * `sources` is the citation, sitting on the claim rather than in a footnote block at the
 * end. /hill puts its two links under the table because two links cover every row there;
 * here each result has its own report, and a link a reader has to go hunting for is a
 * weaker version of "go and check it yourself".
 *
 * `unsourced` is the opposite field and it exists for exactly one entry. A step with
 * neither field makes no checkable claim; a step with `unsourced` makes one and cannot
 * back it.
 *
 * The links carry rel="external" — they are links, not subresources, so nothing is fetched
 * until a reader chooses to leave and the "open the network tab, we load nothing" claim on
 * /schools/privacy still holds. Base.astro's speculation rules exclude them from
 * prerendering for the same reason. They need adding to ALLOWED_TEXT in
 * tools/verify-no-external-hosts.mjs, the way the /hill and Vercel citations are.
 *
 * No hreflang on them, even though the targets are Dutch and that is what the attribute is
 * for. Non-negotiable 11 says "no hreflang" flatly, and the next person checking that rule
 * will grep for the word, not read the context. The language is stated in words instead,
 * above the timeline and again under it, which a reader can actually see.
 */
interface Step {
  age: string;
  title: string;
  body: string;
  sources?: { label: string; href: string }[];
  unsourced?: string;
}

const TIMELINE: Step[] = [
  {
    age: "8",
    title: "First time in a kart",
    body: "Then, almost straight away, his first race ever: Spa, Micromax class, round two of the Dutch Rotax Max championship. He came fourth, was named best rookie, and was voted driver of the day. First race. Ever.",
    sources: [
      {
        label: "RaceXpress, 27 May 2022",
        href: "https://www.racexpress.nl/formule-1/karttalent-ryan-rijvers-uit-schimmert-imponeert-tijdens-eerste-wedstrijd-ooit-en-pakt-drie-bekers/n/121318",
      },
      {
        label: "Parkstad Actueel, 26 May 2022",
        href: "https://parkstadactueel.nl/2022/05/26/karttalent-ryan-rijvers-8-uit-schimmert-imponeert-tijdens-eerste-wedstrijd-ooit-en-pakt-drie-bekers/",
      },
    ],
  },
  {
    age: "8–10",
    title: "Racing across Europe",
    body: "For Strawberry Racing and for François Slangen. Wins, and a lot of podiums. The results are published — you can go and look them up, and you should, because that is exactly what Chapter 7 tells you to do with anyone's claims.",
  },
  /* Two cards, not one. The Belgian title and the German round-2 win happened in different
     classes and this page used to state them in a single card headed "Rotax Max Mini
     Rookie", which reads as though beating a world champion happened in the class he was
     champion of. It did not. Never merge these again — CLAUDE.md says so too. */
  {
    age: "10",
    title: "Belgian champion",
    body: "The class was Rotax Max Mini Rookie. It came down to the last round, at Genk, in October 2023. He finished third in that final, ahead of the one driver who could still have taken the title off him — and that was the championship. His first.",
    sources: [
      {
        label: "RaceXpress, October 2023",
        href: "https://www.racexpress.nl/rotax-euro/ryan-rijvers-10-wint-titanenstrijd-in-genk-en-wordt-belgisch-kampioen-ik-was-heel-blij-dat-voelt-zo-goed/n/131801",
      },
    ],
  },
  {
    age: "10",
    title: "A win in Germany, in a different class",
    body: "Minimax this time, not the Mini Rookie class he took the Belgian title in. Round two of the German Rotax Max championship, at Genk again, and he won the final. Second place went to the driver who had been Rotax Max world champion the year before. Third was the German Minimax champion. Two classes, two results — worth keeping apart, because they get run together.",
    sources: [
      {
        /* No date in this label. It is the one source whose publication date has not been
           confirmed, and a guessed date on a page about checkable claims is worse than no
           date at all. The publication and his name are enough to find it. */
        label: "RaceXpress",
        href: "https://www.racexpress.nl/rotax-euro/karttalent-ryan-rijvers-bluft-iedereen-af-in-genk-en-wint-duitse-rotax-max-fijn-weer-eens-te-winnen/n/136219",
      },
    ],
  },
  {
    age: "10–11",
    title: "The big series",
    body: "The Rotax Max Euro Trophy, and the Rotax international finals at Le Mans — which is the race every kart driver in Europe is trying to qualify for.",
  },
  {
    age: "11",
    title: "A Formula 4 car, built to fit him",
    body: "Not a race. See below — this is the part people usually get wrong, and the true version is better.",
    unsourced:
      "It is not a race, so there is no results sheet and no report to link to. This one comes from Ryan's family. That is weaker evidence than everything above it, and you should read it that way.",
  },
  {
    age: "13",
    title: "Wrote this book",
    body: "Sixty-four pages, fifteen chapters, nineteen builds. And when he is not doing that, he is building software with AI — Claude Code, mostly. He loves it.",
  },
];

/* He is a minor: name, role and the one page this site controls. No birth date, no
   address, no school, no sameAs chain of social profiles. */
const jsonLdText = jsonLd({ ...author, url: "/proof", nationality: "NL", knowsAbout: ["Karting", "Writing"], workExample: book }, Astro.site);
---

{/* The title is his name.

    It was "Who wrote this", which is the right label on a link from inside the site and the
    wrong one in a search result: not one page on this site had "Rijvers" in its <title>,
    including the page about him. The <title> is the strongest on-page signal there is for a
    name query, and somebody searching for him is exactly the visitor this page exists for —
    a parent checking whether the author is real, a teacher deciding whether to use the book.

    The links pointing here still say "Who wrote this", because that is what it is when you
    are already reading. */}
<Page
  title="Ryan Rijvers"
  description="Ryan Rijvers, author of Teen & Grow Rich, is thirteen. Karting across Europe since he was eight, a Formula 4 car built to fit him at eleven, and a book written at thirteen."
  jsonLdText={jsonLdText}
>
  <ChapterFurniture
    eyebrow="The author"
    title="Ryan Rijvers"
    subtitle="He is thirteen, and he wrote this book. He is probably not much older than you are."
  />

  <div class="wrap">
    <div class="prose">
      <p class="lede">
        From Schimmert, in the Netherlands. He wrote the book himself, in between racing
        karts across Europe and building things on a laptop. Here is the short version of
        how he got here.
      </p>
    </div>

    {/* Shot from behind: more cinematic than a face, less identifying, and the same
        harbour and evening light the book's illustrations were drawn from. */}
    <figure class="hero">
      <div class="hero__frame">
        <Image
          src={harbour}
          alt="Ryan Rijvers seen from behind at the harbour in Monaco at dusk, looking out
               over moored boats and the lit hillside beyond."
          widths={[640, 1024, 1600, 2560]}
          sizes="(min-width: 60rem) 56rem, 100vw"
          loading="eager"
        />
      </div>
    </figure>
  </div>

  <section class="wrap section" aria-labelledby="timeline-title">
    <h2 id="timeline-title">Eight to thirteen</h2>

    {/* Said before the first link rather than after the last one. A reader who taps a
        source and lands on a page of Dutch should have been told a paragraph earlier, not
        in a note further down the page they have now left. */}
    <p class="prose timeline-note">
      Where there is a date and a result, there is a link to the report of it, written at
      the time by somebody with no stake in this book. Every one of those reports is in
      Dutch, because that is where he races. There is more about that below.
    </p>

    <ol class="timeline">
      {
        TIMELINE.map((t) => (
          <li class="step">
            <p class="step__age" aria-hidden="true">
              {t.age}
            </p>
            <div class="step__body">
              <h3 class="step__title">
                <span class="step__sr">Age {t.age}: </span>
                {t.title}
              </h3>
              <p class="step__text">{t.body}</p>

              {t.sources && (
                <p class="step__source">
                  <span class="step__source-label">Source:</span>
                  {t.sources.map((s) => (
                    <span class="step__source-item">
                      <a href={s.href} rel="external noreferrer">
                        {s.label}
                      </a>
                    </span>
                  ))}
                </p>
              )}

              {/* The other half of the same rule. A blank where a source line would be says
                  "nothing to check here"; this says "something to check, and we cannot".
                  Only the Formula 4 step uses it. */}
              {t.unsourced && (
                <p class="step__source">
                  <span class="step__source-label">No source:</span>
                  <span class="step__source-item">{t.unsourced}</span>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* Where the timeline comes from.

      This section used to contain a paragraph in bold admitting that the results were not
      linked, and asking the reader to treat the page as reported rather than verified. It
      is gone, and so is the reason for it: the reports were found, checked and linked on
      the claims themselves. Do not reinstate a version of that paragraph — the honest move
      when a source is missing is to cut the claim, not to keep it with an apology.

      What is left here is the part a link cannot say: who these outlets are, why they are
      in a language most readers of this book do not have, and which single claim on the
      page still has nothing behind it. */}
  <section class="wrap section" aria-labelledby="sources">
    <h2 id="sources">Where all that comes from</h2>
    <div class="prose">
      <p>
        None of those links are ours. RaceXpress is a Dutch motorsport site and Parkstad
        Actueel is a local news site near where he lives. Both of them reported the races
        at the time, years before this book existed, so there was nothing in it for them
        either way.
      </p>
      <p>
        They are in Dutch. That is worth saying out loud rather than letting you find out
        by clicking: your browser will offer to translate them, and even if it does not,
        the part you came for — the date, the class, the finishing position — is readable
        anyway.
      </p>
      <p>
        This site's rule, set out on <a href="/hill">the Napoleon Hill page</a>, is that
        every number links to a primary source or it gets cut. That rule is aimed at a dead
        author with a famous name, so it has to apply here first. If you click one of these
        and it is dead, tell us — the mailbox at the bottom of this page is read by an
        adult, and a broken source on this page is a real problem, not a typo.
      </p>
      <p class="sources__date">
        Links checked on {verifiedLabel}.
        {
          stale && (
            <span class="sources__stale">
              We have not re-checked them since then — open them yourself before relying on
              this page.
            </span>
          )
        }
      </p>
      <p>
        The Formula 4 part is different, and the timeline says so where the claim sits.
        That came from Ryan's family rather than from a results sheet, because it is not a
        race and there is nothing to publish — which is exactly why it says he trains in
        the car instead of racing it.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="f4">
    <h2 id="f4">About that Formula 4 car</h2>
    <div class="prose">
      <p>
        At eleven he got into a Formula 4 car that had been built to fit him. That is the
        bit people skip over. An eleven-year-old does not fit an adult single-seater, so
        the seat, the pedals and the steering had to be made to his measurements before he
        could safely drive it at all.
      </p>
      <p class="pullquote">He does not race it. He trains in it.</p>
      <p>
        That difference matters, and it is the same difference this whole book is about.
        Training is the invisible part. Nobody films it, nobody posts it, and it is not
        the story anyone tells at school. It is also the part that decides what happens
        later, which is why it gets its own section here instead of being quietly rounded
        up into something that sounds bigger.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="now">
    <h2 id="now">What he is into now</h2>
    <div class="prose">
      <p>
        Building things with AI. Mostly with Claude Code — describing what he wants,
        watching it get made, then fixing what came out wrong. He loves it, and it is
        the same loop as everything else on this site: pick one thing, make the first
        step small enough to actually start, and keep what you build.
      </p>
      <p>
        You do not need a kart or a race licence for that one. A laptop and an afternoon
        will do, and <a href="/builds">nineteen of the builds in this book</a> are designed
        to fit inside a single one.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="portraits">
    <h2 id="portraits">The two pictures from the book</h2>

    <div class="portraits">
      <figure class="portrait">
        <div class="portrait__frame">
          <Image
            src={portraitBw}
            alt="Ryan Rijvers photographed head-on in black and white, in a racing
                 underlayer, against a plain wall."
            widths={[400, 800, 1179]}
            sizes="(min-width: 46rem) 22rem, 50vw"
            loading="lazy"
          />
        </div>
        <figcaption>On the back cover.</figcaption>
      </figure>

      <figure class="portrait">
        <div class="portrait__frame">
          <Image
            src={portraitIllustrated}
            alt="An illustrated portrait of Ryan Rijvers in a light blue polo shirt, against
                 navy, teal and orange brush strokes on off-white."
            widths={[300, 600]}
            sizes="(min-width: 46rem) 18rem, 50vw"
            loading="lazy"
          />
        </div>
        <figcaption>Drawn, for the closing pages.</figcaption>
      </figure>
    </div>

    <div class="prose">
      <p class="aside">
        Everywhere else in the book, the boy in the illustrations is not Ryan — he is
        whoever is reading. That is on purpose, and the two are never mixed up.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="why">
    <h2 id="why">“Why would I take advice from a thirteen-year-old?”</h2>
    <div class="prose">
      <p>
        Fair question. The honest answer is not that karting makes him an expert on money.
      </p>
      <p>
        It is that the method in this book — pick one thing, shrink the first step, do it
        before tomorrow night, keep the proof — is the method he already uses somewhere it
        is impossible to fake. A stopwatch does not care how you felt about it, whether you
        meant to, or what you posted afterwards. Either the lap was quicker or it was not.
      </p>
      <p>
        That is the only thing he is claiming, and it is why every build on this site ends
        with something you can point at.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="not-here">
    <h2 id="not-here">What is deliberately not on this page</h2>
    <div class="prose">
      <p>
        No school, no address, no training schedule, no race calendar, and no way to
        message him. He is thirteen. Results are public; a kid's week is not.
      </p>
      <p>
        There is one mailbox for this whole site, at the bottom of every page, and an adult
        reads it. Ryan does not reply to strangers anywhere.
      </p>
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p {
    margin-block-start: 0.9em;
  }

  .prose b {
    color: var(--text-strong);
  }

  .lede {
    margin-block-start: 1.75rem;
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    color: var(--text-strong);
  }

  .section {
    margin-block-start: 3rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  .hero {
    margin: 2rem 0 0;
  }

  .hero__frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .hero__frame :global(img),
  .portrait__frame :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---- The timeline -------------------------------------------------------------
     A rail down the left with a dot per step, which is the chapter-opener's spine and
     dot reused rather than a new device. The age is set in the book's display face,
     because the age is the fact worth reading from across the room. */

  .timeline-note {
    margin-block-start: 1.25rem;
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: var(--text-muted);
  }

  .timeline {
    margin-block-start: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    padding-inline-start: 3.25rem;
    padding-block-end: 2rem;
  }

  /* The rail. Drawn on the item rather than the list so the last step's rail can stop at
     its own dot instead of running on into white space. */
  .step::before {
    content: "";
    position: absolute;
    inset-block: 0.35rem 0;
    inset-inline-start: 0.5rem;
    inline-size: 3px;
    background: var(--accent-spine);
  }

  .step:last-child::before {
    block-size: 0.75rem;
    inset-block-end: auto;
  }

  .step::after {
    content: "";
    position: absolute;
    inset-block-start: 0.35rem;
    inset-inline-start: 0;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 50%;
    background: var(--accent-dot);
  }

  .step__age {
    font-family: var(--font-display);
    /* Deliberately larger than an H2: it is the number, not a label, and it is what the
       reader scans down the page for. */
    /* Capped at 2.5rem, not 3rem. At 3rem the widest entry ("10–11") measures 127px, which
       does not fit a column narrow enough to be worth having. */
    font-size: clamp(2rem, 7vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    /* Not teal-bright or orange. In light mode neither may carry text, and an age that
       changed colour between themes would read as two different kinds of information. */
    color: var(--text-strong);
    font-variant-numeric: tabular-nums slashed-zero;
    /* A range must not break. In a fixed column "8–10" wrapped to "8–" over "10", which
       reads as a rendering fault rather than a number. */
    white-space: nowrap;
  }

  .step__title {
    margin-block-start: 0.35rem;
    font-size: var(--text-heading);
    line-height: 1.25;
    color: var(--text-strong);
  }

  /* The age is decorative in the visual layout and essential in the reading order, so it
     is aria-hidden above and restated here for anyone listening to the page. */
  .step__sr {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .step__text {
    margin-block-start: 0.45rem;
    max-inline-size: var(--container-measure);
  }

  /* ---- Source lines -------------------------------------------------------------------
     Metadata, not prose: the same meta size and muted colour as the /hill citation block,
     so a citation reads the same wherever it appears on the site. */

  .step__source {
    margin-block-start: 0.6rem;
    max-inline-size: var(--container-measure);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: var(--text-muted);
  }

  /* "SOURCE:" / "NO SOURCE:" — the /hill sources label, reused. The word is what tells a
     reader which of the two this is; there is no colour difference to miss, and no flag,
     because a citation is not a Reality Check. */
  .step__source-label {
    margin-inline-end: 0.35rem;
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  /* The separator sits on the wrapper, never inside the anchor: content generated on an
     <a> lands in that link's accessible name, and no screen-reader user needs to hear
     "middle dot" as part of a publication title.

     Both gaps are margins rather than markup whitespace. The compiler strips the newlines
     between these spans, so a layout that assumed a collapsed space between them would
     render "RaceXpress·Parkstad Actueel" in production and be fine in dev. */
  .step__source-item + .step__source-item::before {
    content: "·";
    margin-inline: 0.3rem;
  }

  /* WCAG 2.2 target size. Meta text at 14px on a 1.45 line box gives a 20px-tall anchor,
     which is under 24 — and these are standalone links in a metadata line, not links
     inside a sentence, so leaning on the inline exception would be a stretch. The padding
     is on the anchor rather than the line so it is the hit area that grows. */
  .step__source a {
    display: inline-block;
    padding-block: 0.16rem;
  }

  /* From this width there is room to set the age beside its step rather than above it,
     which turns the column into something you can scan by age alone. */
  @media (min-width: 46rem) {
    .step {
      display: grid;
      /* Fixed, not max-content. Each step is its own grid, so max-content sized every row
         to its own age and the titles started at six different x positions — a 101px
         stagger down the column, which reads as a fault. 7rem clears the widest entry
         ("10–11" at 106px) with the ages right-aligned against the text. */
      grid-template-columns: 7rem minmax(0, 1fr);
