---
/**
 * Terms (docs/decisions.md D27, D28).
 *
 * The load-bearing part is not ours: it is the book's own Publishing Note from printed
 * page 2, quoted verbatim. Paraphrasing it would weaken a disclaimer whose wording has
 * already been settled in print, and the Napoleon Hill non-affiliation sentence is the
 * single most legally sensitive line on the site.
 *
 * The Publishing Note's Reality Check is rendered in full from the content collection,
 * like every other Reality Check on this site — never collapsed, never truncated.
 *
 * This page said, until now, that the book's stories, essays and illustrations "are not
 * published here". That was true under D4 and it stopped being true when non-negotiable 7
 * reversed it: /c/01 … /c/15 render The Story, The Hill Remix and What It Means Now in
 * full, and /teen-and-grow-rich.pdf is the whole book. A terms page is the one page a
 * school, a parent or a lawyer reads to find out what is actually true, so a stale
 * sentence here costs more than a stale sentence anywhere else on the site.
 *
 * Two things had to stay separate while fixing it, because collapsing them is the easy
 * mistake: **free to read** and **licensed** are not the same grant. The CC BY-NC-SA
 * material is the site's own — worksheets, builds, printables — and a teacher may remix
 * it. The book's text is given away, not licensed away; copyright is still Ryan's. /get
 * and /teachers both link here for the licences, so this page has to be the precise one.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";
import Box from "../components/Box.astro";
import PageRef from "../components/PageRef.astro";
import { allRealityChecks } from "../lib/content";

const note = (await allRealityChecks()).find((c) => c.id === "publishing-note")!;

/** D27: licence by content type. Safety text is no-derivatives so an altered warning
 *  cannot legally circulate; everything a teacher needs to remix is share-alike.
 *
 *  The third row is the one that used to be wrong. It said the stories were "not published
 *  here", which described the site as it was before the whole book went free. What is
 *  actually true is stranger and needs saying in two halves: the text is free to read AND
 *  the copyright is unchanged. So it keeps "all rights reserved" — the honest legal
 *  position — and then spells out, in plain words, the permission actually being given.
 *  It is deliberately not relabelled CC: a Creative Commons grant is irrevocable, and
 *  handing the book's text away under one is a decision for the owner, not for a page.
 *
 *  For the same reason the row grants reading and downloading but NOT redistribution of
 *  the file. An earlier draft here said "put the PDF on a school drive, hand it to a
 *  class", which is a redistribution licence, and it contradicted /get outright. Nobody
 *  loses anything by the narrower version: the text is free at the link, so a teacher who
 *  sends the link has given a class exactly what the file would have. The difference is
 *  that a link stays current and stays attached to its source, and a permission that was
 *  never granted can still be granted later — the reverse is not true. */
const LICENCES = [
  {
    what: "This site's worksheets, builds, tools and templates",
    licence: "CC BY-NC-SA 4.0",
    means:
      "Copy them, print them, photocopy them for a class, remix them. Credit the book, do not resell them, and keep anything you make from them just as open.",
  },
  {
    what: "The 19 Reality Checks and all safety text",
    licence: "CC BY-NC-ND 4.0",
    means:
      "Copy and share them freely, unchanged. No derivatives — an edited safety warning is a dangerous object, and this is how we stop one circulating with our name on it.",
  },
  {
    what: "The book's stories, essays and illustrations",
    licence: "All rights reserved — and free to read",
    means:
      "All 15 chapters are published on this site, and the whole book is here as a PDF. Read it, download it, print a copy for yourself — free, and you never have to ask. Copyright is still Ryan's, though: this row is not a Creative Commons licence. Send a class the link rather than the file. Do not sell the text, put it inside anything anyone pays for, repost it, or publish it under another name.",
  },
];
---

<Page
  title="Terms"
  description="The book's own educational-content-only disclaimer, verbatim from printed page 2, plus what this site publishes, what it costs, and how it may be copied, printed and taught."
  printedPage={note.data.printedPage}
>
  <ChapterFurniture
    eyebrow="Terms"
    title="Terms"
    subtitle="Short, because there is not much to agree to. Nothing here is locked and nothing here collects anything from you."
  />

  <section class="wrap section" aria-labelledby="publishing-note">
    <h2 id="publishing-note">The book's Publishing Note, verbatim</h2>
    <div class="prose">
      <p class="meta"><PageRef page={note.data.printedPage} kind="Publishing Note" /></p>
      <p>
        This is reproduced exactly as it is printed in the book, and it applies to this
        website as well.
      </p>

      <blockquote>
        <p>
          This is an independent, original work inspired by widely discussed success
          principles associated with Napoleon Hill. It is not a translation or reproduction
          of Think and Grow Rich, and it is not affiliated with, authorized by, or endorsed
          by the Napoleon Hill Foundation.
        </p>
        <p>
          The stories in this edition are fictional composites. They are designed to make
          the principles easy to understand; they are not presented as verified case
          studies. Examples of income, audience growth, or opportunity are not promises or
          typical results.
        </p>
        <p>
          Educational content only. This book is not medical, legal, tax, investment, or
          financial advice. Laws, platform rules, payments, accounts, and work permissions
          vary by country. Readers under 18 should involve a parent or guardian for
          decisions involving money, contracts, personal data, travel, meetings, or safety.
        </p>
      </blockquote>
    </div>

    <Box kind="check" class="check">
      <p>{note.data.text}</p>
    </Box>

    <div class="prose">
      <p class="note">
        Created in English for readers aged 13 and up. Copyright © 2026 Ryan Rijvers /
        Bright Kids. All rights reserved. Why the site publishes an audit of Napoleon Hill
        himself: <a href="/hill">the Napoleon Hill audit</a>.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="using">
    <h2 id="using">Using this site</h2>
    <div class="rows">
      <div class="row">
        <p class="row__key">It is all free</p>
        <p class="row__value">
          Every build, Reality Check, worksheet, template and chapter tool is open on your
          first visit — and so is the book itself. All 15 chapters, with the story, the Hill
          Remix and What It Means Now, are on the chapter pages, and the whole thing is a{" "}
          <a href="/teen-and-grow-rich.pdf" download>PDF you can download</a>. No account,
          no email address, no paywall, no earned unlock, no progress gate, and no sample
          that stops halfway.
        </p>
      </div>
      <div class="row">
        <p class="row__key">What costs money</p>
        <p class="row__value">
          The printed copy, and what you are paying for is the object, not the words. Every
          word in it is on this site for nothing. A printed book is a thing you can hand to
          somebody, mark up, finish without a notification closing it, and still have when a
          browser clears itself. This site has no checkout and cannot take a payment.
        </p>
      </div>
      <div class="row">
        <p class="row__key">Nothing is collected</p>
        <p class="row__value">
          There is no form on this site that sends anything anywhere, and no account to
          make. What you type is kept in your browser. See <a href="/privacy">privacy</a>.
        </p>
      </div>
      <div class="row">
        <p class="row__key">Nowhere to post</p>
        <p class="row__value">
          No comments, no forum, no profiles, no messages, no uploads. There is one
          adult-monitored mailbox, at the bottom of every page, and it is the only inbound
          route on the whole domain.
        </p>
      </div>
      <div class="row">
        <p class="row__key">The AI tools</p>
        <p class="row__value">
          <a href="/tools/scam-check">Scam Check</a> and{" "}
          <a href="/tools/shrink">Shrink My First Step</a> are aids, not advice, and not a
          verdict. They can be wrong. An adult is still the gate, and every warning they
          give ends by telling you to show one.
        </p>
      </div>
      <div class="row">
        <p class="row__key">No promises about money</p>
        <p class="row__value">
          There are no income figures on this site and none in the book. Nothing here is a
          prediction of what you will earn, and the fact that something worked in an
          example is not a claim that it is typical.
        </p>
      </div>
      <div class="row">
        <p class="row__key">Under 18</p>
        <p class="row__value">
          Bring in a parent, guardian or another trusted adult before anything involving
          money, contracts, personal data, travel, meetings or safety. Several builds say
          this on their own page, in the flag at the top.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="licence">
    <h2 id="licence">Copying, printing and teaching</h2>
    <div class="prose">
      <p>
        Yes — print or photocopy any worksheet for your class, free, no permission needed.
        The pack is free to any teacher, parent, club or youth worker, and it may not be
        included in any paid programme.
      </p>
    </div>

    <div class="rows">
      {
        LICENCES.map((l) => (
          <div class="row">
            <p class="row__key">{l.what}</p>
            <div class="row__value">
              <p class="row__licence">{l.licence}</p>
              <p>{l.means}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="prose">
      <p>
        Those three rows are three different grants, and the difference is worth thirty
        seconds. <b>Free to read is not the same as licensed.</b> The Creative Commons
        licence covers the material this site made — the worksheets, the builds, the
        printables — and a teacher may genuinely remix those. It does not stretch over the
        book's text or the PDF. Being able to download something for nothing has never been
        permission to hand it on or to sell it.
      </p>
      <p>
        The plain version, if you only read one line: copy anything this site made for a
        class, for free, forever. Share the book by sending its link, not its file. Sell
        none of it, and put none of it inside a course, a coaching programme or anything
        else somebody pays for. If another page on this site sounds looser than that, this
        page is the one that counts.
      </p>
    </div>

    <p class="prose note">
      Licence texts:{" "}
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="external noreferrer">CC BY-NC-SA 4.0</a>{" "}
      and{" "}
      <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="external noreferrer">CC BY-NC-ND 4.0</a>.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="changes">
    <h2 id="changes">Changes and contact</h2>
    <div class="prose">
      <p>
        Changes to this site are dated and listed on <a href="/updates">the changelog</a>,
        including changes to this page. Printed page numbers refer to a specific print run;
        which one, and how the page-number routing survives a second, is on{" "}
        <a href="/editions">editions</a>.
      </p>
      <p>
        For anything else, use the mailbox at the bottom of this page. An adult reads it,
        nobody reads it urgently, and it is not a crisis service.
      </p>
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p,
  .prose blockquote {
    margin-block-start: 0.9em;
  }

  .section {
    margin-block-start: 3rem;
  }

  .section:first-of-type {
    margin-block-start: 2rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  .section > .prose {
    margin-block-start: 0.75rem;
  }

  .meta {
    color: var(--text-muted);
  }

  blockquote {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--accent-spine);
  }

  blockquote p + p {
    margin-block-start: 0.9em;
  }

  .check {
    margin-block-start: 1.5rem;
  }

  .rows {
    margin-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule-hairline);
  }

  .row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .row__key {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .row__value {
    max-inline-size: var(--container-measure);
  }

  .row__licence {
    font-weight: 700;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .note {
    margin-block-start: 1.25rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  a {
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  a:hover {
    text-decoration-color: var(--accent-spine);
  }
</style>
