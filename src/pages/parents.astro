---
/**
 * Race Control — the parents, guardians, teachers and mentors page (printed page 61).
 *
 * Two audiences, and the page says which paragraph is for whom rather than pretending
 * there is one reader. The adult sections are the book's page 61 quoted in full; the last
 * section is written to the teenager, because the safety system's real failure mode (D25)
 * is a reader with nobody to ask, and that reader is reading this page too.
 *
 * The traffic-light system is the site's primary UI atom (D12) rendered with the same
 * Flag component the builds and Reality Checks use, with the book's own definitions —
 * so what an adult reads here is literally what a reader sees on a build card.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import Box from "../components/Box.astro";
import Flag from "../components/Flag.astro";
import PageRef from "../components/PageRef.astro";
import { allRealityChecks } from "../lib/content";
import { WHO_COUNTS, FAMILY_RULE } from "./reality-check/_checks";
import { FLAG_RULE_PAGE } from "../lib/build-meta";

const checks = await allRealityChecks();

/* Book page 61, verbatim, including the book's own punctuation. The tiers are the
   author's definitions; the "in practice" line is ours, and is labelled as ours. */
const TIERS = [
  {
    level: "green" as const,
    book: "Green decisions are low-cost and reversible.",
    practice:
      "Go. No check-in needed. Most of the 19 builds live here: writing something down, making a first version, practicing a skill, sorting last week's spending.",
  },
  {
    level: "yellow" as const,
    book: "Yellow decisions involve public posting, small spending, or contact with new people and require a check-in.",
    practice:
      "A conversation before it happens, not a veto. This is where the site expects the most friction, and where a two-minute look at the post or the message does most of the work.",
  },
  {
    level: "red" as const,
    book: "Red decisions involve contracts, financial products, travel, identity documents, large payments, or in-person meetings and require direct adult involvement.",
    practice:
      "You are in the room. The account, the signature and the payment route are yours, not theirs — including where a platform's own terms require it.",
  },
];

/* Printed page 61, verbatim. Six questions, in the book's order and wording. */
const QUESTIONS = [
  "What problem are you solving?",
  "What proof do you have?",
  "Who could be harmed?",
  "What does the platform allow?",
  "What happens if the client is unhappy?",
  "How will school, sleep, and family time be protected?",
];
---

{/* Titled for what a parent actually types into a search box. "Race Control" is the
    book's name for this page and is still the H1, but nobody searches for it — they
    search for the arrangement they are trying to make with a teenager who has started
    doing things online, and the sheet at the bottom of this page is that arrangement. */}
<Page
  title="A family agreement for a teen working online"
  description="A printable one-page family agreement for a teenager working online: the green, yellow and red rule, the six questions to ask, and what needs an adult in the room."
  printedPage={61}
>
  <ChapterFurniture
    eyebrow="For parents, guardians, teachers and mentors"
    title="Race Control"
    subtitle="The goal is supported independence — not unsupervised risk."
  />

    <div class="wrap">
      <SafetyNotice tone="crisis" />
    </div>

  <div class="prose">
    <p class="lead">
      <PageRef page={61} kind="For Parents & Guardians" />
    </p>

    <p>
      A motivated teen can build real skills, useful projects, and even early income. The
      adult role is not to take over the project. It is to create guardrails around money,
      contracts, privacy, travel, online contact, intellectual property, taxes, and
      wellbeing.
    </p>

    <p class="quoted">Book page 61, word for word.</p>

    <p>
      This site is the tools half of that book. It keeps no accounts, asks for no email
      address, and sends nothing anywhere — a reader's work is kept in their own browser
      and printed, not stored by us. The verifiable version of that claim, written for a
      school IT reviewer, is on <a href="/schools/privacy">the schools privacy page</a>.
    </p>

    {/* The single most reassuring thing this project can say to an adult, and until now
        the parents page never said it: the book's definition of wealth is six axes, not
        one. Stated here as the book's argument, not as a promise about outcomes. */}
    <h2 class="section">What this book means by rich</h2>
    <p>
      Not money on its own. The last chapter defines wealth as six things, scored
      separately: skills, health, time, people, money and impact. The build for it is a
      one-page dashboard with all six on it. That is the book's own answer to the thing
      most adults worry about here — a plan that pushes one number up while five go down
      is not a good plan — and a reader meets it as the point of the whole book rather
      than as a warning from a parent.
    </p>
    <p>
      <a href="/worksheet/real-rich-scoreboard">The Real Rich Scoreboard</a> is where they
      score the six from one to ten and pick one action for the lowest area. It prints, and
      the answers copy out as plain text.
    </p>
    <p class="attribution">Chapter 15, book page 54.</p>
  </div>

  <section class="tiers" aria-labelledby="tiers-h">
    <div class="tiers__inner">
      <h2 id="tiers-h" class="section">The family approval system</h2>
      <p class="tiers__intro">
        Three levels, no fourth. The book suggests it on page 61; this site uses it as its
        main piece of interface, so the flag on a build card and the flag in this table
        mean exactly the same thing.
      </p>

      <ul class="tier-list">
        {
          TIERS.map((tier) => (
            <li class={`tier tier--${tier.level}`}>
              <div class="tier__flag">
                <Flag level={tier.level} />
              </div>
              <p class="tier__book">{tier.book}</p>
              <p class="tier__practice">{tier.practice}</p>
            </li>
          ))
        }
      </ul>

      <p class="tiers__note">
        There is no chequered flag on this site. Chequered means the session is over, which
        is the wrong idea for a plan measured in months.
      </p>
    </div>
  </section>

  <div class="prose">
    <h2 class="section">Useful questions are more powerful than instant answers</h2>
    <p>
      That sentence is the book's, and so are the six questions under it. They are worth
      more than a yes or a no, because they are answerable by the person doing the work.
    </p>

    <ol class="questions">
      {QUESTIONS.map((q) => <li>{q}</li>)}
    </ol>

    <p class="attribution">Printed page 61, in the book's order and wording.</p>

    <h2 class="section">Praise the evidence</h2>
    <p>
      Praise evidence and learning, not only money or attention. The healthiest outcome is
      a young person who can think clearly, ask for help, recover from mistakes, and build
      without tying their worth to results.
    </p>
    <p class="quoted">Book page 61, word for word.</p>

    <div class="rule-box">
      <Box kind="check">
        <p class="rule-box__label">A simple family rule</p>
        <p>{FAMILY_RULE}</p>
      </Box>
    </div>

    <h2 class="section">The safety layer, in one place</h2>
    <p>
      There are {checks.length} Reality Checks in the book — the paragraphs that say what
      could actually go wrong. All {checks.length} are on this site in full, grouped by
      risk, and printable for a class or a kitchen wall.
    </p>
    <p>
      <a class="cta" href="/reality-check" data-tap>Read all {checks.length} Reality Checks</a>
    </p>

    {/* The most common real situation for the adult who bought the book, and the page had
        nothing for it. Written without a compliance technique on purpose: there isn't an
        honest one, and inventing one would be the exact hustle-adjacent move the book
        argues against. What is true — and is a property of how this site is built, not a
        line of comfort — is that nothing here is sequential or gated, so a teenager who
        never opens chapter one has lost nothing. Two entry points, both of which make
        sense to somebody who has read none of it. */}
    <h2 class="section">If your teen does not want to read it</h2>
    <p>
      Common, and there is no technique on this page for changing it. There is also
      nothing here that depends on it. Nothing is sequential and nothing is locked: no
      chapter has to be read before another one works, no build waits for the build before
      it, and starting in the middle costs a reader nothing.
    </p>
    <p>
      So the useful thing is not a reading plan. It is a single page that makes sense on
      its own, with nothing read first. There are two:
    </p>
    <ul class="entries">
      <li>
        {/* Named as not built, the way /get and /schools/privacy name it. This page was
            recommending it in the present tense as the answer to the most common problem a
            parent brings, and the link landed on "Not live yet". */}
        <a href="/tools/scam-check">Scam Check</a> — not built yet. When it is, they paste
        the actual thing: the "job", the offer in the DMs, the message that felt off, and it
        comes back with a flag, which red flags matched, and the page of the book that
        covers it. The page is already up and shows exactly what it will ask for and give
        back. Nothing pasted into it will ever be stored.
      </li>
      <li>
        <a href="/worksheet/real-rich-scoreboard">The Real Rich Scoreboard</a> — six scores
        out of ten and one action for the lowest one. It takes a few minutes, it needs no
        context from the book, and it is the argument above in one sheet.
      </li>
    </ul>
    <p>
      The book works the same way. If it is open on the table, type the page number into
      the field on <a href="/">the home page</a> and this site opens the tool for that
      page. No chapter first, no order, no starting point.
    </p>
  </div>

  <section class="no-adult" aria-labelledby="no-adult-h">
    <div class="no-adult__inner">
      <p class="no-adult__eyebrow">This part is for the reader, not the adult</p>
      <h2 id="no-adult-h" class="section">If there is nobody to ask</h2>

      <p>
        The whole system above assumes an adult who is around, awake, and willing. That is
        not everyone's house. If it is not yours, the honest answer is not "do it anyway"
        and it is not "stop".
      </p>

      <p class="no-adult__lead">An adult here means any of these:</p>
      <ul class="who">
        {WHO_COUNTS.map((who) => <li>{who}</li>)}
      </ul>

      <p>
        A teacher, a coach, a librarian or a youth worker is not a second-best version of a
        parent for this. For questions about platform rules, contracts or whether an offer
        is real, several of them are better placed than most parents are.
      </p>

      <p>
        If a build needs an adult and there is nobody yet, do the part that does not need
        one and write down the part you could not do. That note is the receipt. Nothing on
        this site is locked, timed, or waiting for permission — the only thing that waits
        for an adult is a yellow or red decision, and those genuinely need one.
      </p>

      <p>
        And going around the gate is the failure, not the clever move. If the adult you ask
        says no, that is information about timing — about this offer, this week, this
        amount of money. It is not information about you.
      </p>
    </div>
  </section>

  {/* The family agreement, as a thing you can actually put on the fridge.

      The book asks a family to agree the rule once, up front, rather than negotiate it at
      the moment something is already happening — which is when nobody negotiates well. The
      site described that and never gave anyone the sheet.

      Deliberately not a form and not stored anywhere: it is printed and filled in with a
      pen, by two people, in the same room. That is the whole mechanism. Anything that
      collected these answers would be collecting family arrangements about a minor, which
      is exactly what this site exists not to hold. */}
  <section class="agreement" aria-labelledby="agreement-h">
    <h2 id="agreement-h" class="section">The agreement, on one sheet</h2>

    <div class="prose" data-print="hide">
      <p>
        Worth doing before anything is at stake rather than in the middle of it. Print this,
        fill it in together, and put it where you will both see it. It takes about ten
        minutes and it settles the arguments you would otherwise have one at a time.
      </p>
      <p>
        Nothing here is stored, sent or read by us — there is no form on this page. It is a
        sheet of paper, and that is the point of it.
      </p>
      <p>
        <button type="button" class="btn btn--primary print-action" data-print-page>
          Print the agreement
        </button>
        <span class="agreement__nojs">
          Use your browser's print command — File, then Print. You get the sheet, and
          nothing else from this page.
        </span>
      </p>
    </div>

    <div class="sheet print-sheet">
      <p class="sheet__title">Our agreement</p>
      <p class="sheet__sub">
        Between <span class="sheet__rule"></span> and <span class="sheet__rule"></span>,
        dated <span class="sheet__rule sheet__rule--short"></span>
      </p>

      <ol class="sheet__terms">
        <li>
          <b>Green is yours.</b> Low-cost, reversible things — writing, making, practising,
          a first version nobody sees — need nobody's permission and no announcement.
        </li>
        <li>
          <b>Yellow gets said out loud first.</b> Posting publicly, spending a little,
          talking to someone new. A conversation before, not a report after.
          <span class="sheet__fill">We will check in by: <span class="sheet__rule"></span></span>
        </li>
        <li>
          <b>Red happens together.</b> Contracts, money moving, identity documents,
          travelling, meeting anyone in person. The adult is on the account and on the
          signature.
        </li>
        <li>
          <b>No secrecy around money, meetings, identity documents, or pressure.</b> A
          legitimate opportunity can survive an adult review and a night of sleep.
        </li>
        <li>
          <b>Bringing something worrying is never punished.</b> Not the message, not the
          mistake, not the money already sent. The only thing that makes any of those worse
          is finding out late.
          <span class="sheet__fill">The adult I will tell first: <span class="sheet__rule"></span></span>
        </li>
        <li>
          <b>We look at the evidence, not the mood.</b> The question is what exists now that
          did not exist last week — not how motivated anyone feels about it.
        </li>
        <li class="sheet__own">
          <b>One rule we are adding ourselves:</b>
          <span class="sheet__rule sheet__rule--wide"></span>
        </li>
      </ol>

      <p class="sheet__sign">
        Signed <span class="sheet__rule"></span> and <span class="sheet__rule"></span>
      </p>

      <p class="sheet__foot">
        The green/yellow/red rule is printed in Teen &amp; Grow Rich, book page {FLAG_RULE_PAGE}.
        Everything else on this sheet is this site putting it into practice.
      </p>
    </div>
  </section>
</Page>

<script>
  /* Progressive enhancement only. The sheet is complete and printable without this, and
     .print-action stays invisible until ThemeScript has set data-js on <html>. Identical
     three lines to /teachers, deliberately not shared: two pages is not a pattern, and a
     helper that has to be imported is a helper that can be forgotten — which is how this
     button shipped with no script at all. */
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-print-page]")) {
    btn.addEventListener("click", () => window.print());
  }
</script>

<style>
  .prose {
    max-inline-size: var(--container-measure);
    margin-inline: auto;
    padding: 1.75rem clamp(1.25rem, 5vw, 3rem) 0;
  }

  .prose p + p {
    margin-block-start: 0.9em;
  }

  .lead {
    margin-block-end: 1.25rem;
  }

  .section {
    margin-block-start: 2.25rem;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
  }

  .prose .section {
    margin-block-end: 0.75rem;
  }

  .quoted,
  .attribution {
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  /* --- The three tiers ----------------------------------------------------- */

  .tiers {
    margin-block-start: 2.5rem;
    padding-block: 0.5rem 2rem;
    background: var(--surface-card);
    border-block: 1px solid var(--rule-hairline);
  }

  .tiers__inner {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .tiers__intro,
  .tiers__note {
    max-inline-size: var(--container-measure);
  }

  .tiers__note {
    margin-block-start: 1.25rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .tier-list {
    display: grid;
    gap: 1px;
    margin-block-start: 1.5rem;
    padding: 0;
    list-style: none;
    background: var(--rule-hairline);
    border: 1px solid var(--rule-hairline);
  }

  /* Stacked cards on a phone, three columns when there is genuinely room. The book's
     own tables collapse the same way; the page body never scrolls sideways. */
  @media (min-width: 52rem) {
    .tier-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tier {
    padding: 1rem 1.1rem;
    background: var(--surface-page);
    /* Weight as well as colour: on a monochrome photocopy the three tints are one grey,
       so the left edge has to carry the distinction too. */
    border-inline-start: 6px solid var(--tier-edge);
  }

  .tier--green {
    --tier-edge: var(--flag-green);
  }
  .tier--yellow {
    --tier-edge: var(--flag-yellow);
  }
  .tier--red {
    --tier-edge: var(--flag-red);
  }

  .tier__book {
    margin-block-start: 0.6rem;
    font-weight: 700;
    color: var(--text-strong);
  }

  .tier__practice {
    margin-block-start: 0.5rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  /* --- The six questions --------------------------------------------------- */

  .questions {
    margin-block: 1rem;
    padding-inline-start: 0;
    list-style: none;
    counter-reset: q;
  }

  .questions li {
    position: relative;
    padding-inline-start: 2.4rem;
    padding-block: 0.5rem;
    border-block-start: 1px solid var(--rule-hairline);
    counter-increment: q;
    font-weight: 700;
    color: var(--text-strong);
  }

  .questions li::before {
    content: counter(q);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.5rem;
    font-variant-numeric: tabular-nums slashed-zero;
    color: var(--text-muted);
  }

  .rule-box {
    margin-block-start: 2rem;
  }

  .rule-box__label {
    font-weight: 700;
    color: var(--text-strong);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding: 0.7rem 1.1rem;
    /* Orange fill, navy text. White on orange is 2.05:1 and is forbidden. */
    background: var(--cta-fill);
    color: var(--cta-text);
    font-weight: 700;
    text-decoration: none;
  }

  /* Same dash marker as the .who list further down, on purpose: both are "here are the
     concrete options" lists, and giving them two different bullets on one page would
     imply a distinction that is not there. */
  .entries {
    margin-block-start: 0.9em;
    padding-inline-start: 1.1rem;
    list-style: none;
  }

  .entries li {
    position: relative;
    margin-block-start: 0.6rem;
  }

  .entries li::before {
    content: "";
    position: absolute;
    inset-inline-start: -1.1rem;
    inset-block-start: 0.62em;
    inline-size: 0.5rem;
    block-size: 2px;
    background: var(--accent-spine);
  }

  /* `.prose p + p` cannot reach the paragraph after the list. */
  .entries + p {
    margin-block-start: 0.9em;
  }

  /* --- No adult available -------------------------------------------------- */

  .no-adult {
    margin-block-start: 3rem;
    padding-block: 0.5rem 2rem;
    background: var(--surface-card);
    border-block: 1px solid var(--rule-hairline);
  }

  .no-adult__inner {
    max-inline-size: var(--container-measure);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .no-adult__inner p + p {
    margin-block-start: 0.9em;
  }

  .no-adult__eyebrow {
    margin-block-start: 1.5rem;
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    color: var(--text-eyebrow-colour);
  }

  .no-adult__lead {
    font-weight: 700;
  }

  .who {
    margin-block-start: 0.5rem;
    padding-inline-start: 1.1rem;
    list-style: none;
  }

  .who li {
    position: relative;
    margin-block-start: 0.2rem;
  }

  .who li::before {
    content: "";
    position: absolute;
    inset-inline-start: -1.1rem;
    inset-block-start: 0.62em;
    inline-size: 0.5rem;
    block-size: 2px;
    background: var(--accent-spine);
  }

  /* "Print the agreement" prints the agreement, and nothing else.

     It used to print the whole page: roughly 1,200 words of adult guidance across three
     sheets before reaching the sheet the button names. The guidance is written to be read
     on screen; the thing that goes on the fridge is the last section, and the sentence
     above the button promises exactly that — "Print this, fill it in together, and put it
     where you will both see it."

     The agreement's own intro prose already carries data-print="hide" from global.css, so
     only the page body above it needs hiding here. */
  @media print {
    .prose,
    .tiers,
    .no-adult,
    #agreement-h {
      display: none;
    }
  }

  /* --- The printable agreement ---------------------------------------------------- */

  .agreement {
    max-inline-size: 72rem;
    margin: 3rem auto 0;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .agreement .prose {
    max-inline-size: var(--container-measure);
    margin-block-start: 0.75rem;
  }

  .agreement .prose p + p {
    margin-block-start: 0.9em;
  }

  /* Hidden until scripting has proved it can work — the same rule /teachers and the
     Reality Check index use. This button shipped once as markup with no script behind it:
     visible, focusable, orange, and inert, with the working instruction beside it hidden
     from everyone whose JavaScript was on. A print button that does nothing is worse than
     the browser's own print command, which every adult already has. */
  .print-action {
    display: none;
  }

  :global(:root[data-js]) .print-action {
    display: inline-flex;
  }

  :global(html:not([data-js])) .agreement__nojs {
    display: inline;
  }

  :global(html[data-js]) .agreement__nojs {
    display: none;
  }

  .agreement__nojs {
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .sheet {
    max-inline-size: var(--container-measure);
    margin-block-start: 1.5rem;
    padding: 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--rule-hairline);
  }

  .sheet__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 6vw, 2rem);
    line-height: 1.1;
    color: var(--text-strong);
  }

  .sheet__sub,
  .sheet__sign {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    margin-block-start: 0.6rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .sheet__sign {
    margin-block-start: 1.5rem;
  }

  .sheet__rule {
    flex: 1 1 7rem;
    min-inline-size: 5rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .sheet__rule--short {
    flex-basis: 4rem;
  }

  .sheet__rule--wide {
    display: block;
    margin-block-start: 0.6rem;
    block-size: 1.4rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .sheet__terms {
    margin-block-start: 1.25rem;
    padding-inline-start: 1.2rem;
  }

  .sheet__terms li + li {
    margin-block-start: 0.7rem;
  }

  .sheet__terms b {
    color: var(--text-strong);
  }

  .sheet__fill {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-block-start: 0.4rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .sheet__foot {
    margin-block-start: 1.25rem;
    padding-block-start: 0.8rem;
    border-block-start: 1px solid var(--rule-hairline);
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  @media print {
    /* No break-before any more. Everything above the sheet is hidden in print (see the
       block further up), so a forced page break here would spend a blank sheet of paper
       before the only sheet the reader asked for. */
    .sheet {
