<script>
  /* Progressive enhancement only. Both sheets are complete and printable without this, and
     the buttons stay invisible until ThemeScript has set data-js on <html> — a print button
     that does nothing is worse than the browser's own print command, which every teacher
     already has. Two buttons, one per sheet, doing the identical thing: WCAG 2.2 3.2.6
     wants the same help in the same place, and both sheets come off the same print run. */
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-print-page]")) {
    btn.addEventListener("click", () => window.print());
  }
