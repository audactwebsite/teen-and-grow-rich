---
/**
 * Race Control, for the person the rule is actually about.
 *
 * The traffic-light rule is printed on page 61 of the book, in the "For Parents & Guardians"
 * section, and /parents renders it for adults. Three separate reviews noticed the same gap:
 * there is nowhere on this site that explains the rule to a thirteen-year-old. They meet it
 * as a coloured label on a build card, after they have already opened the build — which is
 * to say, after the decision.
 *
 * So this page is the rule, first, in the reader's own language, before anything is at
 * stake. Deliberately static: no JavaScript, no widget, no questionnaire that stores an
 * answer. It is a thing to read, and a thing a family can print and put on a fridge.
 *
 * The book's own wording is quoted verbatim in `book`. Everything in `you` and in the
 * examples is site-authored, written by applying that printed rule — the same boundary the
 * nineteen derived build flags are under, and stated on the page rather than blurred.
 *
 * The examples deliberately reach past money. The printed rule turns on two things —
 * whether a decision can be undone, and whether anyone other than the reader is in it —
 * and neither is financial. The book knows this: the extracted content names an adult on
 * 30 separate printed pages spread over eleven different chapters, and its Reality Checks
 * apply the same three levels to DMs, photos, location, platform age rules and meeting
 * people. A page whose every example was a payment would read as a money rule, be filed as
 * one, and be no use to the reader who needs it at eleven at night about a message — or to
 * a school that teaches no financial education at all.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";
import Flag from "../components/Flag.astro";
import PageRef from "../components/PageRef.astro";
import { FAMILY_RULE } from "./reality-check/_checks";
import { FLAG_RULE_PAGE } from "../lib/build-meta";
import { allRealityChecks } from "../lib/content";

/**
 * Printed anchors for the three examples furthest from money, so the page can show its
 * working. Read from the content collection rather than typed in: page numbers are
 * edition-specific, and a wrong one on a safety page sends a reader to a blank worksheet.
 * Throws rather than falling back — a missing anchor must not render as a plausible number.
 */
const checks = await allRealityChecks();
const pageOfCheck = (id: string): number => {
  const check = checks.find((c) => c.id === id);
  if (!check) {
    throw new Error(
      `race-control: no Reality Check "${id}". The non-money examples on this page cite it ` +
        "as their printed anchor, so the citation cannot be rendered without it.",
    );
  }
  return check.data.printedPage;
};

const AI_TOOL_PAGE = pageOfCheck("create-magic");
const ONLINE_CONTACT_PAGE = pageOfCheck("squad-goals");
const LOCATION_PAGE = pageOfCheck("vibe-check");

const TIERS = [
  {
    level: "green" as const,
    heading: "Green — go",
    /** Verbatim, printed page 61. */
    book: "Green decisions are low-cost and reversible.",
    you: "Just do it. Nobody needs to approve this and nothing breaks if it goes wrong. Most of what is on this site is green.",
    like: [
      "Writing your idea down",
      "Making a first version nobody sees",
      "Practising a skill for twenty minutes",
      "Sorting what you spent last week",
      "Writing the message — sending it is a separate question",
      "Blocking someone, or leaving a group chat",
    ],
  },
  {
    level: "yellow" as const,
    heading: "Yellow — say it out loud first",
    book: "Yellow decisions involve public posting, small spending, or contact with new people and require a check-in.",
    you: "Tell an adult before, not after. This is a conversation, not permission — they are looking at it with you, and most of the time they will say go ahead.",
    like: [
      "Posting something publicly with your name on it",
      "Making a new account, or turning a private one public",
      "Posting anything that shows where you are, or where you will be",
      "Messaging someone you have never met",
      "Spending a small amount of your own money",
      /* Anchored on printed page 24: "Never upload private material or another person's
         work into an AI tool without permission." The site then ships two AI tools at
         thirteen-year-olds and asks them to paste a real offer or a real DM into one. That
         input leaves the device — it is never kept, but it is sent — and it is usually
         somebody else's words. Naming the site's own tools here rather than only inside
         their disclosure is the point: the guidance has to apply to us too. */
      "Pasting a real message, offer or someone's details into an AI tool — the two on this site included",
      "Agreeing to do something for someone by a date",
    ],
  },
  {
    level: "red" as const,
    heading: "Red — an adult does it with you",
    book: "Red decisions involve contracts, financial products, travel, identity documents, large payments, or in-person meetings and require direct adult involvement.",
    you: "Not you on your own. An adult is in the room, on the account and on the signature. This is not because you cannot be trusted — it is because these are the ones that are hard to undo.",
    like: [
      /* "Signing" here means a real agreement — a contract, a form, terms somebody wants
         you personally bound by. Making an ordinary account is yellow, one tier up, or the
         rule would turn every app install red and get ignored the first week. */
      "Anything you have to sign, or agree to in somebody else's name",
      "Meeting anyone in person who you only know from online",
      /* Printed page 36: do not share your address, school schedule, private documents,
         passwords or financial details, and involve an adult before meeting anyone in
         person. Telling a stranger where you will be is the first half of that meeting,
         so it is read at the same level. */
      "Telling someone you only know online where you live, where you go to school, or where you will be",
      "Sending ID, a passport page or a bank card",
      "Travelling somewhere for it",
      /* Not "anything where money moves". The printed rule puts small spending in yellow
         and large payments in red, so the broader wording contradicted the yellow card
         one column over — and a rule that turns red on a three-euro purchase is a rule a
         reader switches off in the first week. Investing and crypto stay red at any size:
         the book files those under financial products, which it flags without a
         threshold, and losing the money is the reversible part of crypto anyway. */
      "A large payment — and investing or crypto, whatever the amount",
    ],
  },
];

/**
 * Three questions, in order. The first yes decides it.
 *
 * These have to name the same ground the tier examples do AND draw the lines in the same
 * places. Two ways to get that wrong, and both matter:
 *
 *  - Too narrow, and a reader who runs the questions on a message, a photo or an AI tool
 *    falls through all three and lands on green.
 *  - Too broad, and the question sends them to a colour the list six centimetres further
 *    down puts them in anyway — the page contradicting itself at the only moment it is
 *    being used, which is worse than either half alone.
 *
 * The two lines that are easy to blur, written out because both had been:
 *
 *  - Location. Posting something publicly that shows where you are is yellow: the printed
 *    rule puts public posting in yellow and the fix is a check-in before it goes out.
 *    Telling a person you only know online where you live, go to school or will be is red:
 *    the printed rule puts in-person meetings in red, and page 36 treats handing over that
 *    detail as the first half of one. A question asking "telling somebody where you are"
 *    collapsed the two and made telling your own mother a red decision.
 *  - Money. Small spending is yellow in the printed rule; large payments and financial
 *    products are red. A question asking about "money moving" overruled the yellow example
 *    directly underneath it.
 *
 * `covers` carries the rest of that colour's list, so each question stays short enough to
 * answer in ten seconds and is still exhaustive. The invariant: every yellow and every red
 * example above must appear in a `q` or a `covers`, because anything missing from both
 * falls through to green, and green is the answer with no adult in it.
 */
const DECIDE = [
  {
    q: "Does it involve signing something, a large payment, ID or bank details, travelling, or meeting someone you only know online?",
    covers:
      "Telling someone you only know online where you live, where you go to school or where you will be is the same answer — that is the first half of meeting them. Investing and crypto count at any amount. Signing means a real agreement, including one in somebody else's name; making an ordinary app or game account is question 2, not this one.",
    then: "red" as const,
    say: "Then it is red. Stop and get an adult in it before you do anything else — including replying.",
  },
  {
    q: "Does it involve posting publicly, spending a small amount of your own money, or messaging someone you have never met?",
    covers:
      "It also covers making an account, or turning a private one public. Anything you post that shows where you are, or where you will be. Pasting a real message, offer or somebody's details into an app or an AI tool, the two on this site included. And promising to do something for someone by a date.",
    then: "yellow" as const,
    say: "Then it is yellow. Say it out loud to an adult first. Two minutes, before it happens.",
  },
  {
    q: "Neither of those?",
    then: "green" as const,
    say: "Then it is green. Go and make it.",
  },
];
---

{/* "Race Control" is a term this project coined and nobody types into a search box. The H1
    stays plain, and the title and description are written as the question somebody actually
    asks — do I need to check this with an adult — because the reader who most needs this
    page arrives from a search, not from the menu. No money words: the rule is not one. */}
<Page
  title="Green, yellow, red: when to check with an adult"
  description="Green, yellow or red: work out whether a decision needs an adult first. It covers posting, spending, meeting someone from online, and anything you cannot undo."
  printedPage={FLAG_RULE_PAGE}
>
  <ChapterFurniture
    eyebrow="Race control"
    title="Green, yellow, red"
    subtitle="One rule for anything hard to undo, or that lands on somebody else. Three questions, and the first yes decides it."
  />

  <div class="wrap">
    <div class="prose">
      <p class="lede">
        Brakes are not there to make you go slow. Anyone who races works that out early:
        good brakes are what let you stay flat out for longer, because you know you can
        still make the corner. The kart with no brakes is not the quick one. It is the one
        lifting off early, everywhere, all lap.
      </p>
      {/* Brakes, not a harness — a kart has no belts and this book's author races karts.
          A racing detail he would spot as wrong is not worth the extra word. */}
      <p>
        Green, yellow and red are your brakes. Not a list of things you are banned from —
        the reason you get to build at full speed without ending your own race at the first
        corner that catches you out. And they are yours, not something somebody has on you:
        you are the one who spots the colour, usually with nobody watching.
      </p>
      <p>
        Two things set the colour, and neither of them is money: can you undo it, and does
        it land on anyone but you. That is why the same three colours cover a stranger's
        DM, a photo with your street in it, and anything somebody wants you to sign.
      </p>
      <p class="meta"><PageRef page={FLAG_RULE_PAGE} kind="For Parents & Guardians" /></p>
    </div>
  </div>

  {/* The decision, before the explanation. Someone who arrives here with a message open in
      another tab needs an answer in ten seconds, not a page about safety culture. */}
  <section class="wrap section" aria-labelledby="decide">
    <h2 id="decide">Work out which one it is</h2>
    <ol class="decide">
      {
        DECIDE.map((d, i) => (
          <li class="decide__step">
            <p class="decide__n" aria-hidden="true">{i + 1}</p>
            <div class="decide__body">
              <h3 class="decide__q">{d.q}</h3>
              {d.covers && <p class="decide__covers">{d.covers}</p>}
              <p class="decide__flag"><Flag level={d.then} size="sm" /></p>
              <p class="decide__say">{d.say}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="decide__note">
      Answer them in order and stop at the first yes. The lists under each colour below are
      the long version of these same three questions, so look there if your exact thing is
      not named. If you are still not sure which one something is, treat it as the more
      careful colour — that costs you a conversation, and being wrong the other way costs a
      lot more.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="tiers">
    <h2 id="tiers">What each colour actually means</h2>

    <div class="tiers">
      {
        TIERS.map((t) => (
          <article class={`tier tier--${t.level}`}>
            <div class="tier__head">
              <Flag level={t.level} />
              <h3 class="tier__heading">{t.heading}</h3>
            </div>

            <p class="tier__you">{t.you}</p>

            <p class="tier__like-label">Things that are {t.level}</p>
            <ul class="tier__like">{t.like.map((l) => <li>{l}</li>)}</ul>

            <p class="tier__book">
              <span class="tier__book-label">The book's words</span>
              {t.book}
            </p>
          </article>
        ))
      }
    </div>

    <p class="derived">
      The quoted line under each colour is printed in the book, on page {FLAG_RULE_PAGE}.
      Everything above it is this site putting that rule into the words you would actually
      use — including the examples, which the book does not print. They are deliberately
      not all about money: the printed rule turns on what is hard to undo and who else is
      in it, and the book applies exactly that to AI tools on page {AI_TOOL_PAGE}, to what
      you give away to people you build with online on page {ONLINE_CONTACT_PAGE}, and to
      posting your location on page {LOCATION_PAGE}. If one of them looks wrong to you, the
      printed rule wins.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="rule">
    <h2 id="rule">The one line worth remembering</h2>
    <blockquote class="rule">
      <p>{FAMILY_RULE}</p>
      <footer><PageRef page={FLAG_RULE_PAGE} kind="For Parents & Guardians" /></footer>
    </blockquote>
    <div class="prose">
      <p>
        That second sentence is the useful one. A real offer is still there tomorrow. If
        something cannot survive you sleeping on it and showing one adult, that is not bad
        luck about timing — that is the whole trick, and it is the most common one there is.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="adults">
    <h2 id="adults">“An adult” does not only mean a parent</h2>
    <div class="prose">
      <p>
        A teacher, a coach, a librarian, a youth worker, a school counsellor, an aunt or
        uncle, a brother or sister over 18. It has to be someone who will actually look at
        the thing with you — not the person who is easiest to get a yes from.
      </p>
      <p>
        If there is nobody at home you can ask, that is not a dead end and it does not mean
        you are on your own. <a href="/reality-check">Every Reality Check</a> names who to
        raise that particular thing with, and several of them assume the answer is not a
        parent.
      </p>
      <p class="aside">
        Grown-ups reading over a shoulder: <a href="/parents">Race Control for adults</a> has
        the same rule with the family agreement, what to ask, and what this site does and
        does not do with anything typed into it.
      </p>
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p {
    margin-block-start: 0.9em;
  }

  .lede {
    margin-block-start: 1.75rem;
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    color: var(--text-strong);
  }

  .meta {
    margin-block-start: 0.75rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .section {
    margin-block-start: 3rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  /* --- The three questions ---------------------------------------------------- */

  .decide {
    max-inline-size: var(--container-measure);
    margin-block-start: 1.25rem;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--rule-hairline);
  }

  .decide__step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding-block: 1rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .decide__n {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .decide__q {
    font-size: var(--text-heading);
    line-height: 1.3;
    color: var(--text-strong);
  }

  /* The exhaustive half of the question, set smaller than it so the ten-second reader can
     skip it and the reader whose exact case is not in the question still finds it here. */
  .decide__covers {
    margin-block-start: 0.4rem;
    font-size: var(--text-meta);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .decide__flag {
    margin-block-start: 0.5rem;
  }

  .decide__say {
    margin-block-start: 0.35rem;
  }

  .decide__note {
    max-inline-size: var(--container-measure);
    margin-block-start: 1rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  /* --- The three colours ------------------------------------------------------ */

  .tiers {
    display: grid;
    gap: 1rem;
    margin-block-start: 1.5rem;
  }

  @media (min-width: 56rem) {
    .tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }

  .tier {
    padding: 1rem 1.1rem 1.2rem;
    background: var(--surface-card);
    /* Edge weight AND colour, so the three stay distinguishable on a black-and-white
       photocopy — the way a family will actually put this on a fridge. */
    border-inline-start-style: solid;
  }

  .tier--green {
    border-inline-start: 3px solid var(--flag-green);
  }

  .tier--yellow {
    border-inline-start: 5px dashed var(--flag-yellow);
  }

  .tier--red {
    border-inline-start: 7px double var(--flag-red);
  }

  .tier__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .tier__heading {
    font-size: var(--text-heading);
    line-height: 1.25;
    color: var(--text-strong);
  }

  .tier__you {
    margin-block-start: 0.6rem;
  }

  .tier__like-label {
    margin-block-start: 1rem;
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tier__like {
    margin-block-start: 0.4rem;
    padding-inline-start: 1.1rem;
    font-size: var(--text-meta);
    line-height: 1.6;
  }

  .tier__book {
    margin-block-start: 1rem;
    padding-block-start: 0.8rem;
    border-block-start: 1px solid var(--rule-hairline);
    font-size: var(--text-meta);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .tier__book-label {
    display: block;
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .derived {
    max-inline-size: var(--container-measure);
    margin-block-start: 1.25rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  /* --- The family rule -------------------------------------------------------- */

  .rule {
    max-inline-size: var(--container-measure);
    margin: 1.25rem 0 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--accent-dot);
  }

  .rule p {
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    font-weight: 700;
    color: var(--text-strong);
  }

  .rule footer {
    margin-block-start: 0.5rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .aside {
    margin-block-start: 1.25rem;
    padding-block-start: 1rem;
    border-block-start: 3px solid var(--accent-dot);
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  a {
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  /* A family printing this puts it somewhere visible. Three colours become three edge
     weights and three edge styles on paper, and the cards must not split across a page. */
  @media print {
    .tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .tier {
      background: none;
      break-inside: avoid;
    }

    .decide__step {
      break-inside: avoid;
    }
  }
</style>
