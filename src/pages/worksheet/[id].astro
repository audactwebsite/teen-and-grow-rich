  .ask {
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
    max-inline-size: var(--container-measure);
    border-block-start: 1px solid var(--rule-hairline);
  }

  .ask__heading {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .ask__note,
  .ask__status,
  .ask__nojs {
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .ask__note {
    margin-block-start: 0.6rem;
  }

  /* Body ink, not meta grey: these two are the safety half of the ask, and a reader with
     nobody to send a message to still has to be able to read them out loud. */
  .ask__questions {
    margin: 0.9rem 0 0;
    padding-inline-start: 1.2rem;
    font-size: var(--text-meta);
    color: var(--text-default);
  }

  .ask__questions li + li {
    margin-block-start: 0.45rem;
  }

  .ask__status {
    margin-block-start: 0.75rem;
    /* Reserved, so the first confirmation does not push the page under the thumb. */
    min-block-size: 1.45em;
  }

  .ask__nojs {
    margin-block-start: 1.25rem;
  }

  /* The same gate as .actions__row above: the sentence describing the button, and the
     button's own live region, exist only where the button does. */
  .ask__note--js,
  .ask__status {
    display: none;
  }

  :global(:root[data-js]) .ask__note--js,
  :global(:root[data-js]) .ask__status {
    display: block;
  }

  :global(:root[data-js]) .ask__nojs {
    display: none;
  }

  /* --- Print: the sheet becomes the book page ------------------------------ */

  @media print {
    /* The global print stylesheet flips :root to the book's light tokens but leaves the
       three box tokens on their dark values, so a Reality Check printed from dark mode
       would come out dark-on-dark. Fixed locally; global.css needs the same block.  */
    :global(:root) {
      --box-hill-fill: var(--color-tgr-tint-mint);
      --box-hill-edge: var(--color-tgr-teal);
      --box-build-fill: var(--color-tgr-tint-cream);
      --box-build-edge: var(--color-tgr-orange);
      --box-check-fill: var(--color-tgr-tint-blue);
      --box-check-edge: var(--color-tgr-navy);
    }

    /* SiteHeader is a <header>, so the global "hide nav and footer" rule misses it. */
    :global(.site-header) {
      display: none !important;
    }

    .band,
    .sheet__seed,
    .bars__empty {
      display: none;
    }

    .sheet {
      /* Explicit millimetres. @page size is Safari 18.2+, so it cannot be the mechanism. */
      inline-size: 190mm;
      max-inline-size: 190mm;
      padding: 0;
      margin-inline: auto;
    }

    .sheet__running {
      display: flex;
      justify-content: space-between;
      padding-block-end: 3mm;
      margin-block-end: 6mm;
      font-size: 8pt;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      border-block-end: 0.5pt solid var(--rule-hairline);
    }

    .sheet__folio {
      display: block;
      margin-block-start: 8mm;
      font-size: 9pt;
      text-align: center;
      color: var(--text-muted);
    }

    .fields {
      max-inline-size: none;
      border-block-start: 0.5pt solid var(--rule-hairline);
    }

    .field {
      display: grid;
      grid-template-columns: 55mm 1fr;
      break-inside: avoid;
      border-block-end: 0.5pt solid var(--rule-hairline);
    }

    .field__ask {
      background: var(--box-hill-fill);
      border-inline-end: 0.5pt solid var(--rule-hairline);
      print-color-adjust: exact;
    }

    .field__flag {
      /* The flag's own print rule already drops the label to book ink. */
      margin-block-start: 0.3rem;
    }

    .field__answer {
      background: transparent;
    }

    /* With scripting the answer prints as text, because a textarea clips its overflow on
       paper. Without it, the control itself prints and is written on by hand. */
    :global(:root[data-js]) .field__input {
      display: none;
    }

    :global(:root[data-js]) .field__printed {
      display: block;
      min-block-size: 9mm;
      border-block-end: 0.5pt solid var(--rule-hairline);
    }

    /* On paper the six sliders are unusable and the bar visual already carries the label,
       the bar and the number, so the sliders go and the bars stay. */
    .scores {
      display: none;
    }

    .bars {
      margin-block-start: 0;
      max-inline-size: none;
      break-inside: avoid;
    }

    /* The six routes are worth having on paper: all three parts of a row — the area, the
       chapter that answers it and the build to do about it — are references to the
       printed book, so they stay usable without an address. A marked row keeps its spine
       and its word; on a mono photocopier the word is the one that arrives. */
    .routes {
      margin-block-start: 8mm;
      max-inline-size: none;
    }

    .route {
      break-inside: avoid;
      border-block-end: 0.5pt solid var(--rule-hairline);
    }

    .route[data-route-lowest] {
      print-color-adjust: exact;
    }
  }
</style>
