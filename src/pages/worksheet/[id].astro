---
/**
 * The book's four worksheets, completable on a phone.
 *
 * Layout follows design-system §5: a worksheet table inverts the book's normal table, so
 * from 768px this is a tinted label column on the left and a plain input column on the
 * right. Below that it stacks — a two-column form at 390px is a form nobody finishes.
 *
 * Answers are kept in this browser only, written on blur through storage.ts. Never
 * "saved" (D24). Copy-as-text is the durable output and is offered first; print is the
 * second, because print is an output and never a requirement (D25).
 *
 * The Real Rich Scoreboard is the one worksheet with a different control: six 1–10
 * sliders and one bar visual. There is no total, no average and no grade — the book's
 * instruction is "choose one action for the lowest area", so the only derived fact the
 * page states is which area is lowest, and AREA_CHAPTER below says where to go for it.
 *
 * The other three sheets can also write the reader's ask to their safe witness, out of
 * what they have already typed. See ASK.
 */
import Page from "../../layouts/Page.astro";
import ChapterFurniture from "../../components/ChapterFurniture.astro";
import PageRef from "../../components/PageRef.astro";
import Box from "../../components/Box.astro";
import Flag from "../../components/Flag.astro";
import {
  allBuilds,
  allChapters,
  allWorksheets,
  allRealityChecks,
  allOffers,
} from "../../lib/content";
import type { Worksheet } from "../../lib/content";
import { metaFor } from "../reality-check/_checks";

export async function getStaticPaths() {
  const worksheets = await allWorksheets();
  return worksheets.map((worksheet) => ({ params: { id: worksheet.id }, props: { worksheet } }));
}

type Props = { worksheet: Worksheet };

const { worksheet } = Astro.props;
const w = worksheet.data;
const isScoreboard = worksheet.id === "real-rich-scoreboard";

/**
 * Which fields carry a flag, and at what level (D12: every worksheet field touching
 * money, people or data carries one).
 *
 * The level is read off the book's own hint, never invented. Red where the hint itself
 * requires a parent or guardian; yellow where the field commits the reader to other
 * people or to a public boundary; green where it is safe to do alone — so that no field
 * is a dead end for a reader with nobody to ask (D25).
 */
const FIELD_FLAGS: Record<string, "green" | "yellow" | "red"> = {
  "starting-point:my-safe-witness": "green",
  "first-offer-canvas:who-i-help": "green",
  "first-offer-canvas:the-starter-price": "red",
  "first-offer-canvas:the-safe-contact-route": "red",
  "first-offer-canvas:the-stop-rules": "yellow",
  "real-rich-plan:my-safe-witness": "green",
  "real-rich-plan:my-first-offer": "yellow",
  "real-rich-plan:my-money-split": "yellow",
  "real-rich-plan:my-stop-rules": "yellow",
};

/**
 * The six Real Rich areas, and the chapter that answers each one.
 *
 * The scoreboard has always named the reader's lowest area and then stopped, which is
 * half of the book's own instruction — "choose one action for the lowest area" — with the
 * action missing. The action is already written: it is that chapter's 24-Hour Build.
 *
 * Only the chapter number lives here. The title and the build number are read from the
 * collections below, so a second edition that renumbers the builds cannot leave this
 * pointing at the wrong one, and no book wording is retyped into this file.
 *
 * Two of the six are judgement calls worth stating. Health goes to chapter 8, not to
 * chapter 14: 8 is where the book separates rest from quitting and where the Reality
 * Check names sleep, burnout and telling an adult. Time goes to chapter 6, because the
 * scoreboard's "time" is the currency in chapter 15's own list — hours you get to decide
 * about — and 6 is the chapter that hands the reader a week.
 */
const AREA_CHAPTER: Record<string, number> = {
  skills: 4,
  health: 8,
  time: 6,
  people: 9,
  money: 11,
  impact: 15,
};

/**
 * The message a reader sends to their safe witness.
 *
 * The book puts a safe witness in front of the reader on eight printed pages and tells
 * them to involve an adult on twenty-five, but on this site the witness was only ever a
 * field to fill in. Nothing helped anyone actually ask. This composes the ask out of what
 * the reader has already typed: written in the browser, copied by the reader, sent by the
 * reader, in whatever app they already use. No address is collected, nothing is stored and
 * nothing leaves the device — which is the only version of this feature allowed to exist.
 *
 * `lines` is [field id, how the line starts]. The ids are checked against the worksheet
 * below and throw if one is ever renamed, so the message cannot quietly go short.
 *
 * `questions` is rendered on the page as well as into the message. It is the safety half
 * of the ask, and a reader with no scripting still has to be able to read it and say it
 * out loud.
 *
 * The scoreboard has no entry. Its six controls produce numbers, not sentences, and a
 * message that is only somebody's scores is not an ask — the route out of that sheet is
 * AREA_CHAPTER above.
 */
type Ask = { opening: string; lines: [string, string][]; questions: string[] };

/* Two of the three sheets close on the same pair: show me the work, and come to me before
   money, accounts, posting or strangers. That pair is the whole point, so it is written
   once and cannot drift between sheets. */
const WEEKLY_ASK = [
  "Can I show you what I have made once a week, even the bad versions?",
  "Can I check with you first if any of it involves money, an account, posting in public, or someone I only know online?",
];

const ASK: Record<string, Ask> = {
  "starting-point": {
    opening:
      "I am starting something out of a book called Teen & Grow Rich, and you are the person I want to tell about it.",
    lines: [
      ["the-dream-that-keeps-returning", "The thing I keep coming back to"],
      ["one-skill-i-want-to-build", "The skill I want to build"],
      ["one-problem-i-care-about", "The problem I care about"],
      ["my-30-day-proof", "What I want to have finished in 30 days"],
      ["start-date", "The day I start"],
    ],
    questions: WEEKLY_ASK,
  },
  /* This sheet asks for more than a weekly look, because the book asks for more: two of
     its fields are red-flagged and the hint on the price says "set with a parent or
     guardian". So the ask is to do those two together, not to be told about them after. */
  "first-offer-canvas": {
    opening:
      "I am working out my first offer — the first thing I would do for someone else for money. It is from a book called Teen & Grow Rich, and the book is clear that I do not set the price on my own.",
    lines: [
      ["who-i-help", "Who I would help"],
      ["the-problem", "What is wrong for them right now"],
      ["the-result", "What is different when I am done"],
      ["the-deliverable", "What they actually get"],
      ["the-deadline", "When it would be finished"],
      ["the-starter-price", "What I was thinking of charging"],
      ["the-proof", "What I can already show them"],
      ["the-safe-contact-route", "How they would reach me"],
      ["the-stop-rules", "When I stop or walk away"],
    ],
    questions: [
      "Can we set the price and the way people reach me together, before I tell anyone this exists?",
      "Can I come to you first if this needs an account, a contract, or meeting someone I only know online?",
    ],
  },
  "real-rich-plan": {
    opening:
      "I have written a 90-day plan out of a book called Teen & Grow Rich. This is all of it, and you are the person I want to check it.",
    lines: [
      ["my-90-day-goal", "What I want to be true in 90 days"],
      ["the-skill-i-am-building", "The skill I am building"],
      ["the-problem-i-solve", "The problem I solve, and who for"],
      ["my-three-proof-projects", "The three things I will make as proof"],
      ["my-weekly-build-blocks", "When the work actually happens"],
      ["my-first-offer", "My first offer"],
      ["my-money-split", "How I would split any money that comes in"],
      ["my-stop-rules", "What makes me stop"],
      ["my-real-rich-scoreboard", "Where I am across the six areas"],
    ],
    questions: WEEKLY_ASK,
  },
};

const ask = ASK[worksheet.id];

/* Two fields are a name and a date. Every other field in the book's worksheets is a
   sentence or more, where a textarea that grows is the phone-friendly default. */
const SINGLE_LINE = new Set(["my-name", "start-date"]);

/* Reality Checks are matched on the printed page they share with the worksheet, which is
   the same fact /p/[n] routing runs on. It renders in full, always visible, never behind
   anything.

   Plus one explicit attachment: the First Offer Canvas is on page 58 and the check that
   defines what makes a first offer safe is on page 57, so page equality alone leaves the
   one worksheet with two red-flagged fields — the starter price and the safe contact
   route — carrying no check at all. */
const EXTRA_CHECKS: Record<string, string[]> = {
  "first-offer-canvas": ["seven-safe-offers"],
};

const allChecks = await allRealityChecks();
const extraIds = EXTRA_CHECKS[worksheet.id] ?? [];
const checks = allChecks.filter(
  (c) => c.data.printedPage === w.printedPage || extraIds.includes(c.id),
);

for (const id of extraIds) {
  if (!allChecks.some((c) => c.id === id)) {
    throw new Error(
      `Worksheet "${worksheet.id}" requires Reality Check "${id}", which is not in ` +
        "reality-checks.yaml. A required safety element must fail the build, never vanish.",
    );
  }
}

/* Same rule for the safe-witness message: a line that silently disappears because a field
   was renamed is worse than a build that fails, because nobody would notice. */
if (ask) {
  const known = new Set(w.fields.map((f) => f.id));
  for (const [id] of ask.lines) {
    if (!known.has(id)) {
      throw new Error(
        `The safe-witness message for "${worksheet.id}" names field "${id}", which is not ` +
          "on that worksheet. Point it at a field that exists, or the message quietly " +
          "drops a line the reader typed.",
      );
    }
  }
}

/**
 * The scoreboard's six routes, resolved once at build time.
 *
 * Throws rather than dropping a row: an area that is named as the reader's weakest and
 * then offers nowhere to go is exactly the dead end AREA_CHAPTER exists to close.
 */
type Route = { area: string; label: string; chapter: string; title: string; build: string };

let routes: Route[] = [];

if (isScoreboard) {
  const chapters = await allChapters();
  const builds = await allBuilds();
  const pad = (n: number) => String(n).padStart(2, "0");

  routes = w.fields.map((f) => {
    const n = AREA_CHAPTER[f.id];
    const chapter = chapters.find((c) => c.data.n === n);
    const build = builds.find((b) => b.data.chapter === n);
    if (!chapter || !build) {
      throw new Error(
        `Real Rich area "${f.id}" has no chapter and 24-Hour Build to route to. Every ` +
          "area on the scoreboard needs one — the book's instruction is to choose an " +
          "action for the lowest area, and this is where that action is written down.",
      );
    }
    return {
      area: f.id,
      label: f.label,
      chapter: pad(chapter.data.n),
      title: chapter.data.title,
      build: pad(build.data.n),
    };
  });
}

/**
 * The First Offer Canvas can arrive pre-filled from /offers via ?from=<offer-id>. Only
 * the two fields the book's own offers table actually answers are seeded — the
 * deliverable and the first proof. Nothing else is guessed on the reader's behalf.
 *
 * Carried in a data attribute rather than an inline JSON script so it stays outside the
 * CSP script-src surface entirely.
 */
const prefill =
  worksheet.id === "first-offer-canvas"
    ? JSON.stringify(
        Object.fromEntries(
          (await allOffers()).map((o) => [
            o.id,
            {
              offer: o.data.offer,
              fields: {
                "the-deliverable": o.data.deliverable,
                "the-proof": o.data.firstProof,
              },
            },
          ]),
        ),
      )
    : undefined;
---

<Page title={w.title} description={w.subtitle} printedPage={w.printedPage}>
  <ChapterFurniture eyebrow="Worksheet" title={w.title} subtitle={w.subtitle} />

  <div class="band">
    <div class="band__inner">
      <PageRef page={w.printedPage} kind="Worksheet" />
      <p class="band__count">
        {w.fields.length}
        {isScoreboard ? " areas" : " fields"}
      </p>
    </div>
  </div>

  <div
    class="sheet print-sheet"
    data-worksheet={worksheet.id}
    data-title={w.title}
    data-page={String(w.printedPage)}
    data-prefill={prefill}
  >
    {/* Print only: the book's running header, so a printed sheet reads as a book page. */}
    <div class="sheet__running" aria-hidden="true">
      <span>Teen &amp; Grow Rich</span>
      <span>Skills. Freedom. Money. Meaning.</span>
    </div>

    {/* No heading here: ChapterFurniture already prints the title and the subtitle at the
        top of the page, and restating both 200px below themselves reads as a bug. The
        print-only running head and folio below carry the sheet's identity on paper. */}
    <p class="sheet__seed" data-seed hidden></p>

    {
      isScoreboard ? (
        <>
          <ol class="scores">
            {w.fields.map((f) => (
              <li class="score" data-score-row={f.id}>
                <label class="score__label" for={`f-${f.id}`}>
                  {f.label}
                </label>
                <div class="score__controls">
                  <button
                    type="button"
                    class="score__step"
                    data-score-step="-1"
                    data-score-for={f.id}
                    aria-label={`Lower ${f.label} by one`}
                  >
                    −
                  </button>
                  <input
                    type="range"
                    id={`f-${f.id}`}
                    class="score__range"
                    min="1"
                    max="10"
                    step="1"
                    value="5"
                    aria-valuetext="Not scored yet"
                    aria-describedby={`h-${f.id}`}
                    data-score={f.id}
                    data-label={f.label}
                  />
                  <button
                    type="button"
                    class="score__step"
                    data-score-step="1"
                    data-score-for={f.id}
                    aria-label={`Raise ${f.label} by one`}
                  >
                    +
                  </button>
                  <output class="score__out" for={`f-${f.id}`} data-score-out={f.id}>
                    —
                  </output>
                </div>
                <p class="score__hint" id={`h-${f.id}`}>
                  {f.hint}
                </p>
              </li>
            ))}
          </ol>

          {/* One honest bar visual: six bars, drawn from the six numbers, nothing more.
              No radar, no animation, no total, no grade. */}
          <section class="bars" aria-label="Your six areas as bars">
            <h3 class="bars__heading">Your six areas</h3>
            <p class="bars__empty" data-bars-empty>
              Move a slider and its bar appears here.
            </p>
            <ol class="bars__list">
              {w.fields.map((f) => (
                <li class="bars__row" data-bar-row={f.id}>
                  <span class="bars__label">{f.label}</span>
                  <span class="bars__track">
                    <span class="bars__fill" data-bar={f.id} />
                  </span>
                  <span class="bars__n" data-bar-n={f.id}>
                    —
                  </span>
                </li>
              ))}
            </ol>
            <p class="bars__lowest" role="status" data-lowest></p>
          </section>

          {/* Where to go for it. All six are listed and always visible, for two reasons:
              without scripting nothing computes a lowest area, and knowing which chapter
              owns which area is worth having on its own. The script only marks the row.

              Every row therefore ships the word "Lowest" and CSS hides it until the row
              is marked. Without that rule all six rows announce themselves as the lowest,
              which is the opposite of the one fact this section exists to state. */}
          <section class="routes" aria-labelledby="routes-h">
            <h3 class="routes__heading" id="routes-h">
              Where the book answers each area
            </h3>
            <p class="routes__note">
              Whichever one comes out lowest, that is the row to open. The build under it is
              the one thing to do about it.
            </p>
            <ol class="routes__list">
              {routes.map((r) => (
                <li class="route" data-route={r.area} data-route-label={r.label}>
                  <p class="route__area">
                    {r.label}
                    <span class="route__tag">Lowest</span>
                  </p>
                  <p class="route__where">
                    <a href={`/c/${r.chapter}`} data-tap>
                      Chapter {r.chapter} · {r.title}
                    </a>
                    <a href={`/build/${r.build}`} data-tap>
                      24-Hour Build {r.build}
                    </a>
                  </p>
                </li>
              ))}
            </ol>
          </section>
        </>
      ) : (
        <ol class="fields">
          {w.fields.map((f) => {
            const level = FIELD_FLAGS[`${worksheet.id}:${f.id}`];
            const describedBy = [f.hint ? `h-${f.id}` : "", level ? `g-${f.id}` : ""]
              .filter(Boolean)
              .join(" ");
            return (
              <li class="field">
                <div class="field__ask">
                  <label class="field__label" for={`f-${f.id}`}>
                    {f.label}
                  </label>
                  {f.hint && (
                    <p class="field__hint" id={`h-${f.id}`}>
                      {f.hint}
                    </p>
                  )}
                  {level && (
                    <p class="field__flag" id={`g-${f.id}`}>
                      <Flag level={level} size="sm" />
                    </p>
                  )}
                </div>

                <div class="field__answer">
                  {SINGLE_LINE.has(f.id) ? (
                    <input
                      type="text"
                      id={`f-${f.id}`}
                      class="field__input"
                      autocomplete="off"
                      aria-describedby={describedBy || undefined}
                      data-field={f.id}
                      data-label={f.label}
                    />
                  ) : (
                    <textarea
                      id={`f-${f.id}`}
                      class="field__input field__input--area"
                      rows="2"
                      aria-describedby={describedBy || undefined}
                      data-field={f.id}
                      data-label={f.label}
                    />
                  )}
                  {/* Printed instead of the control: a textarea clips its own overflow on
                      paper. Empty, it leaves a ruled line to write on by hand. */}
                  <p class="field__printed" data-printed={f.id} />
                </div>
              </li>
            );
          })}
        </ol>
      )
    }

    <p class="sheet__folio" aria-hidden="true">Book page {w.printedPage}</p>
  </div>

  {
    checks.length > 0 && (
      <div class="wrap wrap--prose">
        {checks.map((c) => (
          <Box kind="check" class="check">
            {/* Every Reality Check carries its own flag, on every surface that shows one
                (D12). Without it a reader meets a risk paragraph with no risk level. */}
            {metaFor(c.id) && (
              <p class="check__flag">
                <Flag level={metaFor(c.id)!.flag} size="sm" />
              </p>
            )}
            <p>{c.data.text}</p>
            <p class="check__ref">
              <PageRef page={c.data.printedPage} />
            </p>
          </Box>
        ))}
      </div>
    )
  }

  {/* Primary actions last, so on a phone they land under the thumb after the reader has
      scrolled through the sheet. */}
  <div class="wrap actions" data-print="hide">
    <h2 class="actions__heading">Get this off the device</h2>
    <p class="actions__note" data-keep-note>
      Answers are kept in this browser, never sent anywhere. A browser is not a safe
      place to leave work — copy it out or print it.
    </p>

    <div class="actions__row">
      <button type="button" class="btn btn--primary" data-copy>Copy my answers as text</button>
      <button type="button" class="btn" data-print-btn>Print this worksheet</button>
    </div>

    <p class="actions__status" role="status" data-status></p>

    {
      ask && (
        /* Nothing is sent from here. The message is composed in the browser out of what
           is already on this page, and the reader is the one who sends it — so no
           address is ever collected and the site never learns who this person is.
           The questions render server-side because they are the safety half of the ask:
           without scripting the button is hidden, and they are still readable. */
        <div class="ask" data-ask={JSON.stringify(ask)}>
          <h3 class="ask__heading">Ask your safe witness</h3>
          <p class="ask__note">
            A parent, a teacher, a coach, a librarian, a youth worker or a sibling over 18
            — the one you would actually tell the truth to.
          </p>
          {/* Gated on scripting, exactly like the button it describes. A page that
              explains a control the reader cannot see is the same defect as a control
              that does nothing. */}
          <p class="ask__note ask__note--js">
            This writes the message out of what you typed above. It does not send it, and it
            never asks who they are — you copy the text and send it yourself, in whatever app
            you already use.
          </p>
          <p class="ask__note">However you send it, end with these two questions.</p>
          <ol class="ask__questions">
            {ask.questions.map((q) => (
              <li>{q}</li>
            ))}
          </ol>

          <div class="actions__row">
            <button type="button" class="btn" data-ask-copy>
              Copy the message
            </button>
          </div>

          <p class="ask__status" role="status" data-ask-status />

          <p class="ask__nojs">
            Nothing writes this for you without JavaScript, and nothing here is locked: the
            message is what you have typed above, plus those two questions. Copying it out by
            hand takes a minute.
          </p>
        </div>
      )
    }

    <label class="actions__fallback" data-fallback hidden>
      <span>Copying did not work in this browser. Select all of this and copy it.</span>
      <textarea readonly rows="8" data-fallback-text></textarea>
    </label>

    {/* Only about the two buttons above it now. The safe-witness block carries its own
        no-JS line, next to the thing it is about (WCAG 2.2 3.2.6 Consistent Help). */}
    <p class="actions__nojs">
      Without JavaScript this worksheet still prints and still fills in by hand. Nothing
      here is locked.
    </p>
  </div>
</Page>

<script>
  /* Imported here rather than in the frontmatter: this is a bundled client script,
     and a frontmatter import is not in its scope — the value would be undefined in
     the browser, on the line that writes the site's own address onto the copy a
     reader keeps. */
  import { SITE_HOST } from "../../lib/site";
  import { record, state, canKeep } from "../../lib/storage";

  const sheet = document.querySelector<HTMLElement>("[data-worksheet]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  if (sheet) {
    const wsId = sheet.dataset.worksheet ?? "";
    const kept = state();

    /* Two buttons now write here, so the target is a parameter. Both live regions sit
       directly under the button that fills them; a confirmation a phone has scrolled off
       the screen is not a confirmation. */
    const say = (message: string, into: HTMLElement | null = status) => {
      if (into) into.textContent = message;
    };

    /* --- Text fields ------------------------------------------------------- */

    type Field = HTMLInputElement | HTMLTextAreaElement;
    const fields = [...sheet.querySelectorAll<Field>("[data-field]")];

    const mirror = (el: Field) => {
      const out = sheet.querySelector<HTMLElement>(`[data-printed="${el.dataset.field}"]`);
      if (out) out.textContent = el.value;
    };

    const grow = (el: Field) => {
      if (!(el instanceof HTMLTextAreaElement)) return;
      el.style.height = "auto";
      el.style.height = `${el.scrollHeight}px`;
    };

    /* Last value written per field. The log is append-only, so writing an unchanged field
       on every focusout would fill it with duplicates of the same fact. */
    const written = new Map<string, string>();

    for (const el of fields) {
      const id = el.dataset.field ?? "";
      const v = kept.get(`field:${wsId}:${id}`);
      if (typeof v === "string") {
        el.value = v;
        written.set(id, v);
      }
      mirror(el);
      grow(el);
    }

    /* Seeded from /offers. Applied only to fields the reader has not already filled, and
       deliberately NOT written to storage: a page load is not a user gesture, and
       persisting one would break the ePrivacy 5(3) exemption (D23). It is kept the first
       time the reader leaves the field, like anything else they type. */
    const from = new URLSearchParams(window.location.search).get("from");
    if (from && sheet.dataset.prefill) {
      try {
        const table = JSON.parse(sheet.dataset.prefill) as Record<
          string,
          { offer: string; fields: Record<string, string> }
        >;
        const seed = table[from];
        if (seed) {
          let used = 0;
          for (const el of fields) {
            const text = seed.fields[el.dataset.field ?? ""];
            if (!text || el.value.trim()) continue;
            el.value = text;
            mirror(el);
            grow(el);
            used += 1;
          }
          const banner = sheet.querySelector<HTMLElement>("[data-seed]");
          if (banner && used > 0) {
            banner.textContent = `Started from the Seven Safe First Offers: ${seed.offer}. Change anything. Nothing is kept until you leave a field.`;
            banner.hidden = false;
          }
        }
      } catch {
        /* A hand-edited query string is not an error worth showing a 13-year-old. */
      }
    }

    sheet.addEventListener("input", (event) => {
      const el = (event.target as HTMLElement | null)?.closest<Field>("[data-field]");
      if (!el) return;
      mirror(el);
      grow(el);
    });

    /* focusout, not blur: blur does not bubble, and one listener for nine fields is the
       whole reason this page ships no framework. */
    sheet.addEventListener("focusout", (event) => {
      const el = (event.target as HTMLElement | null)?.closest<Field>("[data-field]");
      if (!el) return;
      const id = el.dataset.field ?? "";
      const value = el.value.trim();
      if (written.get(id) === value) return;
      written.set(id, value);
      record("field", `${wsId}:${id}`, value);
    });

    /* --- Scoreboard sliders ------------------------------------------------ */

    const ranges = [...sheet.querySelectorAll<HTMLInputElement>("[data-score]")];
    const lowest = sheet.querySelector<HTMLElement>("[data-lowest]");
    const barsEmpty = sheet.querySelector<HTMLElement>("[data-bars-empty]");
    const routeRows = [...sheet.querySelectorAll<HTMLElement>("[data-route]")];

    const scored = new Map<string, number>();

    const paintScore = (id: string, value: number) => {
      const out = sheet.querySelector<HTMLElement>(`[data-score-out="${id}"]`);
      const fill = sheet.querySelector<HTMLElement>(`[data-bar="${id}"]`);
      const n = sheet.querySelector<HTMLElement>(`[data-bar-n="${id}"]`);
      if (out) out.textContent = `${value} / 10`;
      if (fill) fill.style.inlineSize = `${value * 10}%`;
      if (n) n.textContent = String(value);
      sheet.querySelector(`[data-score-row="${id}"]`)?.setAttribute("data-scored", "yes");
      sheet.querySelector(`[data-bar-row="${id}"]`)?.setAttribute("data-scored", "yes");
    };

    /* Named, never totalled. A total would be a grade, and the book's instruction is to
       pick one action for the lowest area — so the lowest area is the only thing derived. */
    const paintLowest = () => {
      if (!lowest) return;
      if (scored.size < ranges.length) {
        lowest.textContent = "";
        for (const row of routeRows) row.removeAttribute("data-route-lowest");
        return;
      }
      let min = 11;
      for (const v of scored.values()) min = Math.min(min, v);
      const low = ranges.filter((r) => scored.get(r.dataset.score ?? "") === min);
      const names = low.map((r) => r.dataset.label ?? "");
      lowest.textContent = `Lowest right now: ${names.join(", ")}. Choose one action for it.`;

      /* "Choose one action for it" used to end there, with no route. The six routes are
         already on the page; this marks the one being pointed at. The sentence above is
         left alone deliberately — it is a live region, and links announced inside one are
         noise. Ties mark every row that ties, the same way the sentence names them all. */
      const ids = new Set(low.map((r) => r.dataset.score ?? ""));
      for (const row of routeRows) {
        row.toggleAttribute("data-route-lowest", ids.has(row.dataset.route ?? ""));
      }
    };

    for (const range of ranges) {
      const id = range.dataset.score ?? "";
      const v = kept.get(`score:${wsId}:${id}`);
      if (typeof v === "number") {
        range.value = String(v);
        range.setAttribute("aria-valuetext", `${v} out of 10`);
        scored.set(id, v);
        paintScore(id, v);
      }
    }
    if (scored.size > 0 && barsEmpty) barsEmpty.hidden = true;
    paintLowest();

    /* Showing and keeping are deliberately separate.

       One thumb drag across a slider fires dozens of `input` events, and record() appends
       one entry per call to a log that storage.ts caps at MAX_EVENTS and then trims from
       the OLDEST end. Recording on `input` therefore lets a few seconds of sliding evict
       a reader's real build ticks and written answers — on a phone, which is where the
       sliding happens. So `input` only paints; `change` (once, when the drag or the arrow
       key settles) is what gets kept. */
    const showScore = (range: HTMLInputElement) => {
      const id = range.dataset.score ?? "";
      const value = Number(range.value);
      range.setAttribute("aria-valuetext", `${value} out of 10`);
      scored.set(id, value);
      paintScore(id, value);
      if (barsEmpty) barsEmpty.hidden = true;
      paintLowest();
    };

    /** Last value written per area, so re-touching a slider at the same number is free. */
    const keptScores = new Map<string, number>();
    for (const [id, v] of scored) keptScores.set(id, v);

    const keepScore = (range: HTMLInputElement) => {
      showScore(range);
      const id = range.dataset.score ?? "";
      const value = Number(range.value);
      if (keptScores.get(id) === value) return;
      keptScores.set(id, value);
      record("score", `${wsId}:${id}`, value);
    };

    sheet.addEventListener("input", (event) => {
      const range = (event.target as HTMLElement | null)?.closest<HTMLInputElement>("[data-score]");
      if (range) showScore(range);
    });

    sheet.addEventListener("change", (event) => {
      const range = (event.target as HTMLElement | null)?.closest<HTMLInputElement>("[data-score]");
      if (range) keepScore(range);
    });

    /* WCAG 2.2 §2.5.7: dragging a slider must not be the only way to set it. Arrow keys
       already satisfy that for a keyboard; these two buttons satisfy it for a thumb. */
    sheet.addEventListener("click", (event) => {
      const step = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
        "[data-score-step]",
      );
      if (!step) return;
      const range = sheet.querySelector<HTMLInputElement>(`[data-score="${step.dataset.scoreFor}"]`);
      if (!range) return;
      const next = Math.min(10, Math.max(1, Number(range.value) + Number(step.dataset.scoreStep)));
      range.value = String(next);
      /* Setting .value from script fires neither `input` nor `change`, so the button path
         has to keep the value itself. One press is one deliberate step, so it is safe to
         record immediately. */
      keepScore(range);
    });

    /* --- Getting the work off the device ----------------------------------- */

    const asText = (): string => {
      const lines = [
        sheet.dataset.title ?? "",
        `Teen & Grow Rich — book page ${sheet.dataset.page}`,
        "",
      ];
      for (const el of sheet.querySelectorAll<Field | HTMLInputElement>("[data-field], [data-score]")) {
        const label = el.dataset.label ?? "";
        if (el.dataset.score) {
          const v = scored.get(el.dataset.score);
          lines.push(`${label}: ${v === undefined ? "not scored yet" : `${v} / 10`}`);
        } else {
          lines.push(label, el.value.trim() || "—", "");
        }
      }
      if (lowest?.textContent) lines.push("", lowest.textContent);
      lines.push("", `Copied from ${SITE_HOST}. This text is the copy that lasts.`);
      return lines.join("\n");
    };

    /* Two buttons copy now, so the clipboard call and its fallback are written once. The
       fallback textarea is shared: whichever button was pressed, its text is the one
       sitting in it, and the label above it says the same thing either way. */
    const copyOut = async (text: string, ok: string, into: HTMLElement | null) => {
      try {
        await navigator.clipboard.writeText(text);
        say(ok, into);
      } catch {
        const box = document.querySelector<HTMLElement>("[data-fallback]");
        const area = document.querySelector<HTMLTextAreaElement>("[data-fallback-text]");
        if (box && area) {
          area.value = text;
          box.hidden = false;
          area.focus();
          area.select();
        }
        say("This browser blocked the clipboard, so the text is below instead.", into);
      }
    };

    document.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", () => {
      void copyOut(asText(), "Copied. Paste it into your notes, or send it to yourself.", status);
    });

    document
      .querySelector<HTMLButtonElement>("[data-print-btn]")
      ?.addEventListener("click", () => window.print());

    /* --- The ask to a safe witness ----------------------------------------- */

    /* The message is composed here and nowhere else: built in the browser out of the
       fields already on this page, handed to the reader, sent by the reader. record() is
       deliberately never called in this block — no address is asked for and the ask is
       not a receipt, so there is nothing here to keep. */
    type Ask = { opening: string; lines: [string, string][]; questions: string[] };

    const askBox = document.querySelector<HTMLElement>("[data-ask]");
    const askBtn = document.querySelector<HTMLButtonElement>("[data-ask-copy]");
    const askStatus = document.querySelector<HTMLElement>("[data-ask-status]");

    const readAsk = (el: HTMLElement): Ask | null => {
      try {
        return JSON.parse(el.dataset.ask ?? "") as Ask;
      } catch {
        return null;
      }
    };

    const askSpec = askBox ? readAsk(askBox) : null;

    if (askBtn && askSpec) {
      const askText = () => {
        const said: string[] = [];
        for (const [id, opener] of askSpec.lines) {
          const el = sheet.querySelector<Field>(`[data-field="${id}"]`);
          /* .value, not the kept copy: a reader who types and presses the button without
             leaving the field has not written anything to storage yet, and the message
             has to say what is on the screen. */
          const value = el?.value.trim();
          /* An empty field is left out rather than sent as a dash. "The skill I want to
             build: —" looks like an answer, and it is not one. */
          if (value) said.push(`${opener}: ${value}`);
        }

        const lines = [askSpec.opening, ""];
        if (said.length > 0) lines.push(...said, "");
        lines.push(...askSpec.questions, "");
        lines.push(
          `This is from Teen & Grow Rich, book page ${sheet.dataset.page}. ` +
            `The worksheet is at ${SITE_HOST}.`,
        );
        return { text: lines.join("\n"), filled: said.length };
      };

      askBtn.addEventListener("click", () => {
        const { text, filled } = askText();
        void copyOut(
          text,
          filled === 0
            ? "Copied — but nothing above is filled in yet, so it is only the two questions."
            : "Copied. Paste it into a message and send it to them yourself.",
          askStatus,
        );
      });
    } else if (askBtn) {
      /* data-ask did not parse, so there is no message to compose. The button goes rather
         than sitting there focusable and doing nothing; .remove() rather than hidden,
         because .btn sets its own display and would beat [hidden]. The questions above it
         stay — they are readable and sayable on their own. */
      askBtn.remove();
    }

    const note = document.querySelector<HTMLElement>("[data-keep-note]");
    if (note && !canKeep()) {
      note.textContent =
        "This browser is not keeping anything, so these answers go when you leave the page. Copy them out or print them now.";
    }
  }
</script>

