---
/**
 * The book page (docs/decisions.md D3, D4, D31).
 *
 * D31 is the whole brief: an impressive site selling a 64-page book invites the review
 * that kills a debut — "this could have been a blog post". So this page states the
 * physical truth first, in the book's own anti-hype register, including the parts that
 * argue against buying. No income figures, no urgency, no countdown, no testimonials.
 *
 * Counts come from the content collections rather than from prose, so they cannot drift
 * away from what the site actually contains.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";
import PageRef from "../components/PageRef.astro";
import { Image } from "astro:assets";
/**
 * The composed cover, with its type layer — design-system.md §7 nominates this file for
 * /get. assets/from-book/front-cover.jpeg is the PDF image extraction, which is the
 * background photograph only: the title is vector text and never came out with it.
 */
import cover from "../assets/photos/book-cover.jpg";
import { allSequences, totals } from "../lib/content";
import { book, jsonLd } from "../lib/schema";

const t = await totals();

/* The 90-day path's own shape, folded from the collection rather than typed into the
   prose below it — page 63 promised a 90-day plan, so the row that answers that promise
   is the last place on the site that should carry a number nobody re-counted. */
const ninetyDay = (await allSequences()).find((s) => s.id === "ninety-day");
const NINETY_PHASES = ninetyDay?.data.groups.length ?? 0;
const NINETY_ACTIONS = ninetyDay?.data.groups.reduce((n, g) => n + g.items.length, 0) ?? 0;

/**
 * Measured from 03_Teen_and_Grow_Rich_DIGITAL_READING_EDITION_66P_NEW_DOMAIN.pdf: body text blocks
 * only, with the running header, the strapline and the folio excluded — the same bands
 * tools/extract_book_content.py drops. Rounded down to the nearest hundred so the figure
 * is never flattering.
 *
 * Re-measured independently by re-running that script's own `blocks()` over all 66 pages
 * of the digital PDF: 10,687 words. 10,600 is that, rounded down. The method is stated on
 * the page, because non-negotiable 10 applies to a number about our own product too — and
 * the only primary source for this one is the print file, which anyone can count.
 */
const WORDS = 10_600;
/**
 * The reading rate is an assumption, not a measurement, so it is shown on the page next
 * to the number it produces rather than hidden in this file. 200 words a minute is a
 * conservative silent-reading pace; a 13-year-old reading it properly will take longer,
 * which is the direction an honest estimate should err in.
 */
const WORDS_PER_MINUTE = 200;
const MINUTES = Math.round(WORDS / WORDS_PER_MINUTE);

const FACTS = [
  { key: "Pages", value: "64 printed pages." },
  { key: "Size", value: "140 × 216 mm." },
  { key: "Words", value: `About ${WORDS.toLocaleString("en-GB")}, body text only.` },
  {
    key: "Reading time",
    value: `About ${MINUTES} minutes straight through, at ${WORDS_PER_MINUTE} words a minute — and longer if you are actually reading it. Straight through is not how it is meant to be used: every chapter ends in something to go and do.`,
  },
  { key: "Written for", value: "Readers aged 13 and up. English only." },
  { key: "Edition", value: "The Condensed Gen Z Edition. First print run, 2026." },
  { key: "Publisher", value: "Bright Kids." },
  { key: "Author", value: "Ryan Rijvers, who was thirteen when he wrote it." },
];

/** D4: the split that makes both the book and the site better at their own job. */
/**
 * What the printed copy gives you that this site cannot.
 *
 * This list used to be "What the book has that this site does not": the fifteen stories,
 * the Hill Remix essays and What It Means Now, deliberately withheld from the site so the
 * book had something to sell. That has been reversed — the whole book is free to read here
 * — so the list had to be rewritten rather than reworded. Nothing on it is information,
 * because the information is no longer the scarce part. All of it is the object.
 */
const PRINT_ONLY = [
  {
    title: "Something to hand to somebody",
    text: "You cannot give a URL to a friend the way you can put a book in their hands, and nobody has ever left a link on a classroom shelf.",
  },
  {
    title: "It cannot be closed by a notification",
    text: "The whole design of this book is to be finishable. Sixty-four pages on paper is a very different promise from sixty-four pages on the device that keeps interrupting you.",
  },
  {
    title: "The illustrations at full size",
    text: "Fifteen of them, printed at 140 x 216mm on paper chosen for it. They are on this site too, scaled to whatever screen you happen to be holding.",
  },
  {
    title: "It survives everything this site does not",
    text: "No browser clears it, no school laptop signs you out of it, and it still works when the wifi does not. That is the same argument this site makes about printing your receipts.",
  },
];

/**
 * Printed page 63, "THE COMPANION BUILD", verbatim.
 *
 * This is the book making a promise about this website, in sixty-four pages that are
 * already in people's hands. Two of the six things on the list are barred outright by
 * non-negotiables 1 and 5 — both would need a server holding a thirteen-year-old's work —
 * and one is simply not finished. A reader who checks the list item by item and finds
 * three gaps has caught the book overclaiming, unless the site says it first. Silence is
 * the only option here that makes the book look dishonest.
 *
 * Quoted rather than summarised, and hard-coded rather than read from a collection,
 * because the extraction script drops this block: voice.yaml's `about-ryan` carries the
 * three body paragraphs of printed page 63 and not the boxed panel beside them. /terms
 * quotes the Publishing Note inline for the same reason. If the panel ever lands in the
 * content pipeline, this constant should be deleted and read from there instead.
 */
const COMPANION_BUILD =
  "The strongest business around this book is not only the PDF. It is the experience: a free starter chapter, an AI-powered 90-day plan, safe project challenges, worksheets, portfolio pages, and a parent-visible progress system.";

const NOT_FOR = [
  "Anyone who wants a number. There are no income figures in the book and none on this site.",
  "Anyone who wants it done for them. Every chapter ends in a build you have to actually do.",
  "Anyone who wants length. It is 64 pages. That is a decision, not a shortfall, but if a long book is what you are after, this is not it.",
  "Anyone under 13. It is written for 13 and up, and several chapters ask you to bring in a parent or guardian before you act.",
];

/* The book as an entity. No isbn and no offers: neither is confirmed, and a structured
   claim is still a claim (docs/for-ryan.md, items 5 and 8). */
const jsonLdText = jsonLd({ ...book, url: "/get" }, Astro.site);
---

<Page
  title="Get the book"
  description="Teen & Grow Rich is 64 printed pages, about 10,600 words, and the whole text is free here. What printed page 63 promised, what this site does instead, and why."
  jsonLdText={jsonLdText}
>
  <ChapterFurniture
    eyebrow="The book"
    title="Get the book"
    subtitle="Read all of it free, right here. Buy the print if you want the object."
  />

  <div class="wrap">
    <div class="intro">
      <div class="prose">
        <p class="lede">
          <b>The whole book is free to read here.</b> All fifteen chapters, the stories,
          the Hill Remix essays and What It Means Now — the complete text, no account, no
          email address, nothing to unlock. The printed copy is the same words on paper,
          and that turns out to be worth something on its own.
        </p>
      </div>

      <figure class="cover">
        <Image
          src={cover}
          alt="The front cover of Teen & Grow Rich: the title in heavy condensed capitals across a blue-hour harbour photograph, above the line 'Think bigger. Build real skills. Start now.' and 'By Ryan Rijvers'."
          widths={[280, 560]}
          sizes="(min-width: 48rem) 280px, 60vw"
          loading="eager"
        />
      </figure>
    </div>
  </div>

  {/* The whole book, free, two ways.

      This was "The free starter chapter", carrying a placeholder that said the file did
      not exist yet. One chapter as a taster is the wrong shape now: the whole thing is
      free, so the only question left is which way you would rather read it. */}
  <section class="wrap section" aria-labelledby="read">
    <h2 id="read">Read the whole thing, free</h2>
    <div class="prose">
      <p>
        No account, no email address, no &ldquo;enter your details to download&rdquo;. There
        is nowhere on this site to enter your details, which is the point.
      </p>
    </div>

    <ul class="ways">
      <li class="way">
        <a class="way__link" href="/c/01">
          <span class="way__kicker">On this site</span>
          <b class="way__title">Start at chapter one</b>
          <span class="way__body">
            The better version. Each chapter carries the story, the Hill Remix and What It
            Means Now exactly as printed &mdash; and directly underneath, the Play as a
            checklist, the 24-Hour Build with a timer, and the Reality Check in full. That
            is the part a printed page cannot do.
          </span>
        </a>
      </li>
      <li class="way">
        <a class="way__link" href="/teen-and-grow-rich.pdf" download>
          <span class="way__kicker">PDF &middot; 2.6 MB &middot; 66 pages</span>
          <b class="way__title">Download the whole book</b>
          <span class="way__body">
            The digital reading edition, the same file the print run was set from. For
            offline, for an e-reader, for a school laptop with no wifi, or to print
            yourself. Nothing is tracked and nothing is asked for.
          </span>
        </a>
      </li>
    </ul>

    <p class="prose aside">
      Both routes are the complete book. Neither is a sample, neither expires, and neither
      leads to a page asking you for anything.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="facts">
    <h2 id="facts">The physical truth</h2>
    <div class="rows">
      {
        FACTS.map((f) => (
          <div class="row">
            <p class="row__key">{f.key}</p>
            <p class="row__value">{f.value}</p>
          </div>
        ))
      }
    </div>
    <p class="prose note">
      The word count was measured from the print file itself — every text block on all 66
      pages of the digital edition, with the running header, the strapline and the page
      numbers dropped — and then rounded down to the nearest hundred. The raw count was
      10,687. The reading time is that number divided by {WORDS_PER_MINUTE}, which is an
      assumption about you rather than a fact about the book. You are welcome to check
      both.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="book-only">
    <h2 id="book-only">What the printed copy gives you</h2>
    <div class="rows">
      {
        PRINT_ONLY.map((b) => (
          <div class="row">
            <p class="row__key">{b.title}</p>
            <p class="row__value">{b.text}</p>
          </div>
        ))
      }
    </div>
    <p class="prose note">
      Notice that none of those is information. The words are all on this site, free, and
      they are staying that way — a thirteen-year-old should not have to ask a parent for
      money to read a book about not needing money. What the print run sells is the object.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="free">
    <h2 id="free">And every tool in it, also free</h2>
    <div class="prose">
      <p>
        Everything the book asks you to do is built here as something you can actually use.
        Not a sample, not a locked preview, and not behind an email address:
      </p>
      <ul class="tally">
        <li><b>{t.builds}</b> 24-hour builds, each with a timer and a printable receipt</li>
        <li><b>{t.realityChecks}</b> Reality Checks, in full, every one of them</li>
        <li><b>{t.playSteps}</b> Play steps across the {t.chapters} chapters</li>
        <li><b>{t.worksheetFields}</b> worksheet fields across the four worksheets</li>
        <li><b>{t.sequenceActions}</b> dated actions in the 90-day path and the 30-day Tiny Launch</li>
        <li><b>{t.offers}</b> safe first offers</li>
      </ul>
      <p>
        <a href="/builds">Start with the builds</a> if you have twenty minutes, or{" "}
        <a href="/reality-check">read the Reality Checks</a> if you are an adult deciding
        whether this is safe for someone in your house. Both are the real thing, not a
        sample.
      </p>
    </div>
  </section>

  {/* The book's own promise about this site, checked line by line.

      No flags on the six rows, deliberately. Green/yellow/red on this site means go, tell
      an adult first, or an adult does it with you — an approval level, not a delivery
      status. Borrowing the atom to mean "shipped / not shipped" would teach the reader a
      second, contradictory code for the same three colours. The status here is a word. */}
  <section class="wrap section" aria-labelledby="promise">
    <h2 id="promise">What page 63 promised</h2>
    <div class="prose">
      <p class="meta"><PageRef page={63} kind="The Companion Build" /></p>
      <p>
        Near the back, the book says what this website was going to be. It was written
        before the site existed. Here is that sentence, exactly as printed:
      </p>
      <blockquote><p>{COMPANION_BUILD}</p></blockquote>
      <p>
        Six things. Two of them are here exactly as written. One is bigger than the book
        promised. One is here without the AI in front of it. Two are never going to exist,
        and that is a decision rather than a delay. All six, against what is actually on
        this domain today:
      </p>
    </div>

    <ul class="promise">
      <li class="promise__item">
        <p class="promise__phrase">&ldquo;a free starter chapter&rdquo;</p>
        <p class="promise__status">Bigger than that</p>
        <p class="promise__text">
          One free chapter was the plan. You get all fifteen — the stories, the Hill Remix
          essays, What It Means Now — plus the whole book as a PDF. No account, no email
          address, nothing to unlock. <a href="/c/01">Start at chapter one.</a>
        </p>
      </li>
      <li class="promise__item">
        <p class="promise__phrase">&ldquo;an AI-powered 90-day plan&rdquo;</p>
        <p class="promise__status">The plan yes, the AI not yet</p>
        <p class="promise__text">
          <a href="/path/ninety-day">The 90-day path</a> is here: {NINETY_ACTIONS} dated
          actions in {NINETY_PHASES} phases, straight out of the book, with the ones that
          ask for an adult flagged yellow. No AI wrote it and none is needed for it to work.
          The two AI tools are a separate thing and they are{" "}
          <b>not live yet</b> — <a href="/tools/scam-check">Scam Check</a> and{" "}
          <a href="/tools/shrink">Shrink My First Step</a> are shells that show you exactly
          what they will ask for and give back, and the code behind them does not exist. Both
          pages say so on themselves.
        </p>
      </li>
      <li class="promise__item">
        <p class="promise__phrase">&ldquo;safe project challenges&rdquo;</p>
        <p class="promise__status">Here</p>
        <p class="promise__text">
          <a href="/builds">{t.builds} 24-hour builds</a> and{" "}
          <a href="/offers">{t.offers} safe first offers</a>. Every one carries a green,
          yellow or red flag telling you whether to go, check in with an adult first, or get
          an adult involved before you start. That is the &ldquo;safe&rdquo; part, and it is
          the book's rule, not ours.
        </p>
      </li>
      <li class="promise__item">
        <p class="promise__phrase">&ldquo;worksheets&rdquo;</p>
        <p class="promise__status">Here</p>
        <p class="promise__text">
          Four of them, {t.worksheetFields} fields, starting with{" "}
          <a href="/worksheet/starting-point">Your Starting Point</a>. They fill in on a
          screen and they print blank, so you can do the whole thing with a pen and no
          device at all.
        </p>
      </li>
      <li class="promise__item">
        <p class="promise__phrase">&ldquo;portfolio pages&rdquo;</p>
        <p class="promise__status">Not being built</p>
        <p class="promise__text">
          A portfolio page means this site putting your work on the internet, under your
          name, where anyone can read it. You are thirteen. So your proof goes where you can
          actually keep it instead: <a href="/receipts">copy it out as text in one tap</a>,
          or print it and put it in the REAL RICH RECEIPTS folder Build 01 asks you to
          start. It stays on your device unless you move it, and nothing you type here is
          ever sent anywhere.
        </p>
      </li>
      <li class="promise__item">
        <p class="promise__phrase">&ldquo;a parent-visible progress system&rdquo;</p>
        <p class="promise__status">Not being built</p>
        <p class="promise__text">
          A dashboard a parent can open is a server holding a thirteen-year-old's work: an
          account, a password, and a copy of everything you typed sitting on a computer you
          do not own. We picked the other thing. <b>A receipt you print and hand over</b> —
          a parent can read it in ten seconds, it works with no wifi, nobody else can log
          into it, and you decide what goes on it. The adult side of this book is{" "}
          <a href="/parents">a conversation and a one-sheet agreement</a>, not a feed of you.
        </p>
      </li>
    </ul>

    <p class="prose note">
      Two of six is not a small gap and it is not closing. Both of them need this site to
      keep your work somewhere other than your own browser, and that is the one thing it
      will never do — it is why there is no account, no login and no email field anywhere on
      this domain. See <a href="/privacy">privacy</a>. The AI tools are the only item on the
      list that is genuinely unfinished; when they land they get a dated line on{" "}
      <a href="/updates">the changelog</a>, like everything else. Page 63 stays printed and
      this stays here, so you can check both.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="not-for">
    <h2 id="not-for">Who it is not for</h2>
    <div class="prose">
      <ul class="plain">{NOT_FOR.map((n) => <li>{n}</li>)}</ul>
      <p>
        If you read that list and still want the book, you are the reader it was written
        for.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="buy">
    <h2 id="buy">Where to buy the printed copy</h2>
    <div class="prose">
      <div data-placeholder class="placeholder">
        <p class="placeholder__label">Retailer link pending</p>
        <p class="placeholder__note">
          The printed book is sold through an outside retailer and the link is not
          confirmed yet. It will appear here, plainly, with no countdown attached to it —
          and nothing changes for you in the meantime, because the whole book is already
          free above.
        </p>
      </div>
      <p>
        When it does: the retailer handles the payment, the delivery and the returns. This
        site never sees your name, your address or your card, because it has no way to
        receive them.
      </p>
      <p class="aside">
        Nothing about buying the book unlocks anything on this site, and nothing on this
        site expires. See <a href="/terms">the terms</a> and{" "}
        <a href="/privacy">the privacy page</a>.
      </p>
    </div>
  </section>

  {/* The class-set boundary, stated once and in one place.

      Four reviewers asked how a school buys thirty copies and got four different answers,
      which is what happens when the answer lives nowhere. It lives here now, under the
      section about buying, and it does not invent a price, a discount or an order flow —
      none of the three exists and the retailer link is not even confirmed. The whole
      answer follows from non-negotiable 7: the words are free, so a bulk deal on the words
      would be a deal on nothing.

      It does not invent a licence either, and an earlier draft of this section did. That
      draft listed the whole book among the things a class may photocopy and put on a shared
      drive — which is a licence neither /terms nor /teachers grants. /terms puts the book's
      stories, essays and illustrations under all rights reserved and the site's own
      material under Creative Commons; the licence boxes on /teachers say the same. (The
      "what prints" list on /teachers still tells a teacher the licence covers putting the
      book PDF on a shared drive, which its own licence box withholds. That line is a defect
      in that file, not a reason to copy it into this one.) Non-negotiable 7 makes the words
      free to READ, and free to read is not the same as licensed to redistribute. A
      page about buying is the last place that should quietly widen a licence the licence
      page never gave, so the boundary is stated once here and then linked rather than
      restated. Nothing is lost by being accurate about it: a link reaches a whole class for
      nothing and needs no permission from anybody, which is the practical answer the
      section was written to give. */}
  <section class="wrap section" aria-labelledby="class-sets">
    <h2 id="class-sets">Class sets, and buying more than one</h2>
    <div class="prose">
      <p>
        There is no bulk route on this site. No class-set price, no school discount, no site
        licence, no order form, no invoice — because this site does not sell anything at
        all. It has no checkout and no way to take a payment. When the retailer link lands,
        ordering thirty is a question for the retailer, the same as ordering one, and nobody
        here can change the terms of it.
      </p>
      <p>
        You almost certainly do not need thirty anyway, because nobody has to buy anything
        to read this. <b>Send a class the link.</b> Thirty students can read all fifteen
        chapters free, on any device, with no account and nothing to fill in — and handing
        out a link needs no permission from anyone.
      </p>
      <p>
        <b>The material built around the book is yours to copy.</b> All four worksheets, the
        {" "}{t.builds} builds, the 90-day path, all {t.realityChecks} Reality Checks, the
        templates and everything else made for this site are under a Creative Commons
        licence. Print them, photocopy them, put them on a shared drive, cut them up for your
        group. You do not have to ask, and there is nobody to ask. The one restriction is
        that the Reality Checks may be copied but never edited.
      </p>
      <p>
        <b>The book itself is not under that licence.</b> The stories, the essays and the
        illustrations are free for anyone to read here and free to download for your own
        reading, and that is not changing — but it is permission to read them, not a licence
        to pass the file on or post it somewhere else. It costs nothing to be strict about
        this, because the link goes to exactly the same words.
      </p>
      <p>
        So what would a class set actually be? Thirty copies of the object — thirty things a
        student can keep, mark up and take home. That is a real thing to want, and it is a
        different thing from access. Nothing in a printed copy is missing from this site.
      </p>
      <p class="aside">
        The teacher version of all of this, including what prints and what does not, is on{" "}
        <a href="/teachers">the teachers page</a>. The licences themselves are on{" "}
        <a href="/terms#licence">the terms page</a>.
      </p>
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p,
  .prose ul,
  .prose blockquote,
  .prose blockquote + p {
    margin-block-start: 0.9em;
  }

  /* The turn after a list ("…and still want the book") has to sit visibly outside the
     list it answers, or it reads as one more entry in it. */
  .prose ul + p {
    margin-block-start: 1.25rem;
  }

  .lede {
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    color: var(--text-strong);
  }

  .intro {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.75rem;
    margin-block-start: 1.75rem;
  }

  .cover {
    margin: 0;
    max-inline-size: 17.5rem;
  }

  .cover :global(img) {
    inline-size: 100%;
    block-size: auto;
    /* A solid base behind the image so a slow load never leaves a hole. */
    background: var(--surface-card);
  }

  @media (min-width: 48rem) {
    .intro {
      flex-direction: row;
      /* The lede is five lines against a ~440px cover. Hung from the top it left a large
         void under it in the middle of the first screen. */
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
    .cover {
      flex: none;
    }
  }

  .section {
    margin-block-start: 3rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  .section > .prose {
    margin-block-start: 0.75rem;
  }

  .rows {
    margin-block-start: 1.5rem;
    /* The key column plus the gap plus the measure, so the hairlines end where the words
       do rather than running on to the 72rem wrap. Matches grid-template-columns below. */
    max-inline-size: calc(11rem + 2rem + var(--container-measure));
    border-block-start: 1px solid var(--rule-hairline);
  }

  .row {
    display: grid;
    gap: 0.2rem 2rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .row__key {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .row__value {
    max-inline-size: var(--container-measure);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .note {
    margin-block-start: 1rem;
