---
/**
 * Shrink My First Step — AI tool 2 (docs/decisions.md D9, D10, D11).
 *
 * This is the SHELL. The serverless function does not exist yet, so the page degrades
 * honestly: what it does, the input it will ask for, the shape of the answer, and a plain
 * statement that it is not live. Nothing else on the site depends on it.
 *
 * The tool is Chapter 1's third Play step turned into a machine, so the step it automates
 * is quoted here verbatim from the book rather than described.
 *
 * No <form> element — not because the CSP would stop one (the shipped policy is
 * form-action 'self', which permits the same-origin page-number form on / and /404), but
 * because an input that looks live and silently does nothing is worse than one that says
 * it is off.
 *
 * THE FIXED ENDING. Scam Check's every answer ends in "show one adult" and that is written
 * into its spec (D9). This tool needs the same thing for a different reason: a perfectly
 * good twenty-minute first step can be "post the first version", "message somebody who has
 * already done this", or "charge five euros for it". Public posting, contact with new
 * people and money moving are yellow and red on the book's own rule (printed page 61), and
 * a page that hands a thirteen-year-old three of those and says "do it before tomorrow
 * night" with no adult named anywhere is the tool answering a question it was not asked.
 *
 * So two things are specified here rather than left to the model:
 *   1. every step carries a flag — green, yellow or red. The tier is what decides whether
 *      the step is the reader's to take alone, so it is part of the answer, not a garnish
 *      (D12: the flag is the primary UI atom, and colour is never the only signal — the
 *      Flag component always writes the rule out in words).
 *   2. the three lines underneath are the same on every answer, and they are printed by
 *      this page rather than generated. That is the part that makes "the model cannot
 *      vary or omit it" true rather than hoped for: there is no wording there for it to
 *      soften, and no answer where it can decide an adult is not needed.
 *
 * Writing it now is deliberate. The tool is still a shell, which is the cheapest moment a
 * line like this is ever mandatory; bolting it onto a live tool is how it becomes optional.
 */
import Page from "../../layouts/Page.astro";
import ChapterFurniture from "../../components/ChapterFurniture.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import Box from "../../components/Box.astro";
import Flag from "../../components/Flag.astro";
import PageRef from "../../components/PageRef.astro";
import { allChapters, allRealityChecks } from "../../lib/content";
import { metaFor } from "../reality-check/_checks";

const chapter = (await allChapters()).find((c) => c.data.slug === "dream-big")!;
const step = chapter.data.play.find((p) => p.n === 3)!;
const check = (await allRealityChecks()).find((c) => c.id === "dream-big")!;
const checkMeta = metaFor(check.id);

/* Illustrative only, and labelled as such on the page. Deliberately not built from the
   book's Chapter 1 story: the 15 stories are the book's, not the site's (D4).

   The flags are part of the example on purpose. Two green and one yellow is what a real
   answer looks like — most first steps genuinely are green, and a page where every step
   came back yellow would teach a reader to stop reading the flag. The `why` line exists
   because a colour and a word tell you the tier but not the reason, and the reason is the
   part that transfers to the next decision. */
const EXAMPLE_GOAL = "I want to start a YouTube channel.";
const EXAMPLE_STEPS = [
  {
    step: "Say the first sixty seconds of one video out loud and time it on your phone.",
    proof: "A script you have actually heard, and a real number for how long it runs.",
    flag: "green" as const,
    why: "Nobody hears it, nothing is spent, and it can be undone by deleting a recording.",
  },
  {
    step: "Film that sixty seconds in one take. Do not edit it, do not re-record it.",
    proof: "One video file with today's date on it, which did not exist this morning.",
    flag: "green" as const,
    why: "A file on your phone is not a post. Putting it online is a separate decision, and that one is yellow.",
  },
  {
    step: "Send the take to one person and ask what was confusing.",
    proof: "One reply with one specific note in it — the first outside information you have.",
    flag: "yellow" as const,
    why: "It leaves your phone and lands on a person. The tool cannot know who you are sending it to, so this one gets said out loud first.",
  },
];
---

<Page
  title="Shrink My First Step"
  description="Type the goal that is too big and get three first steps that fit in 20 minutes, each with the proof it leaves behind. Chapter 1's third Play step, as a tool."
  printedPage={chapter.data.printedPage}
>
  <ChapterFurniture
    eyebrow={`AI tool · ${chapter.data.eyebrow.split(" / ")[0]}`}
    title="Shrink My First Step"
    subtitle="Type the goal that is too big. Get three first steps that fit in twenty minutes, and the proof each one leaves."
  />

  <SafetyNotice tone="crisis" />

  <div class="wrap">
    <p class="status" role="note">
      <span class="status__badge">Not live yet</span>
      {/* "This tool is not built yet", matching /get, which says the code behind it does
          not exist. "Not switched on" implies it is built and waiting for a flag, and a
          reader who checked both pages was told two different things. */}
      This tool is not built yet. Everything below shows exactly what it will ask for and
      exactly what it will give back — nothing you type here goes anywhere today.
    </p>

    <div class="prose">
      <p class="lede">
        You do not get stuck because your idea is too small. You get stuck because the
        first move feels huge, everyone will see it, and you will look stupid if it goes
        wrong. This tool does one thing:
        it cuts the goal down until the first step fits in twenty minutes and leaves
        something behind that you can point at.
      </p>
      <p class="meta">
        {/* No middot inside `kind`. PageRef appends its own separator with no leading
            space and relies on the flex gap for the other side, so a kind that already
            contained one rendered "Chapter 1 · The Play· Book page 10". Every other caller
            passes a single label. */}
        <PageRef page={chapter.data.printedPage} kind={`Chapter ${chapter.data.n} Play`} />
      </p>
    </div>
  </div>

  <section class="wrap section" aria-labelledby="from-book">
    <h2 id="from-book">Where this comes from</h2>
    <div class="prose">
      <p>
        This is step 3 of Chapter 1's Play, word for word:
      </p>
      <blockquote>
        <p><b>{step.n}. {step.title}</b> {step.text}</p>
        <cite>Teen &amp; Grow Rich, printed page {chapter.data.printedPage}</cite>
      </blockquote>
      <p>
        You can do it without the tool in about a minute. The tool exists for the days when
        you cannot see how.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="input">
    <h2 id="input">What it asks for</h2>
    <div class="prose">
      <div class="field">
        <label class="field__label" for="goal">The goal that feels too big</label>
        <p class="field__hint" id="goal-hint">
          <b class="field__ai">
            When it is live, an AI model will read what you type. Nothing will be stored.
          </b>
          One sentence is enough. No names, no school, no address — it does not need them
          and the answer is no better with them in.
        </p>
        <textarea
          id="goal"
          name="goal"
          rows="3"
          disabled
          aria-describedby="goal-hint goal-status"
          placeholder="The tool is not live yet."></textarea>
        {/* Not "disabled rather than hidden" — the reader does not have "hidden" as an
            alternative and does not care which was picked. */}
        <p class="field__status" id="goal-status">
          You cannot type in this box yet. It is here so you can see what the tool will ask
          for before you decide whether you would ever use it.
        </p>
      </div>
      <button type="button" class="cta" disabled>Shrink it — not live yet</button>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="output">
    <h2 id="output">What it gives back</h2>
    <div class="prose">
      <p>
        Three steps. Each one fits in twenty minutes, and each one names the proof it
        leaves behind — because proof is the thing the next chapter runs on, and a step
        that leaves nothing behind is a step you cannot tell you took.
      </p>
      <p>
        Each one also gets a flag, because some twenty-minute steps are not yours to
        take alone. Posting something with your name on it, messaging somebody you have
        never met, or charging money for something are yellow or red under the book's own
        rule. You get told which one before you start, not after.
      </p>
      <p>Then every answer ends the same way, in the same words, whatever you typed.</p>
    </div>

    {/* A section rather than a div: an aria-label on a generic element is dropped by
        several screen readers, and this block needs to announce itself as an example. */}
    <section class="result" aria-label="Example of the output. Not advice about your goal.">
      <p class="result__tag">Example output — not advice about your goal</p>
      <p class="result__goal">
        <span class="result__goal-key">Goal typed in</span>
        {EXAMPLE_GOAL}
      </p>

      <ol class="steps">
        {
          EXAMPLE_STEPS.map((s, i) => (
            <li class="step">
              <p class="step__n">{i + 1} · 20 minutes</p>
              <p class="step__do">{s.step}</p>
              {/* Flag before proof, not after: the tier answers "is this mine to do at
                  all", and that question comes before "what will it leave behind". */}
              <p class="step__flag">
                <Flag level={s.flag} size="sm" />
              </p>
              <p class="step__why">{s.why}</p>
              <p class="step__proof">
                <span class="step__proof-key">The proof this leaves</span>
                {s.proof}
              </p>
            </li>
          ))
        }
      </ol>

      {/* THE FIXED ENDING. Not example copy — these three lines print under every answer
          the tool ever gives, word for word, and they are the reason this page can send a
          reader off to do something public, or something with money in it, at all.

          Written out here rather than held in a constant so that the one place the wording
          lives is the place it is read, which is how Scam Check's "show one adult" ending
          is specified too. The link is the point of the second line: this page names the
          tier, /race-control is the rule. */}
      <h3 class="result__h">Every answer ends the same way</h3>
      <p class="result__action">
        Pick one. Do it before tomorrow night. Keep whatever it produces.
      </p>
      <p class="trailer">
        Then look at its flag. Green: go. Yellow: say it out loud to one adult before you
        start, not after. Red: an adult does it with you, not just hears about it. The whole
        rule is on the <a href="/race-control">Green, yellow, red page</a>.
      </p>
      <p class="trailer">
        Twenty minutes is short. Short is not the same as safe, and a first step gives you
        proof, not payment.
      </p>
    </section>

    {/* The guarantee about the closing lines used to be stated here as well as in
        "About the AI, plainly" one screen down, in near-identical words — so a reader met
        the same paragraph twice and assumed they had lost their place. It is stated once
        now, in the row that exists for it. */}
    <p class="prose note">
      It never picks for you and it never tells you the goal is wrong. Three options, and
      you can start one of them right now. That is all it does.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="check">
    <h2 id="check">The Reality Check for this chapter</h2>
    <div class="prose">
      <p>
        Straight from printed page {check.data.printedPage}, in full and unedited.
      </p>
    </div>
    <Box kind="check" class="check">
      {/* Every Reality Check carries its own flag, on every surface that shows one (D12). */}
      {checkMeta && (
        <p class="check__flag">
          <Flag level={checkMeta.flag} size="sm" />
        </p>
      )}
      <p>{check.data.text}</p>
    </Box>
  </section>

  {/* The refusal path has to have a destination that exists whether or not the function
      is ever switched on. Every route below is one the book's own Reality Check for
      threats, sexual messages and blackmail already names.

      There is deliberately NO helpline number or finder link here yet. Inventing one for a
      13-year-old in a bad hour is worse than admitting the gap, so the gap is stated in
      the block below and the routes that do exist are given plainly. See docs/for-ryan.md
      §7 — a verified international finder plus a Dutch one, checked by someone who does
      safeguarding professionally, is pre-launch work. */}
  <section class="wrap section" aria-labelledby="help">
    <h2 id="help">If the thing in the way is not a goal</h2>
    <div class="prose">
      <p>
        If what is actually stopping you is someone threatening you, someone asking you to
        keep a friendship secret, or how you are feeling about yourself, no twenty-minute
        first step is the right answer to that. None of that gets broken into smaller
        tasks, and it is not something you are supposed to solve on your own.
      </p>

      <div class="pending" aria-labelledby="helpline-h">
        <p class="pending__label" id="helpline-h">Helpline finder — not in place yet</p>
        {/* Kept factually identical to the same block on /tools/scam-check. This one used
            to end "it will be added here before this site goes live", which the sibling
            page contradicts — that page says plainly that the site is public today and the
            missing finder is a gap, not a plan. Two safety notices disagreeing about
            whether anyone can reach this page yet is the version a reader should never
            get, and of the two claims this is the one that is safe to be wrong about. */}
        {/* Same facts, said in words a frightened reader can decode. "a gap and not a
            plan" is roadmap vocabulary, "someone who does safeguarding professionally" is
            a job description, and "the routes below are the ones this page can stand
            behind" is institutional — in the one block where a reader is least able to
            work any of it out. "and it is public today" also had an ambiguous "it": a
            reader could read it as the helpline. */}
        <p class="pending__note">
          There is no helpline listed here yet. This page is already online, so that is a
          real gap, not something we are pretending is finished. We are checking one with
          an adult who does this for a living — one for anywhere, one for the Netherlands.
          Putting up a number we had not checked would be worse than having none. The list
          below is what this page can promise today. None of it is a crisis service,
          including the mailbox in the footer: nobody reads that quickly.
        </p>
      </div>

      <ul class="help">
        <li>
          Tell one adult today — a parent or guardian, a teacher, or whoever your school
          says to go to when something is wrong. If the first adult does not act, tell a
          second one.
        </li>
        <li>
          The police, or your local emergency number, if you have been threatened or you
          are frightened for your safety.
        </li>
        <li>
          A family doctor if sleep or eating has changed, and a school counsellor is a
          reasonable first stop when the worry is at home.
        </li>
        <li>
          Read{" "}
          <a href="/reality-check/mindful-tech">
            what to do about threats, sexual messages or blackmail
          </a>. That page works whether or not this tool is running.
        </li>
      </ul>
      <p class="note">
        You do not have to work out what is wrong before you tell someone, and you do not
        need the right words ready. Saying “something is going on and I do not know how to
        say it” is a complete sentence and it is enough to start with.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="ai">
    <h2 id="ai">About the AI, plainly</h2>
    <div class="rows">
      <div class="row">
        <p class="row__key">It is AI</p>
        <p class="row__value">
          Your sentence is read by an AI model, and the three steps come back from that
          model. It can be wrong, and it does not know anything about your situation beyond
          the sentence you typed.
        </p>
      </div>
      <div class="row">
        <p class="row__key">Nothing is stored</p>
        <p class="row__value">
          Not your goal, not the steps, not a log of either. It is sent, answered and
          dropped. There is no account here and nowhere for it to be kept.
        </p>
      </div>
      <div class="row">
        <p class="row__key">It is not a chat</p>
        <p class="row__value">
          One goal in, three steps out. It never writes in Ryan's voice and it never
          generates content from the book.
        </p>
      </div>
      <div class="row">
        <p class="row__key">The last lines are not the AI's</p>
        <p class="row__value">
          The model writes the three steps and tags each one green, yellow or red. The
          lines underneath — the ones that say when an adult hears about it first — are
          printed by this page, the same on every answer. It cannot reword them, and it
          cannot leave them off because it thinks your step is fine.
        </p>
      </div>
      <div class="row">
        <p class="row__key">Some things it will not answer</p>
        <p class="row__value">
          If what you type involves self-harm, abuse, grooming or blackmail, it stops and
          gives one fixed response instead: tell a trusted adult today, and the routes set
          out under <a href="#help">If the thing in the way is not a goal</a> above. It
          will not turn any of that into a twenty-minute task.
        </p>
      </div>
      <div class="row">
        <p class="row__key">If it is down</p>
        <p class="row__value">
          Nothing else on this site stops working. Do it by hand with{" "}
          <a href="/c/01">Chapter 1's Play</a>, or start from{" "}
          <a href="/worksheet/starting-point">Your Starting Point</a>.
        </p>
      </div>
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p,
  .prose blockquote,
  /* Equal air below the quote as above it, so the site's own words are clearly outside
     the book's. */
  .prose blockquote + p {
    margin-block-start: 0.9em;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    max-inline-size: var(--container-measure);
    margin-block-start: 1.75rem;
    padding: 0.85rem 1rem;
    font-size: var(--text-meta);
    color: var(--text-default);
    background: var(--surface-card);
    /* 3px, not 6px: 6px solid orange is the Your 24-Hour Build signature (design-system
       §3) and this is a page-status note, not a box from the book. The hairline gives it
       an edge in light mode, where --surface-card is the page white. */
    border: 1px solid var(--rule-hairline);
    border-inline-start: 3px solid var(--accent-dot);
  }

  .status__badge {
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .lede {
    margin-block-start: 1.5rem;
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    color: var(--text-strong);
  }

  .meta {
    margin-block-start: 0.9rem;
  }

  .section {
    margin-block-start: 3rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  blockquote {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--accent-spine);
  }

  cite {
    display: block;
    margin-block-start: 0.5rem;
    font-size: var(--text-meta);
    font-style: normal;
    color: var(--text-muted);
  }

  .field {
    margin-block-start: 1.25rem;
  }

  .field__label {
    display: block;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .field__hint,
  .field__status {
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .field__hint {
    margin-block: 0.35rem 0.6rem;
  }

  textarea {
    inline-size: 100%;
    padding: 0.75rem;
    font: inherit;
    font-size: var(--text-body);
    color: var(--text-default);
    background: var(--surface-card);
    border: 1px solid var(--control-edge);
    border-radius: 0;
  }

  textarea:disabled {
    opacity: 1;
    color: var(--text-muted);
    border-style: dashed;
  }

  .field__status {
    margin-block-start: 0.5rem;
  }

  .cta {
    margin-block-start: 1.25rem;
    padding: 0.8rem 1.2rem;
    font: inherit;
    font-weight: 700;
    /* Orange fill takes navy text. White on orange is 2.05:1 and is forbidden. */
    color: var(--cta-text);
    background: var(--cta-fill);
    border: none;
  }

  .cta:disabled {
    color: var(--text-muted);
    background: transparent;
    border: 1px dashed var(--rule-hairline);
  }

  .result {
    max-inline-size: var(--container-measure);
    margin-block-start: 1.5rem;
    padding: 1rem 1.1rem;
    background: var(--surface-card);
    /* Not --rule-hairline: in light mode --surface-card is the page white, so the border
       is the only thing saying "this is an example, not your answer". A decorative
       hairline at ~1.3:1 cannot carry that. */
    border: 1px solid var(--control-edge);
  }

  .result__tag {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .result__goal {
    margin-block-start: 0.75rem;
    color: var(--text-strong);
  }

  .result__goal-key,
  .step__proof-key {
    display: block;
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .steps {
    margin-block-start: 1.25rem;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--rule-hairline);
  }

  .step {
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .step__n {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-muted);
    /* Numerals are data. */
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .step__do {
    margin-block-start: 0.25rem;
    font-weight: 700;
    color: var(--text-strong);
  }

  .step__flag {
    margin-block-start: 0.5rem;
  }

  .step__why {
    margin-block-start: 0.2rem;
    font-size: var(--text-meta);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .step__proof {
    margin-block-start: 0.5rem;
  }

  /* Same label style as the headings inside /tools/scam-check's example output. The two
     tool pages are siblings and a reader will land on both; the shape of the answer should
     not change between them. */
  .result__h {
    margin-block-start: 1.25rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .result__h + p {
    margin-block-start: 0.5rem;
  }

  .result__action {
    font-weight: 700;
    color: var(--text-strong);
  }

  .trailer {
    margin-block-start: 0.5rem;
  }

  .check {
    margin-block-start: 1.25rem;
  }

  .check__flag {
    margin-block-end: 0.6rem;
  }

  .field__ai {
    display: block;
    color: var(--text-strong);
  }

  /* Dashed, the same shape /get uses for a thing that is genuinely not built yet. A solid
     card would read as an answer; this has to read as a missing one. */
  .pending {
    margin-block-start: 1.1rem;
    padding: 0.9rem 1rem;
    background: var(--surface-card);
    border: 1px dashed var(--rule-hairline);
  }

  .pending__label {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .pending__note {
    margin-block-start: 0.35rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .help {
    margin-block-start: 0.9rem;
    padding-inline-start: 1.1rem;
    list-style: none;
  }

  .help li {
    position: relative;
    margin-block-start: 0.45rem;
  }

  .help li::before {
    content: "";
    position: absolute;
