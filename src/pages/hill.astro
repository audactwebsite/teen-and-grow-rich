---
/**
 * The Napoleon Hill audit (docs/decisions.md D26).
 *
 * This is the site's credibility centrepiece, and it exists because the largest
 * unmitigated reputational risk in the project is that a book whose first promise is
 * "no fake case studies" is built on the most famous unverifiable case-study collection
 * in publishing. Publishing the audit ourselves is cheaper than being handed it.
 *
 * Two rules this page implements literally: the site never describes the book as
 * inheriting Hill's authority, only as remapping his ideas; and every number links to a
 * primary source or gets cut.
 *
 * The two source links carry rel="external" — they are links, not subresources, so the
 * no-external-hosts check still passes, and Base.astro's speculation rules exclude them
 * from prerendering.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";

/* D29: dated claims carry a verification date, and go stale visibly rather than
   quietly. A date that has drifted testifies that nobody is home. */
const VERIFIED_ON = "2026-07-30";
const verifiedOn = new Date(VERIFIED_ON);
const daysSince = Math.floor((Date.now() - verifiedOn.getTime()) / 86_400_000);
const stale = daysSince > 180;
const verifiedLabel = verifiedOn.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

/** The record, in date order. Every row is checkable from the two sources below. */
const RECORD = [
  {
    when: "c. 1908",
    what:
      "The commission. Hill said Andrew Carnegie handed him the assignment that became his life's work: interview the men who had built America's fortunes and reduce what they did to a set of principles. David Nasaw, who wrote the standard biography of Carnegie and worked through his papers, found no evidence that Hill and Carnegie ever met.",
  },
  {
    when: "The same years",
    what:
      "While he places the Carnegie commission, Hill was on the run over a lumber fraud in Alabama.",
  },
  {
    when: "April 1912",
    what:
      "The trade magazine Motor World described Hill's Automobile College of Washington as a scam.",
  },
  {
    when: "June 1918",
    what: "Illinois issued warrants for Hill under the state's blue-sky securities laws.",
  },
  {
    when: "1919",
    what: "The Federal Trade Commission brought charges against him.",
  },
  {
    when: "Throughout",
    what:
      "The interviews themselves. Beyond one brief encounter with Thomas Edison, there are no records of Hill interviewing the famous men whose lessons he reported.",
  },
];

/** Numbers this site refuses, and why. Both are canon in self-help and neither exists. */
const MYTHS = [
  {
    claim: "The 1953 Yale goal-setting study",
    story:
      "Three per cent of Yale's class of 1953 wrote their goals down, and twenty years later that three per cent was worth more than the other ninety-seven per cent combined.",
    why:
      "Yale has no record of such a study. A 1996 Fast Company investigation went looking for it and could not find anyone able to produce it, at Yale or anywhere else. It survives because it is useful, not because it happened.",
  },
  {
    claim: "The 65% / 95% accountability figures",
    story:
      "You are 65% more likely to reach a goal if you tell someone, and 95% more likely if you book a regular check-in with them.",
    why:
      "Usually credited to a training-industry body. No study, no sample size and no method has ever been produced. The underlying idea — a witness helps — is in this book as Chapter 1's fourth Play step, stated without a fake number attached.",
  },
];
---

<Page
  title="The Napoleon Hill audit"
  description="Napoleon Hill's principles are worth testing; his own stories were not checkable. The record, with dates and sources, and why this book uses labelled composites instead."
>
  <ChapterFurniture
    eyebrow="The audit"
    title="The Napoleon Hill audit"
    subtitle="This book remaps Napoleon Hill's ideas. It does not inherit his authority. Here is the difference, with dates."
  />

  <div class="wrap">
    <div class="prose">
      <p class="lede">
        Hill's principles are worth testing. His biography is not. Historians and
        journalists who went looking for the meetings, the interviews and the credentials
        behind <i>Think and Grow Rich</i> did not find them — and they did find fraud
        charges. This page says so plainly, because a book that promises no fake case
        studies cannot quietly stand on some.
      </p>
    </div>
  </div>

  <section class="wrap section" aria-labelledby="record">
    <h2 id="record">What the record shows</h2>
    <div class="rows">
      {
        RECORD.map((r) => (
          <div class="row">
            <p class="row__key">{r.when}</p>
            <p class="row__value">{r.what}</p>
          </div>
        ))
      }
    </div>

    <div class="prose sources">
      <p class="sources__label">Sources</p>
      <ul>
        <li>
          <a href="https://en.wikipedia.org/wiki/Napoleon_Hill" rel="external noreferrer">
            Napoleon Hill — Wikipedia
          </a>, which carries the dated citations for the warrants, the charges and the
          Motor World report.
        </li>
        <li>
          <a
            href="https://gizmodo.com/the-untold-story-of-napoleon-hill-the-greatest-self-he-1789385645"
            rel="external noreferrer"
          >
            The Untold Story of Napoleon Hill, the Greatest Self-Help Scammer of All Time
          </a> — Gizmodo's long account, which is where most of the primary documents were
          first put side by side.
        </li>
      </ul>
      <p class="sources__date">
        Checked on {verifiedLabel}.
        {
          stale && (
            <span class="sources__stale">
              We have not re-checked this since then — confirm it yourself before relying
              on it.
            </span>
          )
        }
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="turn">
    <h2 id="turn">Then why is the book built on him?</h2>
    <div class="prose">
      <p>
        Because the principles and the man are two different things. Desire, decision,
        planning, persistence, a small honest team, paying attention to where your
        attention goes — none of that is exotic, and all of it can be tested by one person
        in ninety days. That part survives the audit intact. You do not have to trust Hill
        to run it. You run it and look at what exists afterwards.
      </p>
      <p>
        What does not survive is Hill's method of proof: unverifiable stories about famous
        men, told as evidence. So this book does the opposite, and says so on printed page
        2 rather than in a footnote:
      </p>
      <blockquote>
        <p>
          The stories in this edition are fictional composites. They are designed to make
          the principles easy to understand; they are not presented as verified case
          studies. Examples of income, audience growth, or opportunity are not promises or
          typical results.
        </p>
        <cite>Teen &amp; Grow Rich, Publishing Note, printed page 2</cite>
      </blockquote>
      <p>
        That is the whole trade. The stories in the book are labelled as invented, so
        nothing rests on them. The claims that are meant to be believed — the record on
        the <a href="/proof">proof page</a>, every number anywhere on this site — carry a
        source, or they are not here.
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="myths">
    <h2 id="myths">Statistics you will not find on this site</h2>
    <div class="prose">
      <p>
        These two are quoted constantly in books like this one. Both are unsourced. They
        are named here so that their absence reads as a decision rather than an oversight.
      </p>
    </div>

    <div class="rows">
      {
        MYTHS.map((m) => (
          <div class="row">
            <p class="row__key">{m.claim}</p>
            <div class="row__value">
              <p class="myth__claim">“{m.story}”</p>
              <p class="myth__why">{m.why}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="prose rule-note">
      <p>
        <strong>The rule that follows:</strong> every number on this site links to a primary
        source, or it gets cut. If you find one that does not, the mailbox at the bottom of
        this page is the route — it is read by an adult, and a correction is a favour.
      </p>
    </div>
  </section>
</Page>

<style>
  /* Container contract, matched to Page.astro and ChapterFurniture. */
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  .prose p + p,
  .prose ul,
  .prose blockquote {
    margin-block-start: 0.9em;
  }

  .lede {
    margin-block-start: 1.75rem;
    font-size: var(--text-subtitle);
    line-height: var(--text-subtitle--line-height);
    color: var(--text-strong);
  }

  .section {
    margin-block-start: 3rem;
  }

  .section > h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    max-inline-size: var(--container-measure);
  }

  /* The page rhythm: full-width hairline data rows, then a 65ch prose column. */
  .rows {
    margin-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule-hairline);
  }

  .row {
    display: grid;
    gap: 0.2rem 2rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule-hairline);
  }

  .row__key {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    /* Dates and figures are data, not prose. */
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .row__value {
    max-inline-size: var(--container-measure);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .sources {
    margin-block-start: 1.75rem;
  }

  .sources__label,
  .rule-note {
    font-size: var(--text-meta);
  }

  .sources__label {
    font-weight: 700;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .sources ul {
    list-style: none;
    padding: 0;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .sources li + li {
    margin-block-start: 0.6rem;
  }

  .sources__date {
    margin-block-start: 1rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .sources__stale {
    display: block;
    font-weight: 700;
    color: var(--text-strong);
  }

  blockquote {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--accent-spine);
  }

  cite {
    display: block;
    margin-block-start: 0.5rem;
    font-size: var(--text-meta);
    font-style: normal;
    color: var(--text-muted);
  }

  .myth__claim {
    color: var(--text-muted);
  }

  .myth__why {
    margin-block-start: 0.5em;
  }

  .rule-note {
    margin-block-start: 1.75rem;
    padding-block-start: 1.25rem;
    border-block-start: 3px solid var(--accent-dot);
  }

  /* Links inherit their colour and are underlined with the hairline, matching
     SiteFooter — teal-bright and orange never carry text in the light theme. */
  a {
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }
</style>
