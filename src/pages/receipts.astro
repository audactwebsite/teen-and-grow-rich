---
/**
 * The receipts dashboard. Everything on it is read out of this browser; nothing on it has
 * ever left the device, and there is no copy of it anywhere else.
 *
 * Build 01 asks the reader to start a physical folder called REAL RICH RECEIPTS. This
 * page feeds that folder — its job is not to look like progress, it is to get the work
 * OFF this device, because the device is the least reliable place it could be (D17, D24).
 * Copy-as-text is therefore the primary action: one tap, lands in Notes or WhatsApp, and
 * costs a 13-year-old on an iPhone nothing. A JSON download and a file-input round trip is
 * a hostile flow on that phone, so export and import exist but come second.
 *
 * Real counts only, and no comparison of any kind: "4 of 19 builds" is a fact, a badge is
 * a claim about the reader. The book argues against the second one.
 *
 * The label index below is rendered into two inert <template> elements rather than
 * inlined as JSON, so the client can turn a stored id back into "Chapter 4 · Find the
 * pull" without another network request and without an inline script that CSP would have
 * to allow. Anything the index does not know still appears, under its raw id — a receipt
 * this page cannot name is still the reader's, and dropping it silently would be the
 * worst failure this page has.
 */
import Page from "../layouts/Page.astro";
import ChapterFurniture from "../components/ChapterFurniture.astro";
import Box from "../components/Box.astro";
import Flag from "../components/Flag.astro";
import PageRef from "../components/PageRef.astro";
import {
  allBuilds,
  allChapters,
  allRealityChecks,
  allWorksheets,
  allSequences,
  totals,
} from "../lib/content";
import { metaFor } from "./reality-check/_checks";

const builds = await allBuilds();
const chapters = await allChapters();
const worksheets = await allWorksheets();
const sequences = await allSequences();
const t = await totals();

const pad = (n: number) => String(n).padStart(2, "0");

interface Row {
  /** "<kind>:<id>", exactly as storage.ts folds it. */
  key: string;
  label: string;
  note: string;
  href: string;
}

const index: Row[] = [];

for (const b of builds) {
  const nn = pad(b.data.n);
  const chapter = chapters.find((c) => c.data.n === b.data.chapter);
  const name = chapter ? chapter.data.title : b.data.source;
  const href = `/build/${nn}`;
  const note = `Build ${nn} · book page ${b.data.printedPage}`;

  index.push({ key: `build:${b.id}`, label: name, note, href });
  /* The proof field on each build page. Its id scheme is set by src/pages/build/[n].astro
     and must stay in step with it. */
  index.push({ key: `field:proof:${b.id}`, label: `Proof · ${name}`, note, href });
}

for (const c of chapters) {
  for (const step of c.data.play) {
    index.push({
      key: `play:${c.data.slug}:${step.n}`,
      label: `${c.data.title} · ${step.title}`,
      note: `Chapter ${c.data.n} · book page ${c.data.printedPage}`,
      href: `/c/${pad(c.data.n)}`,
    });
  }
}

for (const w of worksheets) {
  for (const f of w.data.fields) {
    /* Both kinds: the Real Rich Scoreboard's six fields are 1-10 scores and will be
       stored as `score`, the rest as `field`, and this page should not care which. */
    for (const kind of ["field", "score"]) {
      index.push({
        key: `${kind}:${w.id}:${f.id}`,
        label: `${w.data.title} · ${f.label}`,
        note: `Book page ${w.data.printedPage}`,
        href: `/worksheet/${w.id}`,
      });
    }
  }
}

/* Fallback lookup. The sequences store one event per dated day and the chapter pages may
   store debrief answers, and neither id is derivable from the YAML here — so a namespace
   table turns "day:tiny-launch:w1d2" into "The 30-Day Tiny Launch · w1d2" rather than
   nothing. Better a slightly technical row than a disappeared one. */
const spaces: { prefix: string; label: string; href: string }[] = [
  ...sequences.map((s) => ({ prefix: s.id, label: s.data.title, href: `/path/${s.id}` })),
  ...worksheets.map((w) => ({ prefix: w.id, label: w.data.title, href: `/worksheet/${w.id}` })),
  ...chapters.map((c) => ({
    prefix: c.data.slug,
    label: `Chapter ${c.data.n} · ${c.data.title}`,
    href: `/c/${pad(c.data.n)}`,
  })),
];

const GROUPS = [
  { kind: "build", heading: "Builds you marked done" },
  { kind: "play", heading: "Play steps you ticked" },
  { kind: "field", heading: "Answers you wrote" },
  { kind: "day", heading: "Days you marked done" },
  { kind: "score", heading: "Scores" },
];

/**
 * The printable index. Built from the same content as the page above, but it reads no
 * storage at all — it is the same sheet whether or not this browser has ever kept anything,
 * because its whole job is to outlive this browser.
 */
const PAPER = [
  {
    heading: "The 19 builds",
    items: builds.map((b) => {
      const chapter = chapters.find((c) => c.data.n === b.data.chapter);
      return { n: pad(b.data.n), label: chapter ? chapter.data.title : b.data.source };
    }),
  },
  {
    heading: "The worksheets",
    items: worksheets.map((w, i) => ({ n: pad(i + 1), label: w.data.title })),
  },
  {
    heading: "The plans",
    items: sequences.map((sq, i) => ({ n: pad(i + 1), label: sq.data.title })),
  },
];

/**
 * Three worked receipts. Deliberately unimpressive: the failure mode this page has to
 * fight is a reader deciding their own first thing is too small to count. Every one of
 * these is a real build from the book done at the smallest honest size, and no money
 * appears in any of them.
 */
const EXAMPLES = [
  {
    before: "“I want to learn web design.”",
    build: "Made one mobile page for a made-up cafe. 35 minutes.",
    proof: "A screenshot of the page, and the two things a friend said were confusing.",
    next: "Fix the headline, and try it on someone who has not seen it.",
  },
  {
    before: "“I should probably practise editing.”",
    build: "Cut one long clip of my own into three short ones with captions.",
    proof: "The three files, plus the original, so the difference is visible.",
    next: "Do the same with footage someone else shot — after asking them.",
  },
  {
    before: "“I have no idea where my money goes.”",
    build: "Wrote down every single thing I spent for one day.",
    proof: "The list, and the one line I did not expect to be on it.",
    next: "Do it for six more days before deciding anything.",
  },
];

/**
 * The portfolio — a fifth route out, not a replacement for the four above.
 *
 * Those four export the RECORD: what was ticked, in this site's order, counts at the top.
 * That is the right document for the reader and the wrong one for anybody else. Nobody
 * deciding whether to give a fifteen-year-old a first job cares that they finished eleven
 * of nineteen builds on a website; they care what exists. So this is the same storage read
 * the other way round — the thing that was made first, the build it came out of underneath
 * it as a reference, and this site's own progress nowhere on it at all.
 *
 * The moment a sheet is written to be sent to somebody who has never met the reader it
 * stops being a private note and becomes the First Offer Canvas one step further on, so
 * the Canvas's rules follow it here: its Reality Check, the red flag its contact-route
 * field carries, and the contact line itself printed on the sheet rather than offered as
 * advice beside it — the person receiving it is the one who has to use it.
 */
const OFFER_WORKSHEET = "first-offer-canvas";
const START_WORKSHEET = "starting-point";

/**
 * Field labels are the book's own wording and are read out of the collection, never typed
 * in here. A missing id throws: the same rule the worksheet page keeps for its Reality
 * Checks — a renamed field has to fail the build, not quietly print a blank sheet.
 */
const fieldRef = (worksheetId: string, fieldId: string): { key: string; label: string } => {
  const w = worksheets.find((x) => x.id === worksheetId);
  const f = w?.data.fields.find((x) => x.id === fieldId);
  if (!w || !f) {
    throw new Error(
      `/receipts: the portfolio reads "${fieldId}" from worksheet "${worksheetId}", which is ` +
        "not in worksheets.yaml. A renamed field must fail the build, not print a blank sheet.",
    );
  }
  return { key: `field:${worksheetId}:${fieldId}`, label: f.label };
};

const PF_NAME = fieldRef(START_WORKSHEET, "my-name");
const PF_SINCE = fieldRef(START_WORKSHEET, "start-date");
/* The four Canvas fields that describe the work to somebody else. THE STARTER PRICE is
   deliberately not one of them: a price is settled with an adult in the room, not printed
   on a sheet that arrives ahead of them. */
const PF_OFFER = ["who-i-help", "the-result", "the-deliverable", "the-proof"].map((id) =>
  fieldRef(OFFER_WORKSHEET, id),
);
const PF_CONTACT = fieldRef(OFFER_WORKSHEET, "the-safe-contact-route");

/**
 * The two safety lines, written once.
 *
 * Each is used three times: on the sheet a reader looks at, in the text they copy out, and
 * — for the flag — as the flag's own label. Three near-identical sentences is how a safety
 * line becomes something a reader can argue with, so there is one of each and the copy
 * template reads them back off the rendered sheet rather than restating them.
 *
 * The red level is not a judgement made here. It is the level the Canvas's own
 * THE SAFE CONTACT ROUTE field carries on /worksheet/first-offer-canvas, and this sheet
 * prints that field.
 */
const PF_FLAG_LABEL = "Red · one adult reads it before you send it";
const PF_CONTACT_NOTE =
  "Anything about money, meetings or personal details goes through the adult on that line first.";

/* Titles for the two links under the intro. Read from the collection, never typed in —
   they are the book's wording. fieldRef() above has already thrown if either sheet is
   missing, so these assertions cannot fire. */
const PF_OFFER_TITLE = worksheets.find((w) => w.id === OFFER_WORKSHEET)!.data.title;
const PF_START_TITLE = worksheets.find((w) => w.id === START_WORKSHEET)!.data.title;

/* The Canvas's own Reality Check, verbatim from the book, on the same terms it is attached
   there: a required safety element fails the build rather than vanishing. */
const PF_CHECK_ID = "seven-safe-offers";
const pfCheck = (await allRealityChecks()).find((c) => c.id === PF_CHECK_ID);
if (!pfCheck) {
  throw new Error(
    `/receipts: the portfolio requires Reality Check "${PF_CHECK_ID}", which is not in ` +
      "reality-checks.yaml. A required safety element must fail the build, never vanish.",
  );
}
const pfCheckFlag = metaFor(PF_CHECK_ID)?.flag ?? "yellow";

/* All nineteen rows are rendered and hidden, rather than built by script, so each one
   carries this component's scoped-style attribute and so the order is the book's order
   without the client having to sort anything. */
const PF_BUILDS = builds.map((b) => {
  const chapter = chapters.find((c) => c.data.n === b.data.chapter);
  return {
    id: b.id,
    n: pad(b.data.n),
    label: chapter ? chapter.data.title : b.data.source,
    page: b.data.printedPage,
  };
});
---

<Page
  title="Your receipts"
  description="Everything you have ticked, timed and written, kept in this browser only. Copy it as text, export it, import it, or print the whole folder."
>
  <ChapterFurniture
    eyebrow="Kept in this browser"
    title="Your receipts"
    subtitle="Proof beats promises — but only if it still exists tomorrow. Get it off this device."
  />

  <div class="wrap print-sheet">
    {/* Without scripting there is nothing to read: this page has no server to ask. */}
    <section class="nojs prose">
      <h2>This page needs JavaScript</h2>
      <p>
        Your receipts are kept in this browser, and reading them takes a few lines of
        script. There is no server holding a copy, which is the point — but it does mean
        this page has nothing to show you with scripting turned off.
      </p>
      <p>
        Everything you ticked is still on the pages you ticked it on.{" "}
        <a href="/builds">The nineteen builds are here.</a>
      </p>
    </section>

    <div class="js">
      <section
        class="summary"
        data-full
        hidden
        aria-labelledby="count-h"
        data-total-builds={t.builds}
        data-total-play={t.playSteps}
      >
        <h2 id="count-h" class="visually-hidden">What is kept</h2>
        <p class="summary__counts" data-counts></p>
        <p class="summary__totals">
          out of <span class="num">{t.builds}</span> builds and{" "}
          <span class="num">{t.playSteps}</span> Play steps in the book
        </p>
      </section>

      {/* NOT hidden. Both states used to ship hidden and a deferred script revealed one,
          so on a throttled phone the page painted and then jumped — 0.42 CLS, the worst
          number on the site, on the page a reader returns to most. The empty state is the
          correct answer for a first visit and the only one knowable at build time, so it
          is what the server sends. The script hides it only when there is something to
          show instead. */}
      <section class="empty prose" data-empty aria-labelledby="empty-h">
        <h2 id="empty-h">Nothing here yet</h2>
        <p>
          This browser is not holding any receipts. That is the normal state on a first
          visit, and it is also what you will see on a school laptop that has signed you
          out since.
        </p>
        <p>
          A receipt is small on purpose: one build done, one line about what now exists.{" "}
          <a href="/build/01">Build 01 is starting the folder</a> — it takes about ten
          minutes and needs nobody's permission.
        </p>
        <p><a href="/builds">See all nineteen builds</a></p>
      </section>

      <section class="actions" data-full hidden aria-labelledby="actions-h" data-print="hide">
        <h2 id="actions-h">Get it off this device</h2>

        <button type="button" class="btn btn--primary" data-copy>
          Copy everything as text
        </button>
        <p class="actions__hint">
          One tap, then paste it into your own notes or send it to yourself. This is the
          copy that lasts.
        </p>

        <div class="actions__row">
          <button type="button" class="btn" data-export>Export a file</button>
          <button type="button" class="btn" data-print-btn>Print the whole folder</button>
        </div>

        <p class="actions__status" role="status" data-status></p>

        {/* A textarea is the fallback for browsers with no clipboard permission — select
            all, copy, done. Hidden until it is needed. */}
        <div class="fallback" data-fallback hidden>
          <label class="fallback__label" for="fallback-text">
            Copying automatically did not work here. Select this and copy it yourself.
          </label>
          <textarea id="fallback-text" class="fallback__field" rows="10" readonly data-fallback-field
          ></textarea>
        </div>
      </section>

      <section class="import prose" aria-labelledby="import-h" data-print="hide">
        <h2 id="import-h">Bring receipts in from another device</h2>
        <p>
          If you exported a file on a phone, open it here on a laptop and the two sets
          join up. Nothing is uploaded — the file is read in this browser.
        </p>
        <label class="btn btn--file">
          <span>Import a file</span>
          <input type="file" accept="application/json,.json" data-import />
        </label>
        <p class="import__status" role="status" data-import-status></p>
      </section>

      <div class="list" data-full hidden>
        {
          GROUPS.map((g) => (
            <section class="group" data-group={g.kind} hidden>
              <h2>{g.heading}</h2>
              <ol class="rows" data-rows={g.kind} />
            </section>
          ))
        }
      </div>
    </div>

    {/* The portfolio.

        Outside the .js wrapper on purpose. The document itself needs script — it is read
        out of storage — but the Reality Check attached to it does not, and a Reality Check
        that only exists once a script has run is a Reality Check that is lazy-loaded. */}
    <section class="portfolio" aria-labelledby="portfolio-h">
      <h2 id="portfolio-h">Turn it into a portfolio</h2>
      <div class="prose">
        <p>
          Everything above is your <b>record</b>: what you ticked, in the order this site
          put it in. A <b>portfolio</b> is the other document — the one you attach to a
          first job application, or hand to a first client. It opens with what you made.
          Nobody reading it needs to know how far through a website you got.
        </p>
        <p>
          It is built from what this browser is holding right now, and it is not kept
          anywhere: print it, or copy it out, and that version is the one that lasts.
          Because it is written to go to somebody who has never met you, show the whole
          sheet to one adult before it goes anywhere — and read the check under it first.
        </p>
        {/* Without this a reader whose sheet comes out half empty has no idea where the
            missing halves are written. The middle block disappears entirely when the
            Canvas is blank, so nothing on the sheet itself can point at it. */}
        {/* The titles carry their own "Your", so nothing here adds one in front. */}
        <p>
          Nothing on it is typed here. It comes from three places you have already been:
          the proof line on each{" "}
          <a href="/builds">build page</a>,{" "}
          <a href={`/worksheet/${OFFER_WORKSHEET}`}>{PF_OFFER_TITLE}</a>, and{" "}
          <a href={`/worksheet/${START_WORKSHEET}`}>{PF_START_TITLE}</a>. A line left blank
          there is a line left blank here.
        </p>
      </div>

      <p class="portfolio__nojs">
        Building this sheet means reading what this browser has kept, which takes a few
        lines of script. With scripting off there is nothing to read it with — so write
        the same three things out by hand: what you made, who you can help, and an email
        an adult can see. The check under this still applies to the hand-written one.
      </p>

      {/* The check text and the flag wording ride on the sheet itself, so the copied
          version can quote them back without a second copy of either string living in the
          client script. Everything else the script needs is a storage key. */}
      <article
        class="pf"
        data-pf
        data-pf-name-key={PF_NAME.key}
        data-pf-since-key={PF_SINCE.key}
        data-pf-contact-key={PF_CONTACT.key}
        data-pf-flag={PF_FLAG_LABEL}
        data-pf-check={pfCheck.data.text}
        data-pf-check-page={pfCheck.data.printedPage}
      >
        <p class="pf__kicker">Portfolio</p>
        <p class="pf__name" data-pf-name hidden></p>
        <p class="pf__blank" data-pf-name-blank>
          Name <span class="pf__rule"></span>
        </p>
        <p class="pf__since" data-pf-since hidden></p>

        <section class="pf__block" data-pf-built>
          <h3 class="pf__h">What I built</h3>
          <ol class="pf__list">
            {
              PF_BUILDS.map((b) => (
                <li class="pf__item" data-pf-build={b.id} hidden>
                  <p class="pf__made" data-pf-made={b.id} />
                  <p class="pf__ref">
                    Build {b.n} · {b.label} · book page {b.page}
                  </p>
                </li>
              ))
            }
          </ol>
          <p class="pf__none" data-pf-none>
            Nothing on this sheet yet. A build lands here when you write the one line about
            what now exists. The tick on its own stays in your record above — it is not
            something a stranger can read.
          </p>

          {/* A message to the reader, not to whoever receives the sheet — so it carries
              data-print="hide" and the copy template skips it. A build ticked with no line
              under it cannot go on a portfolio: the tick is this site's record of you, and
              the line is the only part a stranger can read. */}
          <p class="pf__unwritten" data-pf-unwritten data-print="hide" hidden></p>
        </section>

        <section class="pf__block" data-pf-offer hidden>
          <h3 class="pf__h">What I can do for someone</h3>
          <dl class="pf__fields">
            {
              PF_OFFER.map((f) => (
                <div class="pf__field" data-pf-field={f.key} hidden>
                  <dt class="pf__field-k">{f.label}</dt>
                  <dd class="pf__field-v" data-pf-value={f.key} />
                </div>
              ))
            }
          </dl>
        </section>

        <section class="pf__block" data-pf-reach>
          <h3 class="pf__h">How to reach me</h3>
          <p class="pf__contact" data-pf-contact hidden></p>
          <p class="pf__blank" data-pf-contact-blank>
            An email an adult can see <span class="pf__rule"></span>
          </p>
          <p class="pf__note">{PF_CONTACT_NOTE}</p>
        </section>
      </article>

      {/* Printed with the sheet, not hidden from it. A Reality Check is never dropped from
          a surface, and print is a surface — a portfolio that arrives carrying the standard
          it was built to is not weaker for it. The check's own subject is an adult-approved
          contact route, which is the line directly above it. */}
      <div class="portfolio__before">
        <p class="portfolio__before-h">Before this goes anywhere</p>
        <p class="portfolio__flag">
          <Flag level="red" size="sm" label={PF_FLAG_LABEL} />
        </p>
        <Box kind="check" class="check">
          <p class="check__flag"><Flag level={pfCheckFlag} size="sm" /></p>
          <p>{pfCheck.data.text}</p>
          <p class="check__ref"><PageRef page={pfCheck.data.printedPage} /></p>
        </Box>
      </div>

      <div class="portfolio__actions" data-print="hide">
        <button type="button" class="btn btn--primary" data-pf-copy>
          Copy my portfolio as text
        </button>
        <button type="button" class="btn" data-pf-print>Print my portfolio</button>
      </div>
      <p class="portfolio__status" role="status" data-pf-status data-print="hide"></p>

      {/* Its own fallback rather than the one in the actions block above, which is inside a
          section that is hidden until this browser is holding something. */}
      <div class="fallback" data-pf-fallback hidden data-print="hide">
        <label class="fallback__label" for="pf-fallback-text">
          Copying automatically did not work here. Select this and copy it yourself.
        </label>
        <textarea id="pf-fallback-text" class="fallback__field" rows="10" readonly data-pf-fallback-field
        ></textarea>
      </div>
    </section>

    {/* The paper index.

        Build 01 is the backbone of the book: start a folder called REAL RICH RECEIPTS and
        put every piece of evidence in it. That folder is physical — screenshots printed,
        drafts, a page someone wrote back on — and this site cannot hold it. What it can do
        is print the cover sheet.

        Deliberately blank and static. It does not read storage, it does not need
        JavaScript, and it works on a first visit before anything has been ticked: you print
        it, put it in the front of the folder, and fill it in with a pen as you go. That is
        the one record that survives a wiped browser, a new phone and a school Chromebook
        signing out. */}
    {/* What a receipt is.

        "Receipt" is the book's word and it carries a lot: proof of something you actually
        did, kept so it can be shown. A reader who arrives here from a QR code has met it
        on page 4. A reader who arrives from a search has not met it at all, and this page
        used the word eleven times before defining it once. Three worked examples cost less
        than a paragraph of explanation. */}
    <section class="what prose" aria-labelledby="what-h">
      <h2 id="what-h">What counts as a receipt</h2>
      <p>
        Proof of something you actually did, made, learned or tested. Not a plan, not an
        intention, not a screenshot of a course you bought. Something that exists now and
        did not exist last week.
      </p>

      <ol class="examples">
        {
          EXAMPLES.map((e) => (
            <li class="example">
              <p class="example__before"><span class="example__k">Before</span>{e.before}</p>
              <p class="example__build"><span class="example__k">Built</span>{e.build}</p>
              <p class="example__proof"><span class="example__k">The receipt</span>{e.proof}</p>
              <p class="example__next"><span class="example__k">Next</span>{e.next}</p>
            </li>
          ))
        }
      </ol>

      <p class="what__note">
        None of those took a week. That is the point of the whole thing — a receipt small
        enough to finish is worth more than a project big enough to abandon.
      </p>
    </section>

    <section class="paper" aria-labelledby="paper-h">
      <h2 id="paper-h">The paper version</h2>
      <div class="prose">
        <p>
          Build 01 asks you to start a real folder called <b>REAL RICH RECEIPTS</b> and put
          every piece of proof inside it. This is the sheet that goes in the front of it.
        </p>
        <p>
          Print it and fill it in with a pen. It does not need this browser, it does not
          need a login, and it is still there in a year when everything on this page has
          been cleared. That is the point of it.
        </p>
        <p class="paper__cta" data-print="hide">
          {/* Not class="js": that class is also the wrapper below, and its reveal rule sets
              display:block, which breaks a .btn's inline-flex centring and stretches it to
              the full prose column. The button gets its own pair of rules instead. */}
          <button type="button" class="btn btn--primary paper__btn" data-print-btn>
            Print this sheet
          </button>
          <span class="paper__nojs">Use your browser's print command — File, then Print.</span>
        </p>
      </div>

      <div class="sheet">
        <p class="sheet__title">REAL RICH RECEIPTS</p>
        <p class="sheet__sub">
          Name <span class="sheet__rule"></span> Started <span class="sheet__rule sheet__rule--short"></span>
        </p>

        {
          PAPER.map((g) => (
            <div class="sheet__group">
              <p class="sheet__group-h">
                {g.heading} <span class="sheet__count">{g.items.length}</span>
              </p>
              <ul class="sheet__list">
                {g.items.map((i) => (
                  <li class="sheet__item">
                    <span class="sheet__box" aria-hidden="true" />
                    <span class="sheet__n">{i.n}</span>
                    <span class="sheet__label">{i.label}</span>
                    <span class="sheet__proof">what is in the folder</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <p class="sheet__foot">
          Teen &amp; Grow Rich · one tick per thing that exists, not per thing you meant to do.
        </p>
      </div>
    </section>

    <section class="truth prose" aria-labelledby="truth-h">
      <h2 id="truth-h">What “kept in this browser” actually means</h2>
      <p>
        This page reads one thing: a list of ticks and answers stored by this browser, on
        this device. It has never been sent anywhere. There is no account, no server copy
        and no way for anyone — including us — to look at it.
      </p>
      <p>
        That also means nobody is looking after it. Browsers clear storage like this on
        their own when you stop visiting a site for a while. A shared school laptop usually
        clears it the moment you sign out. Private browsing keeps nothing at all. A new
        phone starts empty.
      </p>
      <p>
        So treat this page as a working copy, never the record. The record is the version
        you copied into your own notes, or the one you printed and put in the folder.{" "}
        <a href="/privacy">How this works, in detail.</a>
      </p>
    </section>

    <section class="danger js" data-full hidden aria-labelledby="danger-h" data-print="hide">
      <h2 id="danger-h">Delete everything kept here</h2>
      <p class="danger__note">
        Clears this browser's copy, immediately and for good. Anything you copied or
        printed is unaffected.
      </p>
      <button type="button" class="btn btn--danger" data-clear>Delete everything</button>
      <p class="danger__status" role="status" data-clear-status></p>
    </section>

    {/* One receipt row, rendered by Astro so it carries this component's scoped-style
        attribute. Building the rows with document.createElement instead would produce
        elements the scoped CSS cannot reach, and they would come out unstyled. */}
    <template data-row>
      <li class="row">
        <p class="row__label"><a data-row-link></a></p>
        <p class="row__note"></p>
        <p class="row__value"></p>
      </li>
    </template>

    {/* Inert data. <template> content is not rendered, not read by assistive technology
        and not printed; it is only here so the script can name what it finds. */}
    <template data-index>
      {
        index.map((r) => (
          <span data-key={r.key} data-label={r.label} data-note={r.note} data-href={r.href} />
        ))
      }
    </template>
    <template data-spaces>
      {spaces.map((s) => <span data-prefix={s.prefix} data-label={s.label} data-href={s.href} />)}
    </template>
  </div>
</Page>

<script>
  /* Imported here rather than in the frontmatter: this is a bundled client script,
     and a frontmatter import is not in its scope — the value would be undefined in
     the browser, on the line that writes the site's own address onto the copy a
     reader keeps. */
  import { SITE_HOST } from "../lib/site";
  import { state, exportJson, importJson, clearAll, canKeep } from "../lib/storage";

  const root = document.querySelector<HTMLElement>(".js");
  if (root) {
    /* --- The label index ---------------------------------------------------- */

    type Label = { label: string; note: string; href: string };

    const index = new Map<string, Label>();
    /* Insertion order is the book's order — build 01 first, chapter 1 before chapter 2 —
       so it doubles as the sort key for the lists below. */
    const order = new Map<string, number>();
    for (const el of document
      .querySelector<HTMLTemplateElement>("[data-index]")!
      .content.querySelectorAll<HTMLElement>("span")) {
      index.set(el.dataset.key!, {
        label: el.dataset.label!,
        note: el.dataset.note!,
        href: el.dataset.href!,
      });
      order.set(el.dataset.key!, order.size);
    }

    const spaces = new Map<string, { label: string; href: string }>();
    for (const el of document
      .querySelector<HTMLTemplateElement>("[data-spaces]")!
      .content.querySelectorAll<HTMLElement>("span")) {
      spaces.set(el.dataset.prefix!, { label: el.dataset.label!, href: el.dataset.href! });
    }

    /** Never returns nothing. An unnamed receipt still belongs to the reader. */
    const describe = (kind: string, id: string): Label => {
      const exact = index.get(`${kind}:${id}`);
      if (exact) return exact;

      const [prefix, ...rest] = id.split(":");
      const space = prefix ? spaces.get(prefix) : undefined;
      if (space && rest.length) {
        return { label: `${space.label} · ${rest.join(":")}`, note: "", href: space.href };
      }
      return { label: id, note: "", href: "" };
    };

    /* --- Reading what is kept ------------------------------------------------ */

    type Entry = { kind: string; id: string; value: string | number; when?: number } & Label;

    const DATE = new Intl.DateTimeFormat(undefined, {
      day: "numeric",
      month: "short",
      year: "numeric",
    });

    const read = (): Entry[] => {
      // exportJson() is the only public route to the raw log, and the log is the only
      // place the timestamps are. state() is still the source of truth for values,
      // because it also folds in writes that have not flushed yet.
      let times = new Map<string, number>();
      try {
        const log = (JSON.parse(exportJson()) as { log?: { t: number; k: string; id: string }[] }).log;
        for (const e of log ?? []) times.set(`${e.k}:${e.id}`, e.t);
      } catch {
        times = new Map();
      }

      const out: Entry[] = [];
      for (const [key, value] of state()) {
        const cut = key.indexOf(":");
        if (cut < 0) continue;
        const kind = key.slice(0, cut);
        const id = key.slice(cut + 1);

        const kept =
          typeof value === "string" ? value.trim().length > 0 : typeof value === "number" ? value !== 0 : false;
        if (!kept) continue;

        out.push({ kind, id, value: value as string | number, when: times.get(key), ...describe(kind, id) });
      }
      // Book order where we know it; anything unrecognised falls to the end of its group
      // rather than being lost among the named rows.
      return out.sort(
        (a, b) =>
          (order.get(`${a.kind}:${a.id}`) ?? Number.MAX_SAFE_INTEGER) -
            (order.get(`${b.kind}:${b.id}`) ?? Number.MAX_SAFE_INTEGER) ||
          a.label.localeCompare(b.label),
      );
    };

    /* --- Painting ------------------------------------------------------------ */

    const rowTemplate = document.querySelector<HTMLTemplateElement>("[data-row]")!;
    const summary = root.querySelector<HTMLElement>(".summary")!;
    const counts = root.querySelector<HTMLElement>("[data-counts]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const fulls = [...document.querySelectorAll<HTMLElement>("[data-full]")];
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;

    // The denominators are counted from the YAML at build time, never typed in here.
    const TOTAL_BUILDS = summary.dataset.totalBuilds;
    const TOTAL_PLAY = summary.dataset.totalPlay;

    let entries: Entry[] = [];

    const summarise = (): string => {
      const n = (kind: string) => entries.filter((e) => e.kind === kind).length;
      const parts = [
        `${n("build")} of ${TOTAL_BUILDS} builds`,
        `${n("play")} of ${TOTAL_PLAY} Play steps`,
        `${n("field")} written answers`,
      ];
      const days = n("day");
      if (days) parts.push(`${days} ${days === 1 ? "day" : "days"}`);
      return parts.join(" · ");
    };

    /* Assigned by the portfolio block further down, which runs before the first paint().
       A no-op until then, and a no-op for good if that block ever fails to find its sheet:
       the record is the thing a reader came here for and it must paint either way. */
    let paintPortfolio = () => {};

    const paint = () => {
      entries = read();

      const has = entries.length > 0;
      for (const el of fulls) el.hidden = !has;
      empty.hidden = has;
      counts.textContent = summarise();

      for (const list of root.querySelectorAll<HTMLElement>("[data-rows]")) {
        const kind = list.dataset.rows!;
        const section = list.closest<HTMLElement>("[data-group]")!;
        const rows = entries.filter((e) => e.kind === kind);
        section.hidden = rows.length === 0;
        list.replaceChildren();

        for (const e of rows) {
          const li = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const label = li.querySelector<HTMLElement>(".row__label")!;
          const link = li.querySelector<HTMLAnchorElement>("[data-row-link]")!;
          const note = li.querySelector<HTMLElement>(".row__note")!;
          const value = li.querySelector<HTMLElement>(".row__value")!;

          // textContent throughout: book copy contains quotes and brackets, and an
          // imported file is by definition text this page did not write.
          if (e.href) {
            link.href = e.href;
            link.textContent = e.label;
          } else {
            link.remove();
            label.textContent = e.label;
          }

          const meta = [e.note, e.when ? DATE.format(e.when * 1000) : ""].filter(Boolean).join(" · ");
          if (meta) note.textContent = meta;
          else note.remove();

          if (typeof e.value === "string" || kind === "score") value.textContent = String(e.value);
          else value.remove();

          list.append(li);
        }
      }

      /* The portfolio reads the same storage, so it is stale at exactly the moments the
         record is: after an import, after a delete, after a write in another tab. */
      paintPortfolio();
    };

    /* --- Copy as text: the primary action ------------------------------------ */

    const HEADINGS: Record<string, string> = {
      build: "BUILDS DONE",
      play: "PLAY STEPS TICKED",
      field: "ANSWERS I WROTE",
      day: "DAYS DONE",
      score: "SCORES",
    };

    const asText = (): string => {
      const lines = [
        "TEEN & GROW RICH — MY RECEIPTS",
        `Copied ${DATE.format(new Date())}`,
        "",
        summarise(),
      ];

      for (const kind of ["build", "play", "field", "day", "score"]) {
        const rows = entries.filter((e) => e.kind === kind);
        if (!rows.length) continue;
        lines.push("", HEADINGS[kind]!);
        for (const e of rows) {
          lines.push(`- ${e.label}${e.note ? ` (${e.note})` : ""}`);
          if (typeof e.value === "string") lines.push(`  ${e.value}`);
          else if (kind === "score") lines.push(`  ${e.value}`);
        }
      }

      lines.push(
        "",
        "Kept in one browser only, which will eventually clear it.",
        `This copy is the one that lasts. ${SITE_HOST}/receipts`,
      );
      return lines.join("\n");
    };

    const fallback = root.querySelector<HTMLElement>("[data-fallback]")!;
    const fallbackField = root.querySelector<HTMLTextAreaElement>("[data-fallback-field]")!;

    /**
     * One clipboard path, two documents.
     *
     * The record and the portfolio differ in what they say and in where their fallback
     * lands, and in nothing else — so the writeText call, the refused-permission branch
     * and the wording of both are written once. Each caller passes its own status line and
     * its own textarea, because the portfolio's copy of both sits outside the block that
     * stays hidden until this browser is holding something.
     */
    const copyOut = async (
      text: string,
      into: HTMLElement,
      box: HTMLElement,
      field: HTMLTextAreaElement,
      ok: string,
    ) => {
      try {
        await navigator.clipboard.writeText(text);
        into.textContent = ok;
        box.hidden = true;
      } catch {
        // Older browsers, and any browser that refuses the permission. Show the text.
        field.value = text;
        box.hidden = false;
        field.focus();
        field.select();
        into.textContent = "This browser blocked the clipboard, so the text is below instead.";
      }
    };

    root.querySelector<HTMLButtonElement>("[data-copy]")!.addEventListener("click", () => {
      void copyOut(
        asText(),
        status,
        fallback,
        fallbackField,
        "Copied. Paste it somewhere of your own.",
      );
    });

    /* --- Export, print, import ----------------------------------------------- */

    root.querySelector<HTMLButtonElement>("[data-export]")!.addEventListener("click", () => {
      const blob = new Blob([exportJson()], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `teen-and-grow-rich-receipts-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      status.textContent = "File made. Keep it somewhere you will find it again.";
    });

    /**
     * Two print routes off one page, and they must not print the same thing.
     *
     * "Print the whole folder" and "Print this sheet" are the record: everything on this
     * page, in this site's order. "Print my portfolio" goes to somebody who has never met
     * the reader, and sending the record with it would hand a stranger exactly the
     * document the portfolio exists to replace — so that route flags the page first and
     * the print stylesheet drops everything that is not the portfolio.
     *
     * The flag is set at the click AND re-asserted on beforeprint, because Ctrl+P is a
     * third route where no button was pressed and the flag has to be off. afterprint
     * clears it; if a browser never fires afterprint the next beforeprint still corrects
     * it, and the flag does nothing at all on screen.
     */
    let portfolioOnly = false;
    const flagPrint = () => {
      document.documentElement.toggleAttribute("data-print-portfolio", portfolioOnly);
    };
    window.addEventListener("beforeprint", flagPrint);
    window.addEventListener("afterprint", () => {
      portfolioOnly = false;
      flagPrint();
    });

    /* querySelectorAll, and from the document rather than from root: there is a second
       print button down in the paper-index section, outside the .js wrapper. It shipped
       with no listener at all, so it was a visible, focusable button that did nothing. */
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-print-btn]")) {
      btn.addEventListener("click", () => {
        portfolioOnly = false;
        flagPrint();
        window.print();
      });
    }

    const importStatus = root.querySelector<HTMLElement>("[data-import-status]")!;
    root.querySelector<HTMLInputElement>("[data-import]")!.addEventListener("change", async (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;

      const result = importJson(await file.text());
      if (result.ok) {
        importStatus.textContent = `${result.added} entries brought in. Anything you already had is still here.`;
        paint();
      } else {
        importStatus.textContent = result.error;
      }
      // So the same file can be chosen twice if the first attempt failed.
      input.value = "";
    });

    /* --- The portfolio -------------------------------------------------------- */

    /**
     * The same storage as everything above, read the other way round.
     *
     * The record answers "what did I tick". The portfolio answers "what exists", which is
     * the only question the person reading it has — so it leads with the line the reader
     * wrote about what they made, and the build it came out of sits under that line as a
     * reference rather than above it as a score. No count of anything appears on it.
     *
     * A build that is ticked but has no proof line is deliberately not on the sheet. The
     * tick is this site's record of the reader; the line is the part somebody else can
     * read, and inventing one on their behalf for a document going to a stranger is the
     * one thing this page must never do. It says so instead, on screen only.
     */
    const pf = document.querySelector<HTMLElement>("[data-pf]");

    if (pf) {
      const pfName = pf.querySelector<HTMLElement>("[data-pf-name]")!;
      const pfNameBlank = pf.querySelector<HTMLElement>("[data-pf-name-blank]")!;
      const pfSince = pf.querySelector<HTMLElement>("[data-pf-since]")!;
      const pfBuilt = pf.querySelector<HTMLElement>("[data-pf-built]")!;
      const pfNone = pf.querySelector<HTMLElement>("[data-pf-none]")!;
      const pfUnwritten = pf.querySelector<HTMLElement>("[data-pf-unwritten]")!;
      const pfOffer = pf.querySelector<HTMLElement>("[data-pf-offer]")!;
      const pfReach = pf.querySelector<HTMLElement>("[data-pf-reach]")!;
      const pfContact = pf.querySelector<HTMLElement>("[data-pf-contact]")!;
      const pfContactBlank = pf.querySelector<HTMLElement>("[data-pf-contact-blank]")!;

      const pfValue = (key: string): string => {
        const v = state().get(key);
        return typeof v === "string" ? v.trim() : "";
      };

      paintPortfolio = () => {
        const kept = state();

        const name = pfValue(pf.dataset.pfNameKey!);
        pfName.textContent = name;
        pfName.hidden = name === "";
        pfNameBlank.hidden = name !== "";

        const since = pfValue(pf.dataset.pfSinceKey!);
        pfSince.textContent = since ? `Started ${since}` : "";
        pfSince.hidden = since === "";

        let made = 0;
        let ticked = 0;
        for (const li of pf.querySelectorAll<HTMLElement>("[data-pf-build]")) {
          const id = li.dataset.pfBuild!;
          // textContent, never innerHTML: this is the reader's own free text.
          const line = pfValue(`field:proof:${id}`);
          li.querySelector<HTMLElement>("[data-pf-made]")!.textContent = line;
          li.hidden = line === "";
          if (line) made += 1;
          else if (kept.get(`build:${id}`) === 1) ticked += 1;
        }

        pfNone.hidden = made > 0;
        pfUnwritten.hidden = ticked === 0;
        pfUnwritten.textContent =
          ticked === 0
            ? ""
            : `${ticked} ${ticked === 1 ? "build is" : "builds are"} ticked in this browser with ` +
              `no line under ${ticked === 1 ? "it" : "them"}. Write one on the build page and ` +
              `${ticked === 1 ? "it lands" : "they land"} here.`;

        let anyOffer = false;
        for (const row of pfOffer.querySelectorAll<HTMLElement>("[data-pf-field]")) {
          const value = pfValue(row.dataset.pfField!);
          row.querySelector<HTMLElement>("[data-pf-value]")!.textContent = value;
          row.hidden = value === "";
          if (value) anyOffer = true;
        }
        pfOffer.hidden = !anyOffer;

        const contact = pfValue(pf.dataset.pfContactKey!);
        pfContact.textContent = contact;
        pfContact.hidden = contact === "";
        pfContactBlank.hidden = contact !== "";
      };

      /**
       * The copy is read back off the sheet that is already on the page, not rebuilt from
       * storage a second time. The sheet has already decided what is filled in, what is
       * still a blank line and what is hidden; a copy that disagreed with the printed
       * version by one line would be worse than no copy at all.
       */
      const flat = (el: Element | null): string =>
        (el?.textContent ?? "").replace(/\s+/g, " ").trim();
      const shown = (el: HTMLElement | null): string => (el && !el.hidden ? flat(el) : "");
      const head = (block: HTMLElement): string =>
        flat(block.querySelector(".pf__h")).toLocaleUpperCase();

      const pfText = (): string => {
        const out = ["TEEN & GROW RICH — MY PORTFOLIO"];
        out.push(shown(pfName) || `${flat(pfNameBlank)} ______`);
        const since = shown(pfSince);
        if (since) out.push(since);

        /* .pf__unwritten is skipped in both branches. It is a note to the reader about how
           this site works, and how far through a website somebody got is not the business
           of whoever is reading the copy. */
        out.push("", head(pfBuilt));
        const rows = [...pf.querySelectorAll<HTMLElement>(".pf__item")].filter((li) => !li.hidden);
        if (rows.length) {
          for (const li of rows) {
            out.push(`- ${flat(li.querySelector(".pf__made"))}`);
            out.push(`  ${flat(li.querySelector(".pf__ref"))}`);
          }
        } else {
          out.push(flat(pfNone));
        }

        if (!pfOffer.hidden) {
          out.push("", head(pfOffer));
          for (const row of pfOffer.querySelectorAll<HTMLElement>("[data-pf-field]")) {
            if (row.hidden) continue;
            out.push(`${flat(row.querySelector(".pf__field-k"))}: ${flat(row.querySelector(".pf__field-v"))}`);
          }
        }

        out.push("", head(pfReach));
        out.push(shown(pfContact) || `${flat(pfContactBlank)} ______`);
        /* Read off the sheet, not out of a data attribute: this is the line that tells the
           recipient the contact route goes through an adult, and it is the one line on the
           copy that is not allowed to go missing. */
        out.push(flat(pfReach.querySelector(".pf__note")));

        /* The check travels with the sheet. A Reality Check is never dropped from a
           surface, and a plain-text message pasted into a chat is a surface. */
        out.push("", "BEFORE THIS GOES ANYWHERE");
        out.push(pf.dataset.pfFlag ?? "");
        out.push(`${pf.dataset.pfCheck ?? ""} (book page ${pf.dataset.pfCheckPage ?? ""})`);

        out.push("", `Written out of Teen & Grow Rich by Ryan Rijvers — ${SITE_HOST}`);
        return out.join("\n");
      };

      const pfStatus = document.querySelector<HTMLElement>("[data-pf-status]")!;
      const pfFallback = document.querySelector<HTMLElement>("[data-pf-fallback]")!;
      const pfFallbackField = document.querySelector<HTMLTextAreaElement>("[data-pf-fallback-field]")!;

      document.querySelector<HTMLButtonElement>("[data-pf-copy]")!.addEventListener("click", () => {
        void copyOut(
          pfText(),
          pfStatus,
          pfFallback,
          pfFallbackField,
          "Copied. Show the whole thing to one adult before you send it anywhere.",
        );
      });

      document.querySelector<HTMLButtonElement>("[data-pf-print]")!.addEventListener("click", () => {
        portfolioOnly = true;
        flagPrint();
        window.print();
      });
    }

    /* --- Delete -------------------------------------------------------------- */

    // Queried from the document, not from root: the delete block sits outside the main
    // .js wrapper so that it reads last on the page and last in the tab order.
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-clear]")!;
    const clearStatus = document.querySelector<HTMLElement>("[data-clear-status]")!;
    let armed = false;

    clearBtn.addEventListener("click", () => {
      // Two presses rather than a dialog: a confirm() box is the one piece of UI on this
      // site a reader cannot read at their own pace.
      if (!armed) {
        armed = true;
        clearBtn.textContent = "Press again to delete everything";
        clearStatus.textContent = "This cannot be undone. Press anything else to leave it alone.";
        return;
      }
      clearAll();
      armed = false;
      clearBtn.textContent = "Delete everything";
      clearStatus.textContent = "Deleted from this browser.";
      paint();
    });

    document.addEventListener("click", (event) => {
      if (armed && event.target !== clearBtn) {
        armed = false;
        clearBtn.textContent = "Delete everything";
        clearStatus.textContent = "";
      }
    });

    /* --- Keeping the page honest --------------------------------------------- */

    paint();

    if (!canKeep()) {
      status.textContent =
        "This browser is not keeping anything — private mode, or a policy on this device. Nothing you tick here will still be here later.";
    }

    // A second tab, and coming back via the back button, must not show a stale page.
    window.addEventListener("storage", paint);
    window.addEventListener("pageshow", (event) => {
      if ((event as PageTransitionEvent).persisted) paint();
    });
  }
</script>

<style>
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  /* The reset drops the underline from every <a>, so a link in running prose has to be
     given one back. Weight plus a currentColor underline, never colour alone. */
  .prose a {
    font-weight: 700;
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  .num {
    font-variant-numeric: tabular-nums slashed-zero;
    font-weight: 700;
  }

  h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
    margin-block-end: 0.9rem;
  }

  p + p {
    margin-block-start: 0.8em;
  }

  a {
    text-underline-offset: 3px;
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Scripting is required to read local storage; say so instead of showing an empty page. */
  .js {
    display: none;
