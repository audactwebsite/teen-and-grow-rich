---
/**
 * The homepage, which is really a landing page for someone holding a printed book on a
 * phone. Both QR codes in the book encode the bare root, so the first thing on screen is
 * the page-number field — not a pitch, not a hero, not a value proposition.
 *
 * The order is a priority list, not a layout: page number, then where you got to, then
 * the chapters, then the adult doors, then the book. The book is last because a reader
 * who is here already owns it.
 *
 * The hero is hand-rolled rather than reusing ChapterFurniture because the one hard
 * constraint on this page is that the Go button is visible at 390 x 844 without
 * scrolling, and that is a vertical budget, not a style choice. Same vocabulary: navy
 * bar, teal spine, orange dot, teal rule then a short orange rule.
 */
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import Flag from "../components/Flag.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import harbour from "../assets/photos/monaco-harbour-01.jpg";
import cover from "../assets/photos/book-cover.jpg";
import {
  allChapters,
  allBuilds,
  allWorksheets,
  allSequences,
  buildForChapter,
  totals,
} from "../lib/content";
import { buildMeta, FLAG_RULE_PAGE } from "../lib/build-meta";
import { allResolved, LAST_PAGE, LAST_PRINTED_PAGE } from "../lib/page-routing";

const chapters = await allChapters();
const builds = await allBuilds();
const worksheets = await allWorksheets();
const sequences = await allSequences();
const t = await totals();

const pad = (n: number) => String(n).padStart(2, "0");

/** Scannable labels for the chapter index; the rule itself is stated once above it. */
const FLAG_SHORT = { green: "Green", yellow: "Yellow", red: "Red" } as const;

/* The flag on each row is the chapter's own 24-Hour Build flag, from build-meta.ts. It
   is the book's page-60 rule applied to the printed build, not a mark the book prints
   per chapter — which is why the index says so in words directly above it. */
const chapterRows = await Promise.all(
  chapters.map(async (c) => ({
    chapter: c,
    flag: buildMeta((await buildForChapter(c.data.n))!.id).flag,
  })),
);

/* The field resolves the destination in the browser so the reader lands on the tool in
   one navigation rather than bouncing through /p/[n]. That costs a table in the markup;
   it is ~4 KB of highly compressible text and it is the site's most-used interaction. */
const routes = Object.fromEntries(
  (await allResolved()).map((r) => [
    r.page,
    { h: r.href, l: `${r.kind} · ${r.label}`, x: r.exact ? 1 : 0, p: r.landsOn },
  ]),
);

/* Labels for the "where you got to" block. Keyed by the first segment of a stored event
   id, because ids are namespaced ("dream-big:3", "first-offer-canvas:the-problem"). */
const kept = {
  build: Object.fromEntries(
    builds.map((b) => [b.id, { h: `/build/${pad(b.data.n)}`, l: `24-Hour Build · ${b.data.source}` }]),
  ),
  play: Object.fromEntries(
    chapters.map((c) => [
      c.data.slug,
      { h: `/c/${pad(c.data.n)}`, l: `Chapter ${pad(c.data.n)} · ${c.data.title}` },
    ]),
  ),
  field: Object.fromEntries(
    worksheets.map((w) => [w.id, { h: `/worksheet/${w.id}`, l: `Worksheet · ${w.data.title}` }]),
  ),
  day: Object.fromEntries(
    sequences.map((s) => [s.id, { h: `/path/${s.id}`, l: `Plan · ${s.data.title}` }]),
  ),
};

/* The 90-day path, from the book's own data. Three phases, not the four a reviewer
   proposed — Build Proof, Offer A Tiny Result, Earn And Improve are what is printed, and
   inventing a fourth to make a nicer diagram is the thing this project does not do. */
const ninety = sequences.find((s) => s.id === "ninety-day");
const phases = (ninety?.data.groups ?? []).map((g) => {
  const m = g.heading.match(/^Phase \d+\s*[-–]\s*(.+?)\s*\(Days\s*([\d–-]+)\)$/);
  return {
    id: g.id,
    name: m ? m[1] : g.heading,
    days: m ? m[2].replace("-", "–") : "",
    count: g.items.length,
    first: g.items[0],
  };
});

const description =
  "The companion site for the book Teen & Grow Rich. Type the page number you are on and it opens the tool for that page.";
---

<Page title="Teen & Grow Rich" description={description}>
  {/* ---------------------------------------------------------------- 1. Page number */}
  <section id="page-number" class="hero" aria-labelledby="hero-title">
    <div class="hero__bar" aria-hidden="true"></div>
    <div class="hero__spine" aria-hidden="true"></div>

    {/* The real harbour the book's illustrations were painted from, shot from behind.
        Decorative: the page says everything this photograph says, and a screen-reader
        user gains nothing from being told a boy is looking at boats. It sits BEHIND the
        solid base with a scrim over it, so the page-number field keeps its contrast even
        while the image is still loading — or if it never loads at all. */}
    <div class="hero__photo" aria-hidden="true">
      <Image src={harbour} alt="" widths={[640, 1024, 1600, 2560]} sizes="100vw" loading="eager" />
    </div>

    <div class="wrap hero__inner">
      <span class="hero__dot" aria-hidden="true"></span>

      <p class="eyebrow">Holding the book?</p>
      <h1 id="hero-title" class="hero__title">Teen &amp; Grow Rich</h1>

      <div class="rules" aria-hidden="true">
        <span class="rule rule--teal"></span>
        <span class="rule rule--orange"></span>
      </div>

      <p class="hero__lede">
        Type the page you are on. It opens the tool for that page — no account, nothing to
        sign up for.
      </p>

      {/* action="/p/" is the no-JS path: that page lists all 65 destinations and reads
          ?page= itself. With JS the submit is intercepted and resolved here. */}
      <form
        class="pn"
        action="/p/"
        method="get"
        data-page-form
        data-routes={JSON.stringify(routes)}
      >
        <label class="pn__label" for="pn-input">Book page number</label>

        <div class="pn__row">
          <input
            class="pn__input"
            id="pn-input"
            name="page"
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength="3"
            autocomplete="off"
            enterkeyhint="go"
            placeholder="12"
            aria-describedby="pn-hint pn-out"
          />
          <button class="pn__go" type="submit">Go</button>
        </div>

        <p class="pn__hint" id="pn-hint">
          Pages 1 to {LAST_PRINTED_PAGE}. Type {LAST_PAGE} for the chapter that is not in the book.
        </p>

        {/* Ships empty. The lede and the hint already say what to do, and a third
            instruction set in the loudest style on the page outranked the field's own
            label. It is aria-live="polite", so it speaks from the first keystroke; the
            reserved height keeps the Go button from moving under a reaching thumb. */}
        <p class="pn__out" id="pn-out" aria-live="polite" data-page-out></p>
      </form>
    </div>
  </section>

  {/* ----------------------------------------------------------- 1b. No book? Start here.

      Four reviews said the homepage opens as if everyone already owns the book. Reading
      it back, the problem was sharper than that: there were four doors on this page and
      every one of them — Race Control, schools, the Hill audit, the author — pointed at an
      adult. The teenager, who is the reader, got a number field and nothing else.

      So this is the missing door, and it is deliberately the shortest section on the page.
      Three things to do, one line each, no explanation of the philosophy first. A reader
      this age does not need to be sold the method before being allowed to try it, and
      non-negotiable 7 says nothing here is locked anyway. */}
  <section class="start" aria-labelledby="start-title">
    <div class="wrap">
      <p class="eyebrow">No book in your hand?</p>
      <h2 id="start-title" class="h2">Start anyway</h2>
      <p class="start__lede">
        You do not need the book to use any of this. Nothing is locked, there is no account
        and there is nowhere to type your email. Pick whichever one is true for you tonight.
      </p>

      <ul class="start__list">
        <li class="start__card">
          <a class="start__link" href="/build/01">
            <span class="start__kicker">20 minutes</span>
            <b class="start__title">Make the first thing</b>
            <span class="start__body">
              Start a folder called <i>REAL RICH RECEIPTS</i> and put one real thing in it —
              a screenshot, a draft, a message someone sent back. That folder is the whole
              idea: proof you can point at, instead of a feeling that you were productive.
            </span>
          </a>
        </li>

        <li class="start__card">
          <a class="start__link" href="/reality-check">
            <span class="start__kicker">Something feels off</span>
            <b class="start__title">Check it before you reply</b>
            <span class="start__body">
              Someone offered you money for a "simple task", a brand deal, a job that starts
              with buying your own gear. There are nineteen checks here for exactly that,
              and none of them need you to sign up for anything.
            </span>
          </a>
        </li>

        <li class="start__card">
          <a class="start__link" href="/c/01">
            <span class="start__kicker">Just looking</span>
            <b class="start__title">Read one chapter</b>
            <span class="start__body">
              One idea, one thing that happened, and one thing to go and do afterwards.
              That is the shape of all fifteen. Start at the first one and see if you like
              how it thinks.
            </span>
          </a>
        </li>
      </ul>

      <SafetyNotice tone="beta" class="start__notice" />
    </div>
  </section>

  {/* ------------------------------------------------- 2. Where you got to (JS + state) */}
  <section
    class="kept"
    hidden
    data-kept
    data-labels={JSON.stringify(kept)}
    data-total-builds={t.builds}
    aria-labelledby="kept-title"
  >
    <div class="wrap">
      <h2 id="kept-title" class="h2">Where you got to</h2>
      <p class="kept__counts" data-kept-counts></p>
      <ul class="kept__list" data-kept-list></ul>
      <p class="kept__note">
        This is kept in this browser only, and browsers throw it away. Print or copy your
        receipts to keep them for good.
      </p>
      <p><a class="link" href="/receipts">Open your receipts</a></p>
    </div>
  </section>

  {/* --------------------------------------------------------------- 3. The 15 chapters */}
  <section id="chapters" class="chapters" aria-labelledby="chapters-title">
    <div class="wrap">
      <p class="eyebrow">The book, chapter by chapter</p>
      <h2 id="chapters-title" class="h2">15 chapters, {t.builds} builds, {t.realityChecks} Reality Checks</h2>
      <p class="prose lede">
        Every chapter page carries the same five things: Hill's Original Idea, The Play as
        five steps, the 24-Hour Build with a timer, the Reality Check in full, and three
        debrief questions. The story stays in the book.
      </p>

      <p class="prose note">
        The flag on each row is this site applying the book's own traffic-light rule from
        page {FLAG_RULE_PAGE} to that chapter's 24-Hour Build. The book does not print a
        flag beside each chapter.
      </p>

      <ol class="chlist">
        {
          chapterRows.map(({ chapter: c, flag }) => (
            <li>
              <a class="ch" href={`/c/${pad(c.data.n)}`}>
                <span class="ch__n">{pad(c.data.n)}</span>
                <span class="ch__title">{c.data.title}</span>
                <span class="ch__hill">Hill remix: {c.data.hillPrinciple}</span>
                {/* Wrapped rather than passing `class` to Flag: Astro does not carry this
                    page's scope onto a child component's root, so a grid-area set on the
                    Flag itself would silently not apply. */}
                <span class="ch__flag">
                  {/* Short label here only. The full rule is stated once above the list;
                      repeating "check in with an adult first" on all fifteen rows turns
                      an index you scan into a paragraph you read. */}
                  <Flag level={flag} size="sm" label={FLAG_SHORT[flag]} />
                </span>
                <span class="ch__page">
                  Book page <b>{c.data.printedPage}</b>
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="ch ch--extra" href="/c/16">
            <span class="ch__n">16</span>
            <span class="ch__title">Chapter 16</span>
            <span class="ch__hill">What Ryan learned after the book went to print</span>
            <span class="ch__flag ch__flag--none">No build yet</span>
            <span class="ch__page">Not in the book</span>
          </a>
        </li>
      </ol>
    </div>
  </section>


  {/* ------------------------------------------------------------- 3b. The 90-day route

      Nothing on this page pointed at it. The path from a skill to a first honest offer is
      the largest single piece of the book and only five pages on the whole site linked to
      it, none of them the front door — so a reader could finish every build and never learn
      the arc they were on.

      Three phases, because the book prints three. A review proposed four by adding a Real
      Rich phase on the end; that is a reasonable idea and it is not what is on page 55, so
      it is not what is here. */}
  <section class="route" aria-labelledby="route-title">
    <div class="wrap">
      <p class="eyebrow">After the chapters</p>
      <h2 id="route-title" class="h2">{ninety?.data.title}</h2>
      <p class="route__lede">
        Ninety days, three phases, {phases.reduce((n, p) => n + p.count, 0)} dated actions.
        It is the back of the book, and it is the part that turns everything above into
        something a real person would pay for — safely, with an adult on the parts that
        need one.
      </p>

      <ol class="route__list">
        {
          phases.map((ph, i) => (
            <li class="route__step">
              <p class="route__days" aria-hidden="true">{ph.days}</p>
              <div>
                <h3 class="route__name">
                  <span class="route__sr">Days {ph.days}: </span>
                  {ph.name}
                </h3>
                <p class="route__first">{ph.first}</p>
                <p class="route__count">{ph.count} actions</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="route__cta">
        <a class="link" href="/path/ninety-day">Open the ninety days</a>
        <a class="link" href="/path/tiny-launch">Or the 30-day launch</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- 4. The adult doors */}
  <section class="doors" aria-labelledby="doors-title">
    <div class="wrap">
      {/* Eyebrow then H2, the same opening the chapter index and the book section use.
          The book's own chapter furniture puts one above every title. */}
      <p class="eyebrow">Race control</p>
      <h2 id="doors-title" class="h2">For the adults</h2>

      <p class="prose lede">
        The book sets out one traffic-light rule on page {FLAG_RULE_PAGE}, and this site
        applies it to every build, every worksheet field and every offer that touches
        money, people or data.
      </p>

      <ul class="flaglist">
        <li><Flag level="green" /></li>
        <li><Flag level="yellow" /></li>
        <li><Flag level="red" /></li>
      </ul>

      <p class="prose note">
        An adult does not only mean a parent. A teacher, coach, librarian, youth worker or
        a sibling over 18 all count.
      </p>

      <ul class="doorlist">
        <li>
          <a class="door" href="/parents">
            <b>For parents and teachers</b>
            <span>Race Control: the traffic-light rule, the family agreement, what to ask.</span>
          </a>
        </li>
        <li>
          <a class="door" href="/teachers">
            <b>For teachers</b>
            <span>What prints, what you may photocopy, and what to check before Monday.</span>
          </a>
        </li>
        <li>
          <a class="door" href="/schools/privacy">
            <b>For schools: privacy</b>
            <span>Written for an IT reviewer. Every claim checkable from the page source.</span>
          </a>
        </li>
        <li>
          <a class="door" href="/hill">
            <b>The Napoleon Hill audit</b>
            <span>What is checkable about Hill's own story, and what is not.</span>
          </a>
        </li>
        <li>
          <a class="door" href="/proof">
            <b>About Ryan</b>
            <span>Thirteen. Karting across Europe since he was eight, and an F4 car built to fit him at eleven.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------------------- 5. The book, last */}
  <section class="book" aria-labelledby="book-title">
    <div class="wrap book__inner">
      {/* The scarce thing, shown. Everything above this point is free, so the closing
          section is the one place the printed object should be visible rather than
          described (design-system.md §7). */}
      <Image
        class="book__cover"
        src={cover}
        alt="The cover of Teen &amp; Grow Rich: the title in heavy condensed capitals over a
             photograph of the harbour at Monaco, with the line Think bigger. Build real
             skills. Start now."
        widths={[240, 400, 640]}
        sizes="(min-width: 46rem) 15rem, 40vw"
        loading="lazy"
      />

      <div class="book__body">
        <p class="eyebrow">The book</p>
        <h2 id="book-title" class="h2">Teen &amp; Grow Rich</h2>
        <p class="prose lede">
          {LAST_PRINTED_PAGE} pages. Everything on this site is free and open on your first
          visit — every build, every Reality Check, every worksheet. What the book has that
          this site does not is the 15 stories, the Hill Remix essays and What It Means Now.
        </p>
        <p><a class="link" href="/get">About the book</a></p>
      </div>
    </div>
  </section>
</Page>

<script>
  import { counts, exportJson, type LogEvent } from "../lib/storage";

  /* ---- The page-number field ------------------------------------------------------ */

  type Route = { h: string; l: string; x: 0 | 1; p: number };

  const form = document.querySelector<HTMLFormElement>("[data-page-form]");
  const out = document.querySelector<HTMLElement>("[data-page-out]");

  if (form && out) {
    const input = form.querySelector<HTMLInputElement>("#pn-input")!;
    const routes = JSON.parse(form.dataset.routes ?? "{}") as Record<string, Route>;

    const lookup = (raw: string): Route | null => {
      const trimmed = raw.trim();
      if (!/^\d+$/.test(trimmed)) return null;
      return routes[String(Number(trimmed))] ?? null;
    };

    const describe = () => {
      const raw = input.value.trim();
      if (!raw) return "Type a page number, then press Go.";

      const route = lookup(raw);
      if (!route) return "This book has 64 pages. Try 1 to 64 — or 65.";
      if (route.x) return `Page ${Number(raw)} → ${route.l}`;
      return `Page ${Number(raw)} has no tool of its own. Nearest: ${route.l}, book page ${route.p}.`;
    };

    input.addEventListener("input", () => {
      out.textContent = describe();
    });

    form.addEventListener("submit", (event) => {
      const route = lookup(input.value);
      if (!route) {
        // Let it submit to /p/, which explains itself and lists every page.
        out.textContent = describe();
        return;
      }
      event.preventDefault();
      window.location.assign(route.h);
    });
  }

  /* ---- Where you got to ------------------------------------------------------------
     Reads only. Nothing here writes, so it stays outside the gesture rule in storage.ts. */

  type Label = { h: string; l: string };

  const kept = document.querySelector<HTMLElement>("[data-kept]");

  if (kept) {
    const labels = JSON.parse(kept.dataset.labels ?? "{}") as Record<string, Record<string, Label>>;
    const totalBuilds = Number(kept.dataset.totalBuilds ?? "0");
    const log = (JSON.parse(exportJson()).log ?? []) as LogEvent[];

    const done = (e: LogEvent) =>
      e.v === 1 || (typeof e.v === "string" && e.v.trim().length > 0);

    /* Newest first, one entry per thing. The log is append-only, so walking it backwards
       is the only way to get real recency — folding it loses the order. */
    const recent: Label[] = [];
    const seen = new Set<string>();
    for (let i = log.length - 1; i >= 0 && recent.length < 3; i -= 1) {
      const e = log[i]!;
      if (!done(e)) continue;
      const base = String(e.id).split(":")[0]!;
      const key = `${e.k}:${base}`;
      if (seen.has(key)) continue;
      seen.add(key);
      const hit = labels[e.k]?.[base];
      if (hit) recent.push(hit);
    }

    const c = counts();
    if (c.builds || c.playSteps || c.fields || recent.length) {
      const parts = [
        `${c.builds} of ${totalBuilds} builds`,
        `${c.playSteps} Play steps`,
        `${c.fields} worksheet fields`,
      ];
      kept.querySelector<HTMLElement>("[data-kept-counts]")!.textContent = parts.join(" · ");

      const list = kept.querySelector<HTMLElement>("[data-kept-list]")!;
      for (const item of recent) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = item.h;
        a.textContent = item.l;
        li.append(a);
        list.append(li);
      }

      kept.hidden = false;
    }
  }
</script>

<style>
  /* Container contract, shared with Page.astro and ChapterFurniture. */
  .wrap {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .prose {
    max-inline-size: var(--container-measure);
  }

  [hidden] {
    display: none !important;
  }

  .eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    color: var(--text-eyebrow-colour);
  }

  .h2 {
    margin-block-start: 0.5rem;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    color: var(--text-section);
  }

  .lede {
    margin-block-start: 0.9rem;
    color: var(--text-default);
  }

  .note {
    margin-block-start: 0.8rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }

  .link {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    color: var(--text-strong);
    text-underline-offset: 4px;
    text-decoration-color: var(--accent-spine);
  }

  /* --- 1. Hero + page-number field -------------------------------------------------
     Vertical budget at 390 x 844: header ~44, hero ~185, field ~190. The Go button sits
     around 420px down, which is the requirement this whole block is shaped by. */

  .hero {
    position: relative;
    /* Solid base first: a slow blue-hour photograph must never leave a dark rectangle
       with a form on it. Any image goes behind this, never instead of it. */
    background: var(--surface-page);
    padding-block: 1.4rem 2rem;
    print-color-adjust: exact;
    isolation: isolate;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero__photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Narrow viewports get a slice, not the composition. Bias it onto the lit harbour
       and the horizon; centring here lands on flat dark water and the photograph reads
       as noise. */
    object-position: 30% 32%;
  }

  @media (min-width: 48rem) {
    .hero__photo :global(img) {
      /* Room for the whole frame: subject right of centre, harbour behind the type. */
      object-position: 62% 40%;
    }
  }

  /* The scrim, not the opacity, is what protects the text. Two stops: a flat wash so no
     part of the photograph is ever fully exposed, and a stronger vertical fade behind the
     type and the input. Measured on the darkest and lightest points of the photograph. */
  .hero__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--surface-page) 45%, transparent) 0%,
        color-mix(in oklab, var(--surface-page) 80%, transparent) 58%,
        var(--surface-page) 100%
      ),
      color-mix(in oklab, var(--surface-page) 18%, transparent);
  }

  /* Light mode is the book page. A photograph washed out to near-white behind navy text
     reads as a printing fault, so the hero simply has no image there. */
  :global(:root[data-theme="light"]) .hero__photo {
    display: none;
  }

  @media print {
    .hero__photo {
      display: none;
    }
  }

  .hero__bar {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 8px;
    /* Navy drops to 1.2:1 on the dark base; navy-lift is the palette's stand-in. */
    background: var(--color-tgr-navy-lift);
  }

