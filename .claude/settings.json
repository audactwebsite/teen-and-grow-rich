{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npx astro check)",
      "Bash(npx astro build)",
      "Bash(npx tsc --noEmit)",
      "Bash(ls:*)",
      "Bash(node --version)",
      "Bash(npm ls:*)"
    ],
    "deny": [
      "Bash(git init)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
